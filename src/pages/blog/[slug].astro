---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import FinalShell from "../../layouts/FinalShell.astro";
import SiteHeader from "../../components/final/SiteHeader.astro";
import avatar from "../../assets/avatar.jpg";
import { site, mailto } from "../../lib/site";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null, issue: posts.length - i } }));
}
const { post, newer, older, issue } = Astro.props;
const { Content, headings } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const minutes = Math.max(1, Math.round((post.body ?? "").split(/\s+/).length / 220));
const url = `${site.url}/blog/${post.id}/`;
const og = `${site.url}/blog/og/${post.id}.png`;
const pillarName = { "model-watch": "Model watch", building: "Building with AI", "case-files": "From the case files" } as const;
const records = await getCollection("records");
const related = post.data.related ? records.find((r) => r.id === post.data.related) : undefined;
const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { "@type": "Person", name: site.name, url: site.url, sameAs: [site.linkedin, site.github, site.x] },
  publisher: { "@type": "Person", name: site.name, url: site.url },
  mainEntityOfPage: url,
  image: og,
  keywords: post.data.tags.join(", "),
  inLanguage: "en",
};
const toc = headings.filter((h) => h.depth === 2);
---
<FinalShell title={`${post.data.title} – ${site.name}`} description={post.data.description} fonts={["--font-bangers", "--font-patrick"]} theme="#fff8e7" canonical={url} image={og} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} /><meta property="article:author" content={site.name} />
    {post.data.tags.map((t) => <meta property="article:tag" content={t} />)}
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
  </Fragment>
  <SiteHeader current="blog" />
  <main id="main" class="max-w-6xl mx-auto px-5 sm:px-8 pt-10 pb-28">
    <article class="grid gap-8 lg:grid-cols-[1fr_17rem] items-start">
      <div class="min-w-0">
        <header class="panel p-6 sm:p-10">
          <p class="caption">Issue {String(issue).padStart(2, "0")} · {pillarName[post.data.pillar]}</p>
          <h1 class="mt-4 text-[clamp(2.2rem,5vw,4.2rem)] leading-[1] text-balance">{post.data.title}</h1>
          <p class="mt-4 text-xl lede"><span>{post.data.description}</span></p>
          <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-base text-[#555]">
            <span class="inline-flex items-center gap-2"><Image src={avatar} alt="" width={64} height={64} class="size-8 rounded-full border-2 border-[#111] object-cover" /> <strong class="text-[#111]">{site.name}</strong></span>
            <time datetime={iso(post.data.date)}>{fmt(post.data.date)}</time>
            {post.data.updated && <span>Updated <time datetime={iso(post.data.updated)}>{fmt(post.data.updated)}</time></span>}
            <span>{minutes} min read</span>
          </p>
        </header>
        <div class="prose-comic mt-8 panel p-6 sm:p-10">
          <Content />
          {post.data.sources.length > 0 && (
            <section class="mt-10 pt-6 border-t-4 border-dashed border-[#111]" aria-labelledby="sources-h">
              <h2 id="sources-h" class="!mt-0">Sources</h2>
              <ol class="src-list">{post.data.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a> <span class="text-[#555] text-sm">· {new URL(s.url).hostname.replace("www.", "")}</span></li>)}</ol>
            </section>
          )}
        </div>
        <footer class="mt-8 panel p-6 sm:p-8 grid gap-6 sm:grid-cols-[auto_1fr] items-start">
          <Image src={avatar} alt="" width={160} height={160} class="size-20 rounded-full border-4 border-[#111] object-cover" style="box-shadow: 4px 4px 0 #111" />
          <div>
            <p class="bubble text-lg"><strong>I'm {site.shortName}</strong>, {site.role} at {site.employer}. I build products where full-stack engineering meets AI and write about it for 22,000+ developers.</p>
            <p class="mt-4 flex flex-wrap gap-3"><a href={mailto("A role")} class="btn sm">Email me ▸</a><a href={site.linkedin} rel="noopener" target="_blank" class="btn alt sm">LinkedIn ▸</a><a href="/#cases" class="btn alt sm">The case files ▸</a></p>
          </div>
        </footer>
        <nav class="mt-8 grid gap-4 sm:grid-cols-2" aria-label="More strips">
          {older && <a href={`/blog/${older.id}/`} class="panel p-5 block hover:shadow-[10px_10px_0_#ff2e63]"><span class="text-sm text-[#555]">Previous issue</span><span class="block text-2xl bang mt-1">{older.data.title}</span></a>}
          {newer && <a href={`/blog/${newer.id}/`} class="panel p-5 block hover:shadow-[10px_10px_0_#ff2e63] sm:col-start-2"><span class="text-sm text-[#555]">Next issue</span><span class="block text-2xl bang mt-1">{newer.data.title}</span></a>}
        </nav>
      </div>
      <aside class="lg:sticky lg:top-24 grid gap-6">
        {toc.length > 1 && (
          <nav class="panel p-5" aria-labelledby="toc-h">
            <p id="toc-h" class="bang text-xl">In this issue</p>
            <ol class="mt-3 space-y-2 text-base">{toc.map((h) => <li><a href={`#${h.slug}`} class="hover:text-[#ff2e63] underline underline-offset-4 decoration-2 decoration-[#ff2e63]/40">{h.text}</a></li>)}</ol>
          </nav>
        )}
        {related && (
          <a href={`/#file-${related.id}`} class="panel file p-5 pt-7 block"><span class="filetab">Related file</span><span class="block text-xl bang">{related.data.index}</span><span class="block mt-1 text-base">{related.data.summary}</span></a>
        )}
        <div class="panel p-5"><p class="bang text-xl">Tags</p><ul class="mt-3 flex flex-wrap gap-2">{post.data.tags.map((t) => <li class="tag">{t}</li>)}</ul></div>
      </aside>
    </article>
  </main>
  <script src="../../scripts/page-curtain.ts"></script>
</FinalShell>
