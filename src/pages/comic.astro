---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FinalShell from "../layouts/FinalShell.astro";
import Calendar from "../components/final/Calendar.astro";
import Pronounce from "../components/final/Pronounce.astro";
import ResumeDialog from "../components/final/ResumeDialog.astro";
import ComicArt from "../components/final/ComicArt.astro";
import portrait from "../assets/portrait.jpg";
import { site, mailto } from "../lib/site";
import { me, numbers, migration, stack } from "../lib/story";
const records = (await getCollection("records")).sort((a, b) => a.data.order - b.data.order);
const witnesses = (await getCollection("witnesses")).sort((a, b) => a.data.order - b.data.order);
const roles = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const fmt = (ym: string | null) => ym ? new Date(ym + "-01T00:00:00Z").toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" }) : "Now";
const sfx = ["TICK", "HMM", "PLAN!", "SWITCH!", "KA-CHING"];
const colors = ["#ff2e63", "#1b998b", "#ffb703", "#3a86ff", "#8338ec"];
const channels = [["Email", site.email, mailto("A role")], ["WhatsApp", site.phoneDisplay, site.whatsapp], ["Call", site.phoneDisplay, `tel:${site.phoneE164}`], ["LinkedIn", "mohammed-mubarak", site.linkedin], ["GitHub", "MDmubarak786", site.github], ["X", "@MMubarakoo7", site.x], ["Instagram", "@scooby_doo.mk", site.instagram], ["YouTube", "@mohammedmubarak1478", site.youtube]];
---
<FinalShell title={`${site.name} – the comic`} description={me.oneLiner} fonts={["--font-bangers", "--font-patrick"]} current="comic" theme="#fff8e7">
  <style is:global>
    :root { --curtain:#ff2e63; --v-bg:#fff8e7; --v-fg:#111; --v-accent:#ff2e63; --v-font-text: var(--font-patrick); --v-font-display: var(--font-bangers); }
    body { background-image: radial-gradient(#111 0.8px, transparent 0.9px); background-size: 7px 7px; font-size: 1.1rem; }
    h1, h2, h3, .bang { font-family: var(--font-bangers); letter-spacing:.02em; font-weight:400; }
    .panel { background:#fff; border: 4px solid #111; box-shadow: 8px 8px 0 #111; position:relative; }
    .caption { background:#fff3b0; border: 3px solid #111; padding:.25rem .6rem; display:inline-block; transform: rotate(-1deg); font-size:1rem; }
    .bubble { background:#fff; border:3px solid #111; border-radius: 1.5rem; padding:.9rem 1.1rem; position:relative; }
    .bubble::after { content:""; position:absolute; left:28px; bottom:-18px; border: 10px solid transparent; border-top-color:#111; }
    .sfx { font-family: var(--font-bangers); -webkit-text-stroke: 2px #111; text-shadow: 4px 4px 0 #111; transform: rotate(-8deg); display:inline-block; }
    .btn { font-family: var(--font-bangers); font-size:1.35rem; letter-spacing:.04em; background:#111; color:#fff; border:3px solid #111; padding:.5rem 1.1rem; box-shadow: 4px 4px 0 var(--v-accent); transition: transform .12s, box-shadow .12s; display:inline-block; }
    .btn:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--v-accent); }
    .btn.alt { background:#fff; color:#111; }
    .burst { clip-path: polygon(50% 0%, 61% 12%, 77% 6%, 80% 23%, 96% 29%, 88% 44%, 100% 56%, 85% 65%, 88% 82%, 71% 82%, 63% 97%, 50% 87%, 37% 97%, 29% 82%, 12% 82%, 15% 65%, 0% 56%, 12% 44%, 4% 29%, 20% 23%, 23% 6%, 39% 12%); }
    .emph { font-weight: 700; background: linear-gradient(transparent 55%, #fff3b0 55%); padding: 0 .1em; }
    .badge { display:inline-grid; place-items:center; width:2.4rem; height:2.4rem; border:3px solid #111; border-radius:50%; background:#ffb703; font-family: var(--font-bangers); font-size:1rem; letter-spacing:.04em; box-shadow: 3px 3px 0 #111; flex-shrink:0; }
    .pnum { position:absolute; top:-14px; left:-14px; width:34px; height:34px; border:4px solid #111; background:#fff3b0; font-family: var(--font-bangers); font-size:1.1rem; display:grid; place-items:center; box-shadow: 3px 3px 0 #111; }
    .narr { font-size:1.15rem; line-height:1.45; }
    .origin { position:relative; }
    .origin-item { position:relative; padding-left: 4.5rem; padding-bottom: 2.5rem; }
    .origin-item:last-child { padding-bottom: 0; }
    .spine { position:absolute; left:0; top:0; bottom:0; width:3.2rem; display:flex; flex-direction:column; align-items:center; }
    .spine::before { content:""; position:absolute; top:3.4rem; bottom:-1rem; left:50%; width:4px; margin-left:-2px; background: repeating-linear-gradient(180deg, #111 0 10px, transparent 10px 16px); }
    .origin-item:last-child .spine::before { display:none; }
    .year { width:3.2rem; height:3.2rem; border-radius:50%; border:4px solid #111; background:#fff; display:grid; place-items:center; font-size:.95rem; box-shadow: 3px 3px 0 #111; position:relative; z-index:1; }
    .tile { border:3px solid #111; padding: 1rem 1.1rem; background:#fff; }
    .tag { border:2px solid #111; background:#fff3b0; padding:.1rem .55rem; font-size:.95rem; }
    .promo { margin-top: 1.25rem; }
    @media (max-width: 640px) { .origin-item { padding-left: 0; padding-top: 3.8rem; } .spine { width: 100%; height: 3.2rem; bottom:auto; align-items:flex-start; } .spine::before { display:none; } }
    .zig { background: repeating-linear-gradient(135deg, #111 0 6px, transparent 6px 12px); height: 10px; }
    details summary { list-style:none; cursor:pointer; } details summary::-webkit-details-marker { display:none; }
  </style>
  <header class="sticky top-0 z-40 bg-[#fff8e7]/90 backdrop-blur border-b-4 border-[#111]">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-3 flex items-center justify-between gap-4">
      <a href="#main" class="bang text-2xl">MK <span class="text-[#ff2e63]">COMICS</span></a>
      <nav class="hidden sm:flex gap-6 text-lg" aria-label="Sections"><a href="#migration" class="hover:underline">Chapter 1</a><a href="#cases" class="hover:underline">Case files</a><a href="#witnesses" class="hover:underline">Witnesses</a><a href="#origin" class="hover:underline">Origin</a><a href="#resume" class="hover:underline">Resume</a><a href="#contact" class="hover:underline">Contact</a></nav>
      <a href={mailto("A role")} class="btn text-base py-1.5">Hire me</a>
    </div>
  </header>

  <main id="main" class="max-w-6xl mx-auto px-5 sm:px-8 pt-10 pb-28">
    <!-- COVER -->
    <section class="panel p-6 sm:p-10 grid gap-8 md:grid-cols-[auto_1fr] items-center" aria-label="Cover">
      <div class="relative"><Image src={portrait} alt={`Portrait of ${site.name}`} width={520} height={520} class="w-56 sm:w-72 border-4 border-[#111] object-cover" style="filter: contrast(1.15) saturate(1.3)" /><span class="burst absolute -right-8 -top-8 bg-[#ffb703] size-28 grid place-items-center bang text-xl text-center leading-none rotate-12">2026<br />EDITION</span></div>
      <div>
        <p class="caption">Issue #1 · Chennai, India · {site.pronouns}</p>
        <h1 class="mt-3 text-[clamp(3rem,8vw,7rem)] leading-[0.9] text-[#ff2e63]" style="-webkit-text-stroke: 2px #111">The Full-Stack<br />+ AI Chronicles</h1>
        <p class="mt-4 text-2xl">Starring <strong>{site.name}</strong>, Senior Software Engineer at Galent. {me.oneLiner}</p>
        <div class="mt-5 flex flex-wrap items-center gap-3"><a href={mailto("A role")} class="btn">Email me</a><a href={site.whatsapp} class="btn alt">WhatsApp</a><a href={site.linkedin} class="btn alt">LinkedIn</a><button type="button" class="btn alt" data-resume-open>Read my resume</button><Pronounce class="caption cursor-pointer" /></div>
      </div>
    </section>

    <!-- NUMBERS -->
    <section class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" aria-label="Numbers">{numbers.map((n, i) => <div class="panel p-5"><p class="bang text-5xl" style={`color:${colors[i]}; -webkit-text-stroke:1.5px #111`}>{n.v}</p><p class="text-xl font-bold">{n.k}</p><p>{n.d}</p></div>)}</section>

    <!-- CHAPTER 1 -->
    <section id="migration" class="mt-16 scroll-mt-24" aria-labelledby="ch1">
      <h2 id="ch1" class="text-5xl sm:text-6xl">Chapter 1 · The Great Migration</h2>
      <p class="mt-2 text-xl">A true story about $24,000, a deadline, and AWS Glue. Five panels, in order.</p>
      <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-6 lg:auto-rows-[minmax(15rem,auto)]">
        <!-- 1 · wide establishing panel -->
        <article class="panel p-6 lg:col-span-4 grid gap-5 sm:grid-cols-[1fr_auto] items-center">
          <span class="pnum">1</span>
          <div class="space-y-4"><p class="caption">{migration[0].t}</p><p class="narr">{migration[0].s}</p><p class="sfx text-[clamp(2rem,5vw,4rem)]" style={`color:${colors[0]}`}>{sfx[0]}</p></div>
          <ComicArt kind="clock" class="w-40 sm:w-48 lg:w-56 justify-self-center" />
        </article>
        <!-- 2 · the choice, spoken -->
        <article class="panel p-6 lg:col-span-2 flex flex-col gap-4">
          <span class="pnum">2</span>
          <p class="caption self-start">{migration[1].t}</p>
          <ComicArt kind="fork" class="w-36 self-center" />
          <p class="bubble text-base">{migration[1].s}</p>
          <p class="sfx self-end text-[clamp(1.8rem,4vw,3rem)]" style={`color:${colors[1]}`}>{sfx[1]}</p>
        </article>
        <!-- 3 · the plan -->
        <article class="panel p-6 lg:col-span-2 flex flex-col gap-4">
          <span class="pnum">3</span>
          <p class="caption self-start">{migration[2].t}</p>
          <div class="flex items-center gap-4"><ComicArt kind="plan" class="w-28 shrink-0" /><p class="narr">{migration[2].s}</p></div>
          <p class="sfx self-end text-[clamp(1.8rem,4vw,3rem)]" style={`color:${colors[2]}`}>{sfx[2]}</p>
        </article>
        <!-- 4 · the cutover -->
        <article class="panel p-6 lg:col-span-2 flex flex-col gap-4">
          <span class="pnum">4</span>
          <p class="caption self-start">{migration[3].t}</p>
          <ComicArt kind="switch" class="w-40 self-center" />
          <p class="narr">{migration[3].s}</p>
          <p class="sfx self-end text-[clamp(1.8rem,4vw,3rem)]" style={`color:${colors[3]}`}>{sfx[3]}</p>
        </article>
        <!-- 5 · the bill, with the witness speaking -->
        <article class="panel p-6 lg:col-span-2 flex flex-col gap-4">
          <span class="pnum">5</span>
          <p class="caption self-start">{migration[4].t}</p>
          <div class="flex items-center gap-4"><ComicArt kind="bill" class="w-28 shrink-0" /><p class="narr">{migration[4].s}</p></div>
          <p class="bubble text-base"><strong class="emph">“Saved us $30,000 annually in licensing fees.”</strong> <span class="text-sm">· Jason Wheeler, VP of Technology</span></p>
          <p class="sfx self-end text-[clamp(1.8rem,4vw,3rem)]" style={`color:${colors[4]}`}>{sfx[4]}</p>
        </article>
      </div>
    </section>

    <!-- CASE FILES -->
    <section id="cases" class="mt-16 scroll-mt-24" aria-labelledby="ch2">
      <h2 id="ch2" class="text-5xl sm:text-6xl">Chapter 2 · Case files</h2>
      <p class="mt-2 text-xl">Eight cases. Open any file for context, decision and consequences.</p>
      <ol class="mt-6 grid gap-6 md:grid-cols-2">
        {records.map((r, i) => <li class="panel p-5"><details class="group"><summary><p class="caption">File {String(i + 1).padStart(2, "0")} · {r.data.organisation} · {r.data.date}</p><h3 class="text-3xl mt-2">{r.data.index}</h3><p class="mt-1 text-lg">{r.data.summary}</p><p class="mt-2 bang text-xl" style={`color:${colors[i % 5]}`}>{r.data.consequences.find((c) => c.emphasis)?.value} <span class="text-sm font-sans text-[#555] group-open:hidden">· open the file ▸</span></p></summary>
          <div class="mt-4 border-t-4 border-dashed border-[#111] pt-4 space-y-3">
            <p><strong>Context.</strong> {r.data.context}</p>
            <p><strong>Decision.</strong> {r.data.decision}</p>
            <ul class="grid grid-cols-2 gap-2">{r.data.consequences.map((c) => <li class="bubble !rounded-xl after:hidden p-3"><span class="bang text-2xl block">{c.value}</span><span class="text-sm">{c.label}</span></li>)}</ul>
            <p class="text-sm">{r.data.tags.join(" · ")}</p>
          </div></details></li>)}
      </ol>
    </section>

    <!-- WITNESSES -->
    <section id="witnesses" class="mt-16 scroll-mt-24" aria-labelledby="ch3">
      <h2 id="ch3" class="text-5xl sm:text-6xl">Chapter 3 · Nine witnesses</h2>
      <p class="mt-2 text-xl">Every word verbatim. Nothing paraphrased.</p>
      <ul class="mt-8 md:columns-2 md:gap-10">
        {witnesses.map((w, i) => {
          const pull = w.data.pull ?? "";
          const paras = w.data.quote.split(/\n\s*\n/);
          const initials = w.data.name.split(" ").map((n) => n[0]).slice(0, 2).join("");
          return (
            <li id={`witness-${w.id}`} class="break-inside-avoid mb-10">
              <blockquote class="bubble text-lg space-y-3">
                {paras.map((para) => { const k = pull && para.includes(pull) ? para.indexOf(pull) : -1; return k < 0 ? <p>{para}</p> : <p>{para.slice(0, k)}<strong class="emph">{pull}</strong>{para.slice(k + pull.length)}</p>; })}
              </blockquote>
              <footer class="mt-6 ml-5 flex items-center gap-3">
                <span class="badge" aria-hidden="true">{initials}</span>
                <span class="caption"><span class="bang text-sm text-[#ff2e63] mr-2">{String(i + 1).padStart(2, "0")}/09</span><strong>{w.data.name}</strong> · {w.data.title}{w.data.organisation ? `, ${w.data.organisation}` : ""}</span>
              </footer>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- ORIGIN -->
    <section id="origin" class="mt-16 scroll-mt-24" aria-labelledby="ch4">
      <h2 id="ch4" class="text-5xl sm:text-6xl">Chapter 4 · Origin story</h2>
      <p class="mt-2 text-xl">From first commit to senior engineer, in order. Four issues, three promotions.</p>
      <ol class="mt-8 origin">
        {[...roles].sort((a, b) => b.data.order - a.data.order).map((r, i, arr) => {
          const promo = ["Promoted to SDE 1 within a year", "Promoted to SDE 2 within five months", "Moved to Galent as Senior Software Engineer"][i];
          return (
            <li class="origin-item">
              <div class="spine" aria-hidden="true"><span class="year bang">{r.data.start.slice(0, 4)}</span></div>
              <article class="panel p-6 sm:p-8">
                <span class="pnum">{i + 1}</span>
                <header class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-start">
                  <div><h3 class="text-3xl sm:text-4xl">{r.data.role}</h3><p class="text-lg">{r.data.company} · {r.data.type}</p></div>
                  <p class="caption justify-self-start sm:justify-self-end">{fmt(r.data.start)} → {fmt(r.data.end)}</p>
                </header>
                <div class:list={["mt-6 grid gap-6", r.data.groups.length > 1 && "lg:grid-cols-2"]}>
                  {r.data.groups.map((g) => <div class="tile"><p class="bang text-2xl" style={`color:${colors[i % 5]}`}>{g.name}</p><ul class="mt-2 list-disc pl-5 space-y-2 max-w-[62ch]">{g.bullets.map((b) => <li>{b}</li>)}</ul></div>)}
                </div>
                <ul class="mt-6 flex flex-wrap gap-2" aria-label="Worked with">{r.data.skills.map((sk) => <li class="tag">{sk}</li>)}</ul>
              </article>
              {i < arr.length - 1 && <p class="promo"><span class="caption">↓ {promo}</span></p>}
            </li>
          );
        })}
      </ol>
    </section>

    <!-- RESUME -->
    <section id="resume" class="mt-16 scroll-mt-24 panel p-6 sm:p-10 grid gap-8 lg:grid-cols-[1fr_1fr] items-center" aria-labelledby="res-h">
      <div>
        <p class="caption">Collector’s insert · 2 pages</p>
        <h2 id="res-h" class="text-5xl sm:text-6xl mt-3">The official resume</h2>
        <p class="mt-3 text-xl">{site.yearsExperience} years, the whole stack, every role with its numbers, education and the 2021 award. Read it here or take the PDF home.</p>
        <div class="mt-5 flex flex-wrap gap-3"><button type="button" class="btn" data-resume-open>Preview</button><a href={site.resume} download={site.resumeName} class="btn alt">Download PDF</a></div>
        <dl class="mt-6 grid grid-cols-2 gap-4 text-lg"><div><dt class="bang text-xl">Training</dt><dd>{site.education.degree}, {site.education.school} · {site.education.years} · CGPA {site.education.cgpa}</dd></div><div><dt class="bang text-xl">Medal</dt><dd>{site.award.title} · {site.award.by}, {site.award.year}</dd></div></dl>
      </div>
      <button type="button" class="panel !shadow-[6px_6px_0_#ff2e63] aspect-[8.5/11] w-full max-w-sm justify-self-center overflow-hidden text-left relative" data-resume-open aria-label="Open the resume preview"><iframe src={`${site.resume}#toolbar=0&navpanes=0&scrollbar=0&view=FitH`} title="" aria-hidden="true" tabindex="-1" class="pointer-events-none w-full h-full bg-white" loading="lazy"></iframe><span class="caption absolute left-3 bottom-3">Tap to read</span></button>
      <ResumeDialog dialogClass="bg-[#fff8e7] text-[#111] border-4 border-[#111]" btnClass="btn text-base py-1.5" btnAltClass="btn alt text-base py-1.5" closeClass="btn alt text-base py-1.5" />
    </section>

    <!-- POWERS -->
    <section class="mt-16" aria-labelledby="powers">
      <h2 id="powers" class="text-5xl sm:text-6xl">Power-ups</h2>
      <ul class="mt-6 flex flex-wrap gap-3">{stack.map((s, i) => <li class="panel px-4 py-2 bang text-xl" style={`background:${colors[i % 5]}22; transform: rotate(${(i % 3) - 1}deg)`}>{s}</li>)}</ul>
      <div class="panel mt-8 p-6"><p class="caption">Daily strip · GitHub, the last twelve months</p><div class="mt-4"><Calendar empty="#fff" levels={["#ffd6e0", "#ff9ab5", "#ff5c8a", "#ff2e63"]} ink="#111" /></div><p class="mt-3 text-lg"><a href={site.github} class="underline">@MDmubarak786</a></p></div>
    </section>

    <!-- BACK ISSUES -->
    <section class="mt-16" aria-labelledby="back">
      <h2 id="back" class="text-5xl sm:text-6xl">Back issues · 2020</h2>
      <p class="mt-2 text-xl">Eight Flutter apps from when I was learning mobile. Each has a demo on YouTube.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{projects.map((p) => <li class="panel p-4"><p class="caption">{fmt(p.data.period)}</p><h3 class="text-2xl mt-2">{p.data.name}</h3>{p.data.description && <p class="text-base">{p.data.description}</p>}{p.data.link && <a href={p.data.link} class="btn alt text-base mt-3 py-1">Watch demo</a>}</li>)}</ul>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="mt-16 scroll-mt-24 panel p-8 sm:p-12" aria-labelledby="ch5">
      <div class="zig mb-6"></div>
      <h2 id="ch5" class="text-5xl sm:text-7xl text-[#ff2e63]" style="-webkit-text-stroke:2px #111">Next issue needs a publisher.</h2>
      <p class="mt-3 text-2xl">Hiring for a senior or lead role? Write, call, or send a message.</p>
      <div class="mt-6 flex flex-wrap gap-3"><a href={mailto("A role")} class="btn">{site.email}</a><a href={site.whatsapp} class="btn alt">WhatsApp {site.phoneDisplay}</a></div>
      <dl class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 text-lg">{channels.map(([l, v, h]) => <div><dt class="bang text-xl">{l}</dt><dd><a href={h} class="underline break-all">{v}</a></dd></div>)}</dl>
      <p class="mt-8 text-lg flex flex-wrap items-center gap-3"><Pronounce class="caption cursor-pointer" /> <span>{site.location} · © {new Date().getFullYear()} {site.name}</span></p>
    </section>
  </main>
  <script src="../scripts/comic-motion.ts"></script>
  <script src="../scripts/page-curtain.ts"></script>
</FinalShell>
