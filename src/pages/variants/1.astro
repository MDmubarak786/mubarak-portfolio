---
import { Image } from "astro:assets";
import Shell from "../../layouts/VariantShell.astro";
import portrait from "../../assets/portrait.png";
import { v } from "../../lib/variant-data";
---
<Shell title="Variant 1 · Aurora" fonts={["--font-manrope"]} n={1}>
  <style is:global>
    :root { --v-bg:#070a14; --v-fg:#e8ecf7; --v-accent:#67e8f9; --v-font-text: var(--font-manrope); --v-font-display: var(--font-manrope); }
    .aurora { position:absolute; inset:-20% -10% auto; height:90vh; pointer-events:none; filter: blur(70px); opacity:.75;
      background: radial-gradient(40% 50% at 20% 30%, #22d3ee55, transparent 70%), radial-gradient(35% 45% at 70% 20%, #8b5cf655, transparent 70%), radial-gradient(45% 50% at 55% 70%, #3b82f644, transparent 70%);
      animation: drift 18s ease-in-out infinite alternate; }
    @keyframes drift { from { transform: translate3d(0,0,0) scale(1);} to { transform: translate3d(4%, 6%, 0) scale(1.08);} }
    .glass { background: rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.1); backdrop-filter: blur(14px); box-shadow: 0 20px 60px -30px rgba(0,0,0,.8); }
    .glass:hover { border-color: rgba(103,232,249,.35); }
  </style>
  <main class="relative overflow-hidden">
    <div class="aurora" aria-hidden="true"></div>
    <section class="relative mx-auto max-w-6xl px-6 pt-28 pb-20 grid gap-12 lg:grid-cols-[1.15fr_.85fr] lg:items-center">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs text-white/80"><span class="size-1.5 rounded-full bg-cyan-300 shadow-[0_0_12px_#67e8f9]"></span> Open to Lead / Staff roles</p>
        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.05] tracking-tight">{v.headline}</h1>
        <p class="mt-6 text-lg text-white/70 max-w-xl">{v.sub}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${v.email}`} class="rounded-full bg-cyan-300 px-6 py-3 font-semibold text-black hover:bg-cyan-200 transition shadow-[0_0_40px_-10px_#67e8f9]">Email me</a>
          <a href={v.linkedin} class="rounded-full border border-white/20 px-6 py-3 font-semibold hover:bg-white/10 transition">LinkedIn</a>
        </div>
      </div>
      <div class="relative">
        <div class="glass rounded-3xl p-3 rotate-[-2deg]"><Image src={portrait} alt={`Portrait of ${v.name}`} width={520} height={520} class="rounded-2xl w-full object-cover" /></div>
        <div class="glass absolute -left-6 bottom-10 rounded-2xl px-4 py-3 rotate-[3deg]"><p class="text-2xl font-extrabold">1.25M+</p><p class="text-xs text-white/60">monthly users</p></div>
        <div class="glass absolute -right-4 top-8 rounded-2xl px-4 py-3 rotate-[-4deg]"><p class="text-2xl font-extrabold text-cyan-300">96.5%</p><p class="text-xs text-white/60">cost cut</p></div>
      </div>
    </section>
    <section class="relative mx-auto max-w-6xl px-6 pb-20 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {v.stats.map((s) => <div class="glass rounded-2xl p-6"><p class="text-3xl font-extrabold">{s.value}</p><p class="mt-1 text-sm text-white/60">{s.label}</p></div>)}
    </section>
    <section class="relative mx-auto max-w-6xl px-6 pb-20 grid gap-6 lg:grid-cols-[1.2fr_.8fr]">
      <article class="glass rounded-3xl p-8">
        <p class="text-xs uppercase tracking-widest text-cyan-300">Case</p>
        <h2 class="mt-2 text-3xl font-extrabold">{v.caseStudy.title}</h2>
        <p class="text-sm text-white/50">{v.caseStudy.org}</p>
        <p class="mt-4 text-white/80">{v.caseStudy.body}</p>
        <ul class="mt-6 flex flex-wrap gap-2">{v.caseStudy.tags.map((t) => <li class="rounded-full border border-white/15 px-3 py-1 text-xs">{t}</li>)}</ul>
      </article>
      <div class="grid gap-4">
        {v.quotes.slice(0, 2).map((q) => <blockquote class="glass rounded-3xl p-6"><p class="text-lg leading-snug">“{q.text}”</p><footer class="mt-4 text-sm text-white/60"><strong class="text-white">{q.name}</strong><br />{q.title}</footer></blockquote>)}
      </div>
    </section>
    <section class="relative mx-auto max-w-6xl px-6 pb-24">
      <p class="text-xs uppercase tracking-widest text-white/50">Stack</p>
      <ul class="mt-4 flex flex-wrap gap-2">{v.stack.map((s) => <li class="glass rounded-xl px-4 py-2 text-sm">{s}</li>)}</ul>
      <div class="glass mt-16 rounded-3xl p-10 text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold">Let’s talk about your next platform.</h2>
        <p class="mt-3 text-white/70">{v.location} · {v.email}</p>
        <a href={v.whatsapp} class="mt-6 inline-block rounded-full bg-white px-6 py-3 font-semibold text-black hover:bg-cyan-200 transition">WhatsApp {v.phoneDisplay}</a>
      </div>
    </section>
  </main>
</Shell>
