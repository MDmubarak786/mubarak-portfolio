---
import { Image } from "astro:assets";
import Shell from "../../layouts/VariantShell.astro";
import portrait from "../../assets/portrait.png";
import { v } from "../../lib/variant-data";
---
<Shell title="Variant 2 · Signal" fonts={["--font-archivo", "--font-jetbrains"]} n={2}>
  <style is:global>
    :root { --v-bg:#0a0a0a; --v-fg:#f2f2f2; --v-accent:#c6f135; --v-font-text: var(--font-archivo); --v-font-display: var(--font-archivo); }
    body { background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 48px 48px; }
    .mono { font-family: var(--font-jetbrains); }
    .lime { color: var(--v-accent); }
    .card { border:1px solid #262626; background:#0f0f0f; transition: border-color .2s, transform .2s; }
    .card:hover { border-color: var(--v-accent); transform: translateY(-2px); }
    @keyframes pulse { 0%,100%{ box-shadow:0 0 0 0 rgba(198,241,53,.6);} 70%{ box-shadow:0 0 0 10px rgba(198,241,53,0);} }
    .dot { animation: pulse 2s infinite; }
  </style>
  <main class="mx-auto max-w-6xl px-6 pt-28 pb-20">
    <p class="mono text-xs text-white/60 flex items-center gap-2"><span class="dot size-2 rounded-full bg-[#c6f135]"></span> STATUS: OPEN TO LEAD / STAFF ROLES · {v.location.toUpperCase()}</p>
    <h1 class="mt-6 text-[clamp(3rem,10vw,8.5rem)] font-black leading-[.9] tracking-[-0.04em] uppercase">Mohammed<br /><span class="lime">Mubarak</span></h1>
    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <p class="text-xl sm:text-2xl max-w-2xl text-white/80">{v.headline}</p>
      <Image src={portrait} alt={`Portrait of ${v.name}`} width={220} height={220} class="size-40 lg:size-52 object-cover grayscale contrast-125 border border-[#262626]" />
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={`mailto:${v.email}`} class="bg-[#c6f135] text-black px-6 py-3 font-extrabold uppercase tracking-wide hover:bg-white transition">Email →</a>
      <a href={v.whatsapp} class="border border-white/30 px-6 py-3 font-extrabold uppercase tracking-wide hover:border-[#c6f135] transition">WhatsApp</a>
      <a href={v.linkedin} class="border border-white/30 px-6 py-3 font-extrabold uppercase tracking-wide hover:border-[#c6f135] transition">LinkedIn</a>
    </div>
    <dl class="mt-20 grid sm:grid-cols-2 lg:grid-cols-4 border-y border-[#262626] divide-y sm:divide-y-0 sm:divide-x divide-[#262626]">
      {v.stats.map((s) => <div class="p-6"><dt class="mono text-xs text-white/50 uppercase">{s.label}</dt><dd class="mt-2 text-5xl font-black tracking-tight lime">{s.value}</dd></div>)}
    </dl>
    <section class="mt-20 grid gap-4 lg:grid-cols-3">
      <article class="card p-8 lg:col-span-2">
        <p class="mono text-xs text-white/50">// CASE 001 · {v.caseStudy.org}</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight">{v.caseStudy.title}</h2>
        <p class="mt-4 text-white/80 text-lg max-w-2xl">{v.caseStudy.body}</p>
        <p class="mono mt-6 text-xs lime">{v.caseStudy.tags.join("  ·  ")}</p>
      </article>
      <article class="card p-8">
        <p class="mono text-xs text-white/50">// EXPERIENCE</p>
        <ol class="mt-4 space-y-4">{v.roles.map((r) => <li><p class="font-extrabold">{r.role}</p><p class="mono text-xs text-white/50">{r.when}</p></li>)}</ol>
      </article>
    </section>
    <section class="mt-4 grid gap-4 md:grid-cols-3">
      {v.quotes.map((q) => <blockquote class="card p-6"><p class="text-lg font-semibold leading-snug">“{q.text}”</p><footer class="mono mt-4 text-xs text-white/50">{q.name} · {q.title}</footer></blockquote>)}
    </section>
    <section class="mt-20">
      <p class="mono text-xs text-white/50">// STACK</p>
      <p class="mt-3 text-2xl font-extrabold leading-relaxed">{v.stack.map((s, i) => <span><span class="hover:text-[#c6f135] transition">{s}</span>{i < v.stack.length - 1 && <span class="text-white/20"> / </span>}</span>)}</p>
    </section>
    <footer class="mt-24 border-t border-[#262626] pt-8 mono text-xs text-white/50 flex flex-wrap gap-6"><span>{v.email}</span><span>{v.phoneDisplay}</span><span class="font-sans" lang="ta">{v.tamilName}</span></footer>
  </main>
</Shell>
