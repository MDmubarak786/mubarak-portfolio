---
import { Image } from "astro:assets";
import Shell from "../../layouts/VariantShell.astro";
import portrait from "../../assets/portrait.png";
import { v } from "../../lib/variant-data";
---
<Shell title="Variant 5 · Orbit" fonts={["--font-unbounded", "--font-onest"]} n={5}>
  <style is:global>
    :root { --v-bg:#030303; --v-fg:#ffffff; --v-accent:#60a5fa; --v-font-text: var(--font-onest); --v-font-display: var(--font-unbounded); }
    .orb { position:absolute; left:50%; top:38%; width:min(80vw,820px); aspect-ratio:1; transform:translate(-50%,-50%); border-radius:50%; pointer-events:none;
      background: conic-gradient(from 0deg, #2563eb, #7c3aed, #db2777, #f59e0b, #2563eb); filter: blur(60px) saturate(1.2); opacity:.55; animation: spin 24s linear infinite; }
    @keyframes spin { to { transform: translate(-50%,-50%) rotate(360deg);} }
    .ring { position:absolute; left:50%; top:38%; width:min(90vw,980px); aspect-ratio:1; transform:translate(-50%,-50%); border-radius:50%; border:1px solid rgba(255,255,255,.08); pointer-events:none; }
    .card { border:1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.03); border-radius:1.25rem; transition: box-shadow .3s, border-color .3s; }
    .card:hover { border-color: rgba(96,165,250,.6); box-shadow: 0 0 60px -20px #60a5fa; }
    .marquee { display:flex; gap:3rem; white-space:nowrap; animation: scroll 30s linear infinite; }
    @keyframes scroll { to { transform: translateX(-50%);} }
  </style>
  <main class="relative overflow-hidden">
    <div class="orb" aria-hidden="true"></div><div class="ring" aria-hidden="true"></div>
    <section class="relative mx-auto max-w-6xl px-6 pt-36 pb-16 text-center">
      <Image src={portrait} alt={`Portrait of ${v.name}`} width={160} height={160} class="mx-auto size-28 rounded-full border-2 border-white/20 object-cover shadow-[0_0_80px_-10px_#7c3aed]" />
      <h1 class="mt-8 text-[clamp(2.4rem,8vw,6.5rem)] font-extrabold leading-[.95] tracking-tight" style="font-family: var(--font-unbounded)">MOHAMMED<br />MUBARAK</h1>
      <p class="mt-6 text-lg sm:text-2xl text-white/75 max-w-3xl mx-auto">{v.headline}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`mailto:${v.email}`} class="rounded-full bg-white text-black px-7 py-3 font-semibold hover:scale-105 transition">Hire me</a>
        <a href={v.whatsapp} class="rounded-full border border-white/25 px-7 py-3 font-semibold hover:bg-white/10 transition">WhatsApp</a>
        <a href={v.linkedin} class="rounded-full border border-white/25 px-7 py-3 font-semibold hover:bg-white/10 transition">LinkedIn</a>
      </div>
    </section>
    <div class="relative overflow-hidden border-y border-white/10 py-4" aria-hidden="true"><div class="marquee text-sm uppercase tracking-[0.3em] text-white/60">{[...v.stack, ...v.stack].map((s) => <span>{s}</span>)}</div></div>
    <section class="relative mx-auto max-w-6xl px-6 py-20 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {v.stats.map((s) => <div class="card p-7"><p class="text-4xl font-extrabold" style="font-family: var(--font-unbounded)">{s.value}</p><p class="mt-2 text-sm text-white/60">{s.label}</p></div>)}
    </section>
    <section class="relative mx-auto max-w-6xl px-6 pb-20 grid gap-4 lg:grid-cols-3">
      <article class="card p-8 lg:col-span-2 bg-gradient-to-br from-blue-600/20 to-fuchsia-600/10">
        <p class="text-xs uppercase tracking-widest text-blue-300">Case · {v.caseStudy.org}</p>
        <h2 class="mt-3 text-3xl font-extrabold" style="font-family: var(--font-unbounded)">{v.caseStudy.title}</h2>
        <p class="mt-4 text-white/80 text-lg">{v.caseStudy.body}</p>
        <p class="mt-5 text-sm text-white/50">{v.caseStudy.tags.join(" · ")}</p>
      </article>
      <div class="grid gap-4">{v.quotes.slice(0, 2).map((q) => <blockquote class="card p-6"><p class="leading-snug">“{q.text}”</p><footer class="mt-3 text-xs text-white/50">{q.name} · {q.title}</footer></blockquote>)}</div>
    </section>
    <section class="relative mx-auto max-w-6xl px-6 pb-24 grid gap-4 md:grid-cols-3">
      {v.roles.map((r) => <div class="card p-6"><p class="font-semibold">{r.role}</p><p class="text-sm text-white/50">{r.org} · {r.when}</p></div>)}
    </section>
    <footer class="relative border-t border-white/10 py-12 text-center text-white/60 text-sm"><p lang="ta" class="text-white text-lg">{v.tamilName}</p><p class="mt-2">{v.email} · {v.phoneDisplay} · {v.location}</p></footer>
  </main>
</Shell>
