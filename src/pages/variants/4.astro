---
import { Image } from "astro:assets";
import Shell from "../../layouts/VariantShell.astro";
import portrait from "../../assets/portrait.png";
import { v } from "../../lib/variant-data";
---
<Shell title="Variant 4 · Bento" fonts={["--font-sora"]} n={4}>
  <style is:global>
    :root { --v-bg:#0b0f19; --v-fg:#e6e9f2; --v-accent:#a78bfa; --v-font-text: var(--font-sora); --v-font-display: var(--font-sora); }
    .tile { position:relative; border-radius:1.5rem; border:1px solid rgba(255,255,255,.08); background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02)); overflow:hidden; transition: transform .25s, border-color .25s; }
    .tile:hover { transform: translateY(-3px); border-color: rgba(167,139,250,.5); }
    .glow::before { content:""; position:absolute; inset:-40%; background: radial-gradient(circle at 30% 20%, rgba(167,139,250,.35), transparent 50%), radial-gradient(circle at 80% 80%, rgba(244,114,182,.3), transparent 50%); pointer-events:none; }
    .grad { background: linear-gradient(90deg,#a78bfa,#f472b6); -webkit-background-clip:text; background-clip:text; color:transparent; }
  </style>
  <main class="mx-auto max-w-6xl px-6 pt-24 pb-20">
    <div class="grid gap-4 md:grid-cols-6 auto-rows-[minmax(140px,auto)]">
      <section class="tile glow p-8 md:col-span-4 md:row-span-2 flex flex-col justify-end">
        <p class="text-sm text-white/60">Lead Software Engineer · IncrescoTech · {v.location}</p>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold leading-[1.05] tracking-tight">Hi, I’m Mubarak. I build <span class="grad">platforms at scale</span> and own them end to end.</h1>
        <div class="mt-6 flex flex-wrap gap-3"><a href={`mailto:${v.email}`} class="rounded-xl bg-white text-black px-5 py-2.5 font-semibold hover:bg-violet-200 transition">Email</a><a href={v.linkedin} class="rounded-xl border border-white/15 px-5 py-2.5 font-semibold hover:bg-white/10 transition">LinkedIn</a><a href={v.whatsapp} class="rounded-xl border border-white/15 px-5 py-2.5 font-semibold hover:bg-white/10 transition">WhatsApp</a></div>
      </section>
      <section class="tile md:col-span-2 md:row-span-2"><Image src={portrait} alt={`Portrait of ${v.name}`} width={600} height={600} class="w-full h-full object-cover" /></section>
      {v.stats.map((s) => <section class="tile p-6 md:col-span-2 lg:col-span-1 xl:col-span-1 md:col-span-3"><p class="text-4xl font-extrabold grad w-fit">{s.value}</p><p class="mt-2 text-sm text-white/60">{s.label}</p></section>)}
      <section class="tile md:col-span-2 p-6"><p class="text-xs text-white/50">Local time</p><p class="mt-2 text-3xl font-bold" data-clock>--:--</p><p class="text-sm text-white/60">IST, {v.location}</p></section>
      <section class="tile p-8 md:col-span-4 md:row-span-2">
        <p class="text-xs text-white/50">Case · {v.caseStudy.org}</p>
        <h2 class="mt-2 text-3xl font-extrabold">{v.caseStudy.title}</h2>
        <p class="mt-4 text-white/75">{v.caseStudy.body}</p>
        <ul class="mt-5 flex flex-wrap gap-2">{v.caseStudy.tags.map((t) => <li class="rounded-lg bg-white/5 border border-white/10 px-3 py-1 text-xs">{t}</li>)}</ul>
      </section>
      <section class="tile p-6 md:col-span-2 md:row-span-2"><p class="text-xs text-white/50">Experience</p><ol class="mt-3 space-y-3">{v.roles.map((r) => <li><p class="font-semibold">{r.role}</p><p class="text-xs text-white/50">{r.when}</p></li>)}</ol></section>
      {v.quotes.map((q) => <blockquote class="tile p-6 md:col-span-2"><p class="leading-snug">“{q.text}”</p><footer class="mt-3 text-xs text-white/50"><strong class="text-white/80">{q.name}</strong> · {q.title}</footer></blockquote>)}
      <section class="tile p-6 md:col-span-6"><p class="text-xs text-white/50">Stack</p><ul class="mt-3 flex flex-wrap gap-2">{v.stack.map((s) => <li class="rounded-lg bg-white/5 border border-white/10 px-3 py-1.5 text-sm">{s}</li>)}</ul></section>
    </div>
    <script>
      const el = document.querySelector("[data-clock]");
      const tick = () => { if (el) el.textContent = new Date().toLocaleTimeString("en-IN", { timeZone: "Asia/Kolkata", hour: "2-digit", minute: "2-digit" }); };
      tick(); setInterval(tick, 30000);
    </script>
  </main>
</Shell>
