---
import Shell from "../../layouts/StoryShell.astro";
import { me, numbers, work, voices, migration } from "../../lib/story";
const signs = [["#ff2d95", "முபாரக்"], ["#19d3ff", "LEAD ENGINEER"], ["#ffe600", "1.25M USERS"], ["#ff2d95", "23 LANGUAGES"], ["#19d3ff", "AWS GLUE"], ["#ff3b3b", "HIRE ME"]];
---
<Shell title="3 · Night Street" fonts={["--font-bebas", "--font-barlow", "--font-tamil"]} n={3}>
  <style is:global>
    :root { --v-bg:#05060a; --v-fg:#eef; --v-accent:#ff3b3b; --v-font-text: var(--font-barlow); --v-font-display: var(--font-bebas); }
    body { background-image: linear-gradient(180deg, #05060a, #0b0d16 60%, #05060a); }
    .rain { position:fixed; inset:0; pointer-events:none; background: repeating-linear-gradient(100deg, transparent 0 18px, rgba(255,255,255,.035) 18px 19px); animation: rain 1.2s linear infinite; }
    @keyframes rain { to { background-position: 60px 400px; } }
    .neon { font-family: var(--font-bebas); letter-spacing:.04em; color:#fff; text-shadow: 0 0 6px var(--c), 0 0 18px var(--c), 0 0 42px var(--c); border: 3px solid var(--c); box-shadow: 0 0 14px var(--c), inset 0 0 14px color-mix(in oklab, var(--c) 40%, transparent); }
    .neon.dim { opacity:.45; filter: saturate(.5); animation: buzz 4s infinite; }
    @keyframes buzz { 0%,92%,100%{opacity:.45} 94%{opacity:.2} 96%{opacity:.5} }
    .reflect { transform: scaleY(-1); opacity:.25; filter: blur(2px); mask-image: linear-gradient(#000, transparent 70%); }
    .trail { height:3px; background: linear-gradient(90deg, transparent, #ff3b3b, transparent); filter: blur(1px); }
    .tamil { font-family: var(--font-tamil); }
  </style>
  <div class="rain" aria-hidden="true"></div>
  <main class="relative max-w-5xl mx-auto px-5 sm:px-8 pt-24 pb-24">
    <p class="text-sm tracking-[0.3em] uppercase text-white/50">Chennai · 11:40 PM · raining</p>
    <h1 class="mt-3 text-[clamp(3rem,9vw,8rem)] leading-[0.9]" style="font-family:var(--font-bebas)">The street where<br />the platforms never sleep.</h1>
    <p class="mt-4 max-w-xl text-lg text-white/80">{me.intro} Climb the signs.</p>

    <div class="mt-14 grid gap-5 sm:grid-cols-3 items-end">
      {signs.map(([c, t], i) => <div class="flex flex-col items-center"><div class:list={["neon px-6 py-3 text-3xl sm:text-4xl text-center rounded-sm", i < 5 && i !== 1 && "dim", t.match(/[஀-௿]/) && "tamil"]} style={`--c:${c}`}>{t}</div><div class="neon reflect px-6 py-3 text-3xl sm:text-4xl text-center rounded-sm mt-1" style={`--c:${c}`} aria-hidden="true">{t}</div></div>)}
    </div>
    <div class="trail mt-6"></div>

    <section class="mt-20 grid gap-6 sm:grid-cols-4">
      {numbers.map((n, i) => <div class="border border-white/15 p-5"><p class="text-5xl" style={`font-family:var(--font-bebas); color:${["#ff2d95","#19d3ff","#ffe600","#ff3b3b"][i]}`}>{n.v}</p><p class="font-bold">{n.k}</p><p class="text-sm text-white/60">{n.d}</p></div>)}
    </section>

    <section class="mt-20">
      <h2 class="text-5xl" style="font-family:var(--font-bebas)">District 1 · The migration</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-5">{migration.map((m, i) => <li class="border-l-2 border-[#19d3ff] pl-4"><p class="text-xs text-white/50">0{i + 1}</p><p class="font-bold text-lg">{m.t}</p><p class="text-sm text-white/75 mt-1">{m.s}</p></li>)}</ol>
    </section>

    <section class="mt-20">
      <h2 class="text-5xl" style="font-family:var(--font-bebas)">District 2 · Signage</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">{work.map((w, i) => <li class="neon dim p-5 rounded-sm normal-case" style={`--c:${["#ff2d95","#19d3ff","#ffe600"][i % 3]}; font-family: var(--font-barlow); letter-spacing:0; text-shadow:none`}><p class="text-xs uppercase tracking-widest text-white/60">{w.kind} · {w.year}</p><p class="text-2xl font-extrabold">{w.title}</p><p class="mt-1 text-white/80">{w.out}</p></li>)}</ul>
    </section>

    <section class="mt-20 grid gap-6 md:grid-cols-2">{voices.slice(0, 2).map((v) => <blockquote class="border border-white/15 p-6"><p class="text-xl font-semibold">“{v.q}”</p><footer class="mt-3 text-sm text-white/60">{v.n}, {v.t}</footer></blockquote>)}</section>

    <footer class="mt-24 text-center"><a href={`mailto:${me.email}`} class="neon inline-block px-10 py-5 text-5xl rounded-sm" style="--c:#ff3b3b">HIRE ME</a><p class="mt-6 text-white/60">{me.email} · {me.phoneDisplay}</p></footer>
  </main>
</Shell>
