---
import Shell from "../../layouts/StoryShell.astro";
import { me, numbers, work, voices, languages } from "../../lib/story";
const lines = [
  { name: "Frontend line", color: "#7b2cbf", stations: [["2021", "Edvanza, React Native + Next.js"], ["2022", "Incresco marketing site"], ["2023", "Camped on Astro · 100% Lighthouse"], ["2025", "EF Academy platform · 1.25M users"]] },
  { name: "Integration line", color: "#ff7a00", stations: [["2023", "Prospect Uploader · Lambda + EventBridge"], ["2023", "Storyblok translation workflow"], ["2024", "Tibco → AWS Glue · 96.5% saved"]] },
  { name: "AI line", color: "#1b998b", stations: [["2025", "AI document processing · 95%"], ["2025", "Chrome extensions · 3–5 h/day saved"], ["2026", "Senior Software Engineer · Galent"]] },
];
---
<Shell title="1 · Namma Metro" fonts={["--font-overpass"]} n={1}>
  <style is:global>
    :root { --v-bg:#f6f1e7; --v-fg:#15131a; --v-accent:#7b2cbf; --v-font-text: var(--font-overpass); --v-font-display: var(--font-overpass); }
    .ticket { background:#fff; border:2px solid #15131a; box-shadow: 6px 6px 0 #15131a; }
    .line path { stroke-dasharray: 2000; stroke-dashoffset: 2000; animation: draw 2.6s cubic-bezier(.2,.8,.2,1) forwards; }
    .line:nth-child(2) path { animation-delay:.4s } .line:nth-child(3) path { animation-delay:.8s }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    .station:hover circle { r: 11; }
    .board { font-variant-numeric: tabular-nums; }
  </style>
  <main class="max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-24">
    <header class="grid gap-6 lg:grid-cols-[1fr_auto] items-end">
      <div>
        <p class="font-black uppercase tracking-widest text-sm" style="color:var(--v-accent)">Namma Portfolio · Route map 2021 → 2026</p>
        <h1 class="mt-3 text-[clamp(2.6rem,7vw,6rem)] font-black leading-[0.95] tracking-tight">Mubarak<br />Shajahan</h1>
        <p class="mt-4 text-lg max-w-xl">{me.intro} Every station below is something I shipped. Hover one.</p>
      </div>
      <div class="ticket p-5 rotate-[-2deg] w-64">
        <p class="text-xs font-black uppercase">Single journey</p>
        <p class="text-2xl font-black mt-1">Hiring → Mubarak</p>
        <p class="text-xs mt-2">Valid for Senior / Lead roles · {me.location}</p>
        <a href={`mailto:${me.email}`} class="mt-3 inline-block bg-[#15131a] text-white px-3 py-1.5 text-sm font-bold">Tap in → email</a>
      </div>
    </header>

    <svg viewBox="0 0 1200 520" class="mt-12 w-full h-auto" role="img" aria-label="Career route map with three lines">
      <g class="line" fill="none" stroke={lines[0].color} stroke-width="14" stroke-linecap="round"><path d="M60 120 H420 Q470 120 500 160 L620 300 Q650 340 700 340 H1140" /></g>
      <g class="line" fill="none" stroke={lines[1].color} stroke-width="14" stroke-linecap="round"><path d="M60 300 H380 Q430 300 460 260 L560 160 Q590 120 640 120 H1140" /></g>
      <g class="line" fill="none" stroke={lines[2].color} stroke-width="14" stroke-linecap="round"><path d="M60 440 H520 Q580 440 620 400 L700 320 L1140 320" /></g>
      {lines.map((l, li) => l.stations.map(([y, label], i) => {
        const pts = [[[120,120],[300,120],[560,230],[980,340]],[[120,300],[300,300],[900,120]],[[180,440],[420,440],[1000,320]]][li];
        const [cx, cy] = pts[i];
        return <g class="station cursor-pointer"><circle cx={cx} cy={cy} r="9" fill="#fff" stroke="#15131a" stroke-width="4"><title>{y}: {label}</title></circle><text x={cx} y={cy + (li === 0 && i < 2 ? -20 : 32)} font-size="15" font-weight="800" text-anchor="middle" fill="#15131a">{label.split(" · ")[0]}</text><text x={cx} y={cy + (li === 0 && i < 2 ? -38 : 50)} font-size="12" text-anchor="middle" fill="#6b6475">{y}</text></g>;
      }))}
      <g><circle cx="700" cy="330" r="16" fill="#fff" stroke="#15131a" stroke-width="5" /><text x="700" y="372" font-size="13" font-weight="900" text-anchor="middle">INTERCHANGE · EF ACADEMY</text></g>
    </svg>
    <ul class="mt-4 flex flex-wrap gap-5 text-sm font-bold">{lines.map((l) => <li class="flex items-center gap-2"><span class="w-6 h-2 rounded-full" style={`background:${l.color}`}></span>{l.name}</li>)}</ul>

    <section class="mt-20 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {numbers.map((n) => <div class="ticket p-6"><p class="text-4xl font-black tracking-tight">{n.v}</p><p class="font-bold mt-1">{n.k}</p><p class="text-sm text-[#6b6475]">{n.d}</p></div>)}
    </section>

    <section class="mt-20">
      <h2 class="text-3xl font-black">Departures · languages served</h2>
      <div class="board mt-5 bg-[#15131a] text-[#ffd166] p-5 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-x-6 gap-y-2 font-bold text-sm">
        {languages.map((l, i) => <p class="flex justify-between border-b border-white/10 pb-1"><span>{l}</span><span class="text-white/60">{String(6 + i % 12).padStart(2, "0")}:{String((i * 7) % 60).padStart(2, "0")}</span></p>)}
      </div>
    </section>

    <section class="mt-20 grid gap-4 lg:grid-cols-2">
      {work.map((w, i) => <article class="ticket p-6"><p class="text-xs font-black uppercase" style={`color:${lines[i % 3].color}`}>{w.kind} · {w.year}</p><h3 class="text-2xl font-black mt-1">{w.title}</h3><p class="mt-2">{w.body}</p><p class="mt-3 font-bold">{w.out}</p></article>)}
    </section>

    <section class="mt-20 grid gap-6 lg:grid-cols-2">
      {voices.map((v) => <blockquote class="border-l-8 pl-5" style="border-color:var(--v-accent)"><p class="text-xl font-bold leading-snug">“{v.q}”</p><footer class="mt-2 text-sm">{v.n}, {v.t}</footer></blockquote>)}
    </section>

    <footer class="mt-24 ticket p-8 flex flex-wrap items-center justify-between gap-6">
      <div><p class="text-3xl font-black">End of the line. Let’s talk.</p><p class="mt-1">{me.email} · {me.phoneDisplay}</p></div>
      <a href={me.whatsapp} class="bg-[#15131a] text-white px-6 py-3 font-black">WhatsApp</a>
    </footer>
  </main>
</Shell>
