---
import { Image } from "astro:assets";
import Shell from "../../layouts/StoryShell.astro";
import portrait from "../../assets/portrait.png";
import { me, migration, numbers, work, voices } from "../../lib/story";
---
<Shell title="8 · Field Logbook" fonts={["--font-caveat", "--font-elite"]} n={8}>
  <style is:global>
    :root { --v-bg:#2b4a3a; --v-fg:#1f1a14; --v-accent:#c0392b; --v-font-text: var(--font-elite); --v-font-display: var(--font-caveat); }
    body { background-image: repeating-linear-gradient(45deg, rgba(0,0,0,.08) 0 2px, transparent 2px 6px); }
    .book { background:#f5efe0; background-image: linear-gradient(transparent 31px, #d8cfb8 32px); background-size: 100% 32px; box-shadow: 0 40px 80px -30px rgba(0,0,0,.7); }
    .hand { font-family: var(--font-caveat); }
    .tape { position:absolute; width:90px; height:26px; background:rgba(255,230,120,.75); transform: rotate(-4deg); left:50%; margin-left:-45px; top:-12px; }
    .photo { background:#fff; padding:10px 10px 36px; box-shadow: 0 10px 20px -10px rgba(0,0,0,.5); position:relative; }
    .stamp { font-family: var(--font-elite); color:#c0392b; border:3px solid #c0392b; padding:.3rem .8rem; transform: rotate(-8deg); display:inline-block; letter-spacing:.1em; opacity:.85; }
  </style>
  <main class="max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-24">
    <div class="book p-6 sm:p-12 grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <p class="text-sm uppercase tracking-widest">Field log · Integration layer · EF Academy</p>
        <h1 class="hand text-[clamp(3rem,7vw,6rem)] leading-none mt-3">Mubarak Shajahan,<br />engineer on site.</h1>
        <p class="mt-4 text-[1.05rem] leading-relaxed">{me.intro}</p>
        <div class="photo mt-8 w-56 rotate-[-3deg]"><span class="tape"></span><Image src={portrait} alt={`Portrait of ${me.name}`} width={400} height={400} class="w-full object-cover" style="filter: sepia(.3) contrast(1.1)" /><p class="hand text-xl mt-2 text-center">Chennai, on call.</p></div>
      </div>
      <div>
        <p class="stamp">Contract end: approaching</p>
        <ol class="mt-6 space-y-5">{migration.map((m, i) => <li><p class="hand text-3xl text-[#c0392b]">Day {[1, 4, 9, 30, 31][i]} · {m.t}</p><p class="text-[1.05rem] leading-relaxed">{m.s}</p></li>)}</ol>
        <p class="stamp mt-6">Delivered · no disruption</p>
      </div>
    </div>

    <section class="mt-10 grid gap-4 sm:grid-cols-4">{numbers.map((n) => <div class="book p-5"><p class="hand text-5xl">{n.v}</p><p class="font-bold text-sm">{n.k}</p><p class="text-xs">{n.d}</p></div>)}</section>

    <section class="book mt-10 p-6 sm:p-10">
      <h2 class="hand text-5xl">Other entries</h2>
      <ul class="mt-4 grid gap-6 md:grid-cols-3">{work.map((w) => <li><p class="text-xs uppercase tracking-widest">{w.year} · {w.kind}</p><p class="hand text-3xl">{w.title}</p><p class="text-sm leading-relaxed mt-1">{w.body}</p><p class="text-sm font-bold mt-1">{w.out}</p></li>)}</ul>
    </section>

    <section class="book mt-10 p-6 sm:p-10 grid gap-8 md:grid-cols-2">{voices.map((v) => <blockquote><p class="hand text-2xl leading-snug">“{v.q}”</p><footer class="text-sm mt-1">— {v.n}, {v.t}</footer></blockquote>)}</section>
    <footer class="book mt-10 p-8 text-center"><p class="hand text-4xl">Write to me. I answer the letters.</p><a href={`mailto:${me.email}`} class="mt-3 inline-block underline">{me.email}</a> · {me.phoneDisplay}</footer>
  </main>
</Shell>
