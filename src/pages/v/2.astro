---
import { Image } from "astro:assets";
import Shell from "../../layouts/StoryShell.astro";
import portrait from "../../assets/portrait.png";
import { me, numbers, work, voices, stack } from "../../lib/story";
---
<Shell title="2 · Highlife Sleeve" fonts={["--font-lilita", "--font-nunito"]} n={2}>
  <style is:global>
    :root { --v-bg:#f7e9c9; --v-fg:#1d1a14; --v-accent:#e63946; --v-font-text: var(--font-nunito); --v-font-display: var(--font-lilita); }
    .sleeve { background:#ff9f1c; box-shadow: 0 30px 60px -30px rgba(0,0,0,.5); }
    .arc text { font-family: var(--font-lilita); font-size: 92px; fill:#fff; paint-order: stroke; stroke:#1d1a14; stroke-width: 10px; letter-spacing: 2px; }
    .track { border-bottom: 2px dashed #1d1a14; transition: background .2s, transform .2s; }
    .track:hover { background:#fff3; transform: translateX(6px); }
    .disc { background: repeating-radial-gradient(circle at center, #111 0 2px, #222 2px 4px); }
    @keyframes spin { to { transform: rotate(360deg);} }
  </style>
  <main class="max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-24">
    <section class="sleeve rounded-sm p-6 sm:p-10 relative overflow-hidden">
      <div class="absolute inset-0 opacity-25" style="background: radial-gradient(circle at 20% 80%, #2a9d8f 0 30%, transparent 31%), radial-gradient(circle at 85% 20%, #e63946 0 22%, transparent 23%)"></div>
      <svg viewBox="0 0 1000 320" class="relative w-full h-auto"><defs><path id="arc" d="M60 290 Q500 -80 940 290" /></defs><g class="arc"><text><textPath href="#arc" startOffset="50%" text-anchor="middle">Mubarak Shajahan</textPath></text></g></svg>
      <div class="relative grid gap-8 md:grid-cols-[auto_1fr] items-end -mt-10">
        <div class="relative"><Image src={portrait} alt={`Portrait of ${me.name}`} width={520} height={520} class="w-64 sm:w-80 rounded-[2rem] border-8 border-[#f7e9c9] rotate-[-3deg] object-cover" /><span class="absolute -right-4 -top-4 bg-[#e63946] text-white font-display text-xl px-4 py-2 rotate-6" style="font-family:var(--font-lilita)">LP · 2026</span></div>
        <div>
          <p class="text-2xl sm:text-3xl font-black">Senior Software Engineer &amp; his Full-Stack + AI Orchestra</p>
          <p class="mt-2 text-lg">Recorded live in Chennai. {me.intro}</p>
          <div class="mt-5 flex flex-wrap gap-3"><a href={`mailto:${me.email}`} class="bg-[#1d1a14] text-white px-5 py-3 font-black rounded-full">Book the band</a><a href={me.linkedin} class="bg-[#2a9d8f] text-white px-5 py-3 font-black rounded-full">LinkedIn</a></div>
        </div>
      </div>
    </section>

    <section class="mt-12 grid gap-8 lg:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-4xl" style="font-family:var(--font-lilita)">Side A · The work</h2>
        <ol class="mt-4">{work.map((w, i) => <li class="track flex items-baseline gap-4 py-3"><span class="font-black w-8">A{i + 1}</span><span class="flex-1"><span class="font-black text-lg">{w.title}</span><span class="block text-sm">{w.out}</span></span><span class="text-sm font-bold">{w.year}</span></li>)}</ol>
      </div>
      <div>
        <h2 class="text-4xl" style="font-family:var(--font-lilita)">Side B · Liner notes</h2>
        <ol class="mt-4 space-y-4">{voices.map((v, i) => <li class="track pb-3"><p class="font-bold">B{i + 1} · “{v.q}”</p><p class="text-sm">{v.n}, {v.t}</p></li>)}</ol>
      </div>
    </section>

    <section class="mt-14 grid gap-4 sm:grid-cols-4">
      {numbers.map((n, i) => <div class="rounded-3xl p-6 text-white" style={`background:${["#e63946","#2a9d8f","#7b2cbf","#f77f00"][i]}`}><p class="text-4xl" style="font-family:var(--font-lilita)">{n.v}</p><p class="font-black">{n.k}</p><p class="text-sm opacity-90">{n.d}</p></div>)}
    </section>

    <section class="mt-14 flex flex-wrap items-center gap-8">
      <div class="disc size-48 rounded-full grid place-items-center animate-[spin_6s_linear_infinite]"><div class="size-16 rounded-full bg-[#e63946] grid place-items-center text-white text-xs font-black text-center leading-tight">MK<br />2026</div></div>
      <div><h2 class="text-3xl" style="font-family:var(--font-lilita)">Credits · The instruments</h2><p class="mt-2 max-w-xl">{stack.join(" · ")}</p></div>
    </section>

    <footer class="mt-16 text-center"><p class="text-4xl" style="font-family:var(--font-lilita)">Encore?</p><p class="mt-2">{me.email} · {me.phoneDisplay} · <span lang="ta">{me.tamilName}</span></p></footer>
  </main>
</Shell>
