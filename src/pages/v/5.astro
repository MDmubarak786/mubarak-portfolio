---
import Shell from "../../layouts/StoryShell.astro";
import { me, numbers, work, voices, languages, roles } from "../../lib/story";
---
<Shell title="5 · Terminal M" fonts={["--font-barlow-c", "--font-barlow", "--font-mono"]} n={5}>
  <style is:global>
    :root { --v-bg:#0e1116; --v-fg:#f3f4f0; --v-accent:#ffd400; --v-font-text: var(--font-barlow); --v-font-display: var(--font-barlow-c); }
    .board { background:#111; border: 2px solid #222; }
    .flap { font-family: var(--font-mono); background:#1c1c1c; color:#ffd400; padding:.15rem .4rem; border-radius:3px; display:inline-block; position:relative; }
    .flap::after { content:""; position:absolute; left:0; right:0; top:50%; height:1px; background:#000; }
    .row { animation: flip .5s steps(4) both; }
    @keyframes flip { from { opacity:0; transform: rotateX(90deg);} to { opacity:1; transform:none;} }
    .pass { background:#f3f4f0; color:#0e1116; border-radius: 1rem; position:relative; }
    .pass::before, .pass::after { content:""; position:absolute; top:50%; width:22px; height:22px; background:#0e1116; border-radius:50%; transform:translateY(-50%); }
    .pass::before { left:-11px } .pass::after { right:-11px }
    .dash { border-top: 2px dashed #0e1116; }
  </style>
  <main class="max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-24">
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div><p class="text-[#ffd400] font-bold tracking-[0.3em] uppercase text-sm">Terminal M · Chennai</p><h1 class="mt-2 text-[clamp(3rem,9vw,8rem)] leading-[0.9] font-black uppercase">Now<br />boarding</h1></div>
      <div class="text-right"><p class="text-2xl font-bold">{me.name}</p><p class="text-white/70">{me.role} · {me.employer}</p><p class="text-white/50 text-sm">Passport: <span lang="ta">{me.tamilName}</span></p></div>
    </header>

    <section class="board mt-10 p-4 sm:p-6">
      <div class="grid grid-cols-[1fr_auto_auto] gap-3 text-xs uppercase tracking-widest text-white/50 px-2"><span>Destination · languages served</span><span>Gate</span><span>Status</span></div>
      <ol class="mt-2 divide-y divide-white/10">{languages.map((l, i) => <li class="row grid grid-cols-[1fr_auto_auto] gap-3 items-center px-2 py-1.5" style={`animation-delay:${i * 60}ms`}><span class="flap text-lg sm:text-xl">{l}</span><span class="flap">M{String(i + 1).padStart(2, "0")}</span><span class="text-[#39d98a] font-bold text-sm">LIVE</span></li>)}</ol>
      <p class="mt-3 text-sm text-white/60 px-2">All 23 destinations run from one codebase. 1.25M+ passengers a month.</p>
    </section>

    <section class="mt-16 grid gap-4 sm:grid-cols-4">{numbers.map((n) => <div class="board p-5"><p class="text-5xl font-black" style="font-family:var(--font-barlow-c)">{n.v}</p><p class="font-bold">{n.k}</p><p class="text-sm text-white/60">{n.d}</p></div>)}</section>

    <section class="mt-16">
      <h2 class="text-4xl font-black uppercase">Boarding passes</h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-2">{work.map((w, i) => <li class="pass p-6 grid grid-cols-[1fr_auto] gap-4"><div><p class="text-xs uppercase tracking-widest opacity-60">{w.kind} · {w.org}</p><p class="text-2xl font-black uppercase mt-1" style="font-family:var(--font-barlow-c)">{w.title}</p><p class="mt-2 text-sm">{w.body}</p><p class="dash mt-3 pt-2 text-sm font-bold">{w.out}</p></div><div class="text-right text-xs"><p class="opacity-60">Seat</p><p class="text-3xl font-black">{i + 1}A</p><p class="opacity-60 mt-3">Year</p><p class="font-bold">{w.year}</p></div></li>)}</ul>
    </section>

    <section class="mt-16 grid gap-6 md:grid-cols-2">{voices.slice(0, 2).map((v) => <blockquote class="board p-6"><p class="text-xl font-semibold">“{v.q}”</p><footer class="mt-3 text-sm text-white/60">{v.n}, {v.t}</footer></blockquote>)}</section>
    <section class="mt-16 board p-6"><h2 class="text-2xl font-black uppercase">Flight log</h2><ol class="mt-3 divide-y divide-white/10">{roles.map((r) => <li class="py-2 flex justify-between gap-4"><span class="font-bold">{r.r}</span><span class="text-white/60">{r.w}</span></li>)}</ol></section>
    <footer class="mt-16 text-center"><a href={`mailto:${me.email}`} class="inline-block bg-[#ffd400] text-black px-8 py-4 text-2xl font-black uppercase">Final call · email me</a><p class="mt-4 text-white/60">{me.phoneDisplay}</p></footer>
  </main>
</Shell>
