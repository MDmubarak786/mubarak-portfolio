---
import { Image } from "astro:assets";
import Shell from "../../layouts/StoryShell.astro";
import portrait from "../../assets/portrait.png";
import { me, migration, numbers, work, voices } from "../../lib/story";
const sfx = ["TICK", "HMM", "PLAN!", "SWITCH!", "KA-CHING"];
---
<Shell title="6 · The Migration, a comic" fonts={["--font-bangers", "--font-patrick"]} n={6}>
  <style is:global>
    :root { --v-bg:#fff8e7; --v-fg:#111; --v-accent:#ff2e63; --v-font-text: var(--font-patrick); --v-font-display: var(--font-bangers); }
    body { background-image: radial-gradient(#111 0.8px, transparent 0.9px); background-size: 7px 7px; }
    .panel { background:#fff; border: 4px solid #111; box-shadow: 8px 8px 0 #111; position:relative; }
    .caption { background:#fff3b0; border: 3px solid #111; padding: .3rem .6rem; font-size:1.05rem; display:inline-block; transform: rotate(-1deg); }
    .bubble { background:#fff; border:3px solid #111; border-radius: 1.5rem; padding:.8rem 1rem; position:relative; font-size:1.1rem; }
    .bubble::after { content:""; position:absolute; left:28px; bottom:-16px; border: 10px solid transparent; border-top-color:#111; }
    .sfx { font-family: var(--font-bangers); color: var(--v-accent); font-size: clamp(2rem,6vw,4.5rem); -webkit-text-stroke: 2px #111; transform: rotate(-8deg); display:inline-block; text-shadow: 4px 4px 0 #111; }
    h1,h2 { font-family: var(--font-bangers); letter-spacing:.02em; }
  </style>
  <main class="max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-24">
    <header class="panel p-6 sm:p-10 grid gap-6 md:grid-cols-[auto_1fr] items-center">
      <Image src={portrait} alt={`Portrait of ${me.name}`} width={360} height={360} class="w-44 sm:w-56 border-4 border-[#111] object-cover" style="filter: contrast(1.2) saturate(1.3)" />
      <div><p class="caption">Issue #1 · Bengaluru, 2024</p><h1 class="mt-3 text-[clamp(2.8rem,8vw,7rem)] leading-[0.9] text-[#ff2e63]" style="-webkit-text-stroke: 2px #111">The Great Migration</h1><p class="mt-3 text-2xl">Starring {me.name}, {me.role}. A true story about $24,000, a deadline, and AWS Glue.</p></div>
    </header>

    <section class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {migration.map((m, i) => <article class="panel p-6 min-h-[18rem] flex flex-col" style={`transform: rotate(${(i % 2 ? 1 : -1) * 0.6}deg)`}><p class="caption self-start">Panel {i + 1} · {m.t}</p><p class="bubble mt-5">{m.s}</p><p class="sfx mt-auto self-end">{sfx[i]}</p></article>)}
      <article class="panel p-6 bg-[#ff2e63] text-white flex flex-col justify-center"><p class="text-5xl" style="font-family:var(--font-bangers)">THE END?</p><p class="text-xl mt-2">No. The platform still runs. 1.25M people a month use it. Turn the page.</p></article>
    </section>

    <section class="mt-14 grid gap-5 sm:grid-cols-4">{numbers.map((n) => <div class="panel p-5"><p class="text-5xl" style="font-family:var(--font-bangers)">{n.v}</p><p class="text-lg font-bold">{n.k}</p><p class="text-sm">{n.d}</p></div>)}</section>
    <section class="mt-14"><h2 class="text-5xl">Back issues</h2><ul class="mt-5 grid gap-5 md:grid-cols-3">{work.map((w) => <li class="panel p-5"><p class="caption">{w.kind} · {w.year}</p><p class="text-2xl font-bold mt-3" style="font-family:var(--font-bangers)">{w.title}</p><p class="mt-1 text-lg">{w.out}</p></li>)}</ul></section>
    <section class="mt-14 grid gap-6 md:grid-cols-2">{voices.slice(0, 2).map((v) => <div class="bubble text-xl">“{v.q}”<footer class="mt-2 text-sm font-bold">— {v.n}, {v.t}</footer></div>)}</section>
    <footer class="mt-16 panel p-8 text-center"><p class="text-4xl" style="font-family:var(--font-bangers)">Next issue needs a publisher.</p><a href={`mailto:${me.email}`} class="mt-4 inline-block bg-[#111] text-white px-6 py-3 text-xl">{me.email}</a></footer>
  </main>
</Shell>
