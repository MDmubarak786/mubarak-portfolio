---
import Shell from "../../layouts/StoryShell.astro";
import { me, numbers, voices, work } from "../../lib/story";
const rooms = [
  { id: "cdn", x: 150, y: 60, w: 300, h: 50, c: "#9ad1d4", label: "CDN · 1.25M monthly users arrive here", story: "Edge-cached Next.js pages for 23+ language markets." },
  { id: "site", x: 120, y: 120, w: 360, h: 90, c: "#f6bd60", label: "Next.js site · 23 language rooms", story: "The primary digital presence of EF Academy. One engineer kept it running and evolving for two years." },
  { id: "cms", x: 120, y: 220, w: 170, h: 80, c: "#84a98c", label: "Storyblok · translation workflow", story: "Content teams run localisation projects without engineering." },
  { id: "sf", x: 310, y: 220, w: 170, h: 80, c: "#f28482", label: "Salesforce · Prospect Uploader", story: "Lambda + EventBridge validate 10k+ leads per upload in every language." },
  { id: "glue", x: 120, y: 310, w: 360, h: 70, c: "#577590", label: "AWS Glue · the new integration layer", story: "Replaced Tibco Scribe before the licence ended. $24k → $840 a year." },
];
---
<Shell title="4 · Platform Cutaway" fonts={["--font-figtree"]} n={4}>
  <style is:global>
    :root { --v-bg:#1f6f8b; --v-fg:#0d1b2a; --v-accent:#f6bd60; --v-font-text: var(--font-figtree); --v-font-display: var(--font-figtree); }
    .paper { background:#fbf7ef; border-radius: 1.25rem; box-shadow: 0 30px 60px -30px rgba(0,0,0,.6); }
    .room { transition: transform .25s, filter .25s; cursor:pointer; transform-origin:center; }
    .room:hover, .room.is-on { filter: brightness(1.08) drop-shadow(0 8px 10px rgba(0,0,0,.25)); transform: translateY(-4px); }
    .callout { font-size: 11px; font-weight: 700; }
  </style>
  <main class="max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-24 text-white">
    <header class="grid gap-6 lg:grid-cols-[1fr_1fr] items-end">
      <div><p class="text-sm font-bold tracking-widest uppercase text-[#f6bd60]">Section drawing · EF Academy platform</p><h1 class="mt-3 text-[clamp(2.4rem,6vw,5rem)] font-extrabold leading-[0.98]">Fourteen systems, and I know what runs in each of them.</h1></div>
      <p class="text-lg text-white/85 max-w-md">{me.intro} Point at a room in the drawing.</p>
    </header>

    <section class="mt-10 grid gap-6 lg:grid-cols-[1.3fr_1fr]">
      <svg viewBox="0 0 600 420" class="w-full h-auto" role="img" aria-label="Isometric cutaway of the platform">
        <g transform="skewY(-12) translate(0 70)">
          <rect x="100" y="40" width="400" height="360" fill="#e9e2d2" stroke="#0d1b2a" stroke-width="3" />
          {rooms.map((r) => <g class="room" data-room={r.id}><rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.c} stroke="#0d1b2a" stroke-width="2.5" rx="4" /><text x={r.x + 10} y={r.y + 26} font-size="14" font-weight="800" fill="#0d1b2a">{r.label.split(" · ")[0]}</text><text x={r.x + 10} y={r.y + 44} font-size="11" fill="#0d1b2a">{r.label.split(" · ")[1]}</text></g>)}
          <rect x="100" y="400" width="400" height="14" fill="#0d1b2a" />
        </g>
        <g class="callout" fill="#fbf7ef"><line x1="520" y1="60" x2="585" y2="40" stroke="#fbf7ef" stroke-width="1.5" /><text x="588" y="44" text-anchor="start">roof: AWS</text><line x1="90" y1="330" x2="20" y2="360" stroke="#fbf7ef" stroke-width="1.5" /><text x="18" y="376">foundation: TypeScript</text></g>
      </svg>
      <div class="paper p-7 text-[#0d1b2a]" data-panel>
        <p class="text-xs font-bold uppercase tracking-widest text-[#577590]">Room</p>
        <h2 class="text-2xl font-extrabold mt-1" data-panel-title>Next.js site · 23 language rooms</h2>
        <p class="mt-3" data-panel-body>The primary digital presence of EF Academy. One engineer kept it running and evolving for two years.</p>
        <ul class="mt-6 border-t border-[#0d1b2a]/15 pt-4 space-y-2 text-sm">{rooms.map((r) => <li><button type="button" class="text-left hover:underline font-semibold" data-pick={r.id}>{r.label}</button></li>)}</ul>
      </div>
    </section>

    <section class="mt-14 grid gap-4 sm:grid-cols-4">{numbers.map((n) => <div class="paper p-6 text-[#0d1b2a]"><p class="text-4xl font-extrabold">{n.v}</p><p class="font-bold">{n.k}</p><p class="text-sm opacity-70">{n.d}</p></div>)}</section>
    <section class="mt-14 grid gap-4 md:grid-cols-3">{work.map((w) => <article class="paper p-6 text-[#0d1b2a]"><p class="text-xs font-bold uppercase text-[#577590]">{w.kind} · {w.year}</p><h3 class="text-xl font-extrabold mt-1">{w.title}</h3><p class="mt-2 text-sm">{w.body}</p></article>)}</section>
    <section class="mt-14 grid gap-6 md:grid-cols-2">{voices.slice(0, 2).map((v) => <blockquote class="border-l-4 border-[#f6bd60] pl-5"><p class="text-xl font-semibold">“{v.q}”</p><footer class="mt-2 text-sm text-white/70">{v.n}, {v.t}</footer></blockquote>)}</section>
    <footer class="mt-16 paper p-8 text-[#0d1b2a] flex flex-wrap items-center justify-between gap-4"><p class="text-2xl font-extrabold">Write to me about dates.</p><a href={`mailto:${me.email}`} class="bg-[#0d1b2a] text-white px-6 py-3 rounded-full font-bold">{me.email}</a></footer>
  </main>
  <script define:vars={{ rooms }}>
    const title = document.querySelector("[data-panel-title]"), body = document.querySelector("[data-panel-body]");
    const show = (id) => { const r = rooms.find((x) => x.id === id); if (!r) return; title.textContent = r.label; body.textContent = r.story; document.querySelectorAll("[data-room]").forEach((g) => g.classList.toggle("is-on", g.dataset.room === id)); };
    document.querySelectorAll("[data-room]").forEach((g) => { g.addEventListener("pointerenter", () => show(g.dataset.room)); g.addEventListener("click", () => show(g.dataset.room)); });
    document.querySelectorAll("[data-pick]").forEach((b) => b.addEventListener("click", () => show(b.dataset.pick)));
  </script>
</Shell>
