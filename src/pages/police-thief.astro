---
import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";
import { site } from "../lib/site";
const scene = "https://prod.spline.design/OYEbvRLyo9dWqScq/scene.splinecode";
---
<Base title={`Whac-a-Thief, a mini game – ${site.name}`} description="Tap the burglars, spare the cops. A mini game built in Spline.">
  <main id="main" class="min-h-dvh flex flex-col">
    <header class="px-4 py-3 sm:px-6 flex items-center justify-between gap-4 border-b border-line bg-bg">
      <a href="/" class="inline-flex items-center gap-1.5 rounded-full border border-line-strong px-3 py-1.5 text-sm hover:bg-fg hover:text-bg transition"><Icon name="lucide:arrow-left" size={14} aria-hidden="true" /> Back to the records</a>
      <h1 class="text-lg">Whac-a-Thief</h1>
    </header>
    <section class="flex-1 grid place-items-center px-4 py-8" data-game>
      <div class="max-w-[52ch] text-center space-y-4" data-game-intro>
        <p>Tap the burglars to add points. Hit a cop and you lose score. It works best on a desktop or in landscape.</p>
        <p class="text-sm text-muted">The game is a 3D scene built in Spline. It loads only when you start it.</p>
        <button type="button" class="inline-flex items-center gap-2 rounded-full bg-accent text-white px-6 py-3 font-medium" data-game-start><Icon name="lucide:play" size={16} aria-hidden="true" /> Start the game</button>
        <p class="text-sm text-muted hidden" data-game-loading>Loading the scene…</p>
      </div>
      <div class="w-full h-[min(80dvh,56.25vw)] hidden" data-game-stage></div>
    </section>
  </main>
  <script define:vars={{ scene }}>
    const start = document.querySelector("[data-game-start]");
    const intro = document.querySelector("[data-game-intro]");
    const stage = document.querySelector("[data-game-stage]");
    const loading = document.querySelector("[data-game-loading]");
    start?.addEventListener("click", async () => {
      start.setAttribute("aria-disabled", "true");
      loading?.classList.remove("hidden");
      if (!customElements.get("spline-viewer")) {
        await new Promise((resolve, reject) => {
          const s = document.createElement("script");
          s.type = "module";
          s.src = "https://unpkg.com/@splinetool/viewer@1.9.82/build/spline-viewer.js";
          s.onload = resolve; s.onerror = reject;
          document.head.appendChild(s);
        }).catch(() => { if (loading) loading.textContent = "The scene could not be loaded. Check your connection and try again."; });
      }
      const viewer = document.createElement("spline-viewer");
      viewer.setAttribute("url", scene);
      viewer.style.width = "100%"; viewer.style.height = "100%";
      stage?.appendChild(viewer);
      intro?.classList.add("hidden");
      stage?.classList.remove("hidden");
    });
  </script>
</Base>
