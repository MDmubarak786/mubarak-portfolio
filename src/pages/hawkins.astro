---
import { Image } from "astro:assets";
import { getCollection, getEntries } from "astro:content";
import FinalShell from "../layouts/FinalShell.astro";
import Calendar from "../components/final/Calendar.astro";
import Pronounce from "../components/final/Pronounce.astro";
import ResumeDialog from "../components/final/ResumeDialog.astro";
import ComicArt from "../components/final/ComicArt.astro";
import portrait from "../assets/portrait.jpg";
import avatar from "../assets/avatar.jpg";
import resumePage from "../assets/resume-p1.png";
import { site, mailto } from "../lib/site";
import { me, numbers, migration, skillGroups } from "../lib/story";

const records = (await getCollection("records")).sort((a, b) => a.data.order - b.data.order);
const witnesses = (await getCollection("witnesses")).sort((a, b) => a.data.order - b.data.order);
const recordWitnesses = await Promise.all(records.map((r) => getEntries(r.data.reviewedBy)));
const roles = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const fmt = (ym: string | null) => ym ? new Date(ym + "-01T00:00:00Z").toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" }) : "Present";
const ytId = (u: string) => (u.match(/[?&]v=([\w-]+)/) ?? u.match(/youtu\.be\/([\w-]+)/))?.[1];

const episodes = [
  { n: "One", t: "The Vanishing of $24,000", id: "ep1" },
  { n: "Two", t: "The Lab Files", id: "ep2" },
  { n: "Three", t: "The Nine Statements", id: "ep3" },
  { n: "Four", t: "Previously On", id: "ep4" },
];
const extras = [
  { t: "Dossier", id: "resume" },
  { t: "Inventory", id: "inventory" },
  { t: "Tapes", id: "tapes" },
  { t: "Contact", id: "contact" },
];
const timecodes = ["00:00:24", "00:04:12", "00:11:40", "00:19:05", "00:24:00"];
const walkie = ["Do you copy?", "Copy.", "Roger that.", "Over.", "Over and out."];
const seasons = ["Season 4", "Season 3", "Season 2", "Season 1"];
const promos = ["Now streaming", "Promoted from SDE 1 · 3 years 8 months", "Promoted to SDE 2 within five months", "Promoted to SDE 1 within a year"];
const channels = [["Email", site.email, mailto("A role")], ["WhatsApp", site.phoneDisplay, site.whatsapp], ["Call", site.phoneDisplay, `tel:${site.phoneE164}`], ["LinkedIn", "mohammed-mubarak", site.linkedin], ["GitHub", "MDmubarak786", site.github], ["X", "@MMubarakoo7", site.x], ["Instagram", "@scooby_doo.mk", site.instagram], ["YouTube", "@mohammedmubarak1478", site.youtube]];
const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const bulbs = ["#ff2d55", "#ffd23f", "#3ddc97", "#4cc9f0"];
const year = new Date().getFullYear();
---
<FinalShell title="Mubarak Shajahan – Stranger Stacks" description="A Hawkins-style season of one engineer's career: episodes, lab files, nine witness statements, and an alphabet wall that spells the ask." fonts={["--font-rozha", "--font-franklin", "--font-elite", "--font-tamil"]} current="hawkins" theme="#06050a">
  <style is:global>
    html { --v-bg:#06050a; --v-fg:#f3efe6; --v-accent:#ff1e2d; --v-font-text: var(--font-franklin); --v-font-display: var(--font-rozha); --curtain:#06050a; }
    body { font-size:1.05rem; line-height:1.55; background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(255,30,45,.16), transparent 60%), #06050a; }
    :root { --red:#ff1e2d; --red-deep:#9e0b19; --ink:#f3efe6; --muted:#a9a1b1; --line:rgba(243,239,230,.14); --surface:#0d0b14; --paper:#e9dcb5; --paper-ink:#1a1410; }
    ::selection { background:#ff1e2d; color:#fff; }
    [lang="ta"] { font-family: var(--font-tamil); }
    h1, h2, h3 { font-family: var(--font-rozha); font-weight:400; letter-spacing:.02em; }
    .type { font-family: var(--font-elite); letter-spacing:.08em; text-transform:uppercase; font-size:.82rem; color: var(--muted); }
    .glow { color: var(--red); text-shadow: 0 0 6px rgba(255,30,45,.55), 0 0 22px rgba(255,30,45,.35); }
    .outline { color: transparent; -webkit-text-stroke: 2px var(--red); text-shadow: 0 0 14px rgba(255,30,45,.5), 0 0 48px rgba(255,30,45,.28); }
    .lede { max-width:60ch; color:#d8d2dc; }
    .card { background: var(--surface); border:1px solid var(--line); box-shadow: 0 24px 50px -20px rgba(0,0,0,.8), 0 0 0 1px rgba(255,30,45,.05) inset; position:relative; }
    .paper { background: var(--paper); color: var(--paper-ink); background-image: repeating-linear-gradient(0deg, rgba(26,20,16,.035) 0 1px, transparent 1px 28px); box-shadow: 0 24px 50px -20px rgba(0,0,0,.9); position:relative; }
    .paper .type { color:#6b5f52; }
    .stamp { display:inline-block; border:3px solid #c1121f; color:#c1121f; font-family: var(--font-elite); text-transform:uppercase; letter-spacing:.2em; font-size:.8rem; padding:.2rem .6rem; transform: rotate(-6deg); mix-blend-mode: multiply; opacity:.85; }
    .btn { display:inline-block; font-family: var(--font-elite); text-transform:uppercase; letter-spacing:.14em; font-size:.9rem; padding:.65rem 1.25rem; border:2px solid rgba(255,30,45,.75); color:#ffd7d9; background: rgba(255,30,45,.05); transition: box-shadow .2s, background .2s, transform .2s, border-color .2s; text-align:center; }
    .btn:hover { border-color: var(--red); box-shadow: 0 0 20px rgba(255,30,45,.5), inset 0 0 16px rgba(255,30,45,.15); transform: translateY(-1px); }
    .btn.primary { background: var(--red); border-color: var(--red); color:#fff; box-shadow: 0 0 16px rgba(255,30,45,.45), 0 10px 24px -12px rgba(255,30,45,.8); }
    .btn.primary:hover { background:#ff3b48; box-shadow: 0 0 26px rgba(255,30,45,.7), 0 12px 28px -12px rgba(255,30,45,.9); }
    .btn.sm { font-size:.78rem; padding:.45rem .9rem; }
    .btn:focus-visible, .menu-btn:focus-visible, .skip:focus-visible, header a:focus-visible, .tape:focus-visible, .sheet:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .skip { position:absolute; left:1.25rem; top:-6rem; z-index:60; } .skip:focus { top:1rem; }
    /* overlays */
    .vhs { position:fixed; inset:0; pointer-events:none; z-index:30; background: repeating-linear-gradient(0deg, rgba(0,0,0,.18) 0 1px, transparent 1px 3px); mix-blend-mode: multiply; opacity:.32; }
    .vignette { position:fixed; inset:0; pointer-events:none; z-index:29; background: radial-gradient(ellipse 70% 60% at 50% 50%, transparent 55%, rgba(0,0,0,.55) 100%); }
    .spores { position:fixed; inset:0; width:100%; height:100%; pointer-events:none; z-index:1; opacity:.7; }
    /* lights */
    .lights { display:flex; justify-content:space-between; list-style:none; margin:0; padding:0 .5rem; border-top:2px solid #332c3a; }
    .lights li { width:12px; height:20px; margin-top:-2px; border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%; background: var(--bulb); box-shadow: 0 0 8px var(--bulb), 0 0 18px var(--bulb); position:relative; animation: blink 4s ease-in-out infinite; animation-delay: var(--d); }
    .lights li::before { content:""; position:absolute; left:3px; right:3px; top:-6px; height:7px; background:#2a2430; border-radius:2px 2px 0 0; }
    @keyframes blink { 0%, 100% { opacity:1 } 50% { opacity:.45 } }
    /* header */
    .masthead { font-family: var(--font-rozha); font-size:1.3rem; letter-spacing:.08em; color: var(--red); text-shadow: 0 0 10px rgba(255,30,45,.55); white-space:nowrap; }
    .masthead:hover { color:#ff4c57; }
    .navlink { font-family: var(--font-elite); text-transform:uppercase; letter-spacing:.1em; font-size:.82rem; color:#cfc7d3; text-underline-offset:6px; text-decoration-thickness:2px; }
    .navlink:hover { color:#fff; text-decoration-line: underline; }
    .navlink[aria-current="true"] { color:#fff; text-decoration-line: underline; text-decoration-color: var(--red); }
    .menu { position:relative; }
    .menu-btn { display:inline-flex; align-items:center; gap:.5rem; font-family: var(--font-elite); text-transform:uppercase; letter-spacing:.12em; font-size:.82rem; padding:.45rem .9rem; border:1px solid var(--line); background: rgba(13,11,20,.8); color:#fff; white-space:nowrap; cursor:pointer; list-style:none; transition: border-color .2s, box-shadow .2s; }
    .menu-btn::-webkit-details-marker { display:none; }
    .menu-btn:hover, .menu[open] .menu-btn { border-color: var(--red); box-shadow: 0 0 12px rgba(255,30,45,.35); }
    .menu-btn svg { transition: transform .2s; } .menu[open] .menu-btn svg { transform: rotate(180deg); }
    .menu-list { position:absolute; left:0; top: calc(100% + 10px); min-width:19rem; background:#0d0b14; border:1px solid var(--line); box-shadow: 0 30px 60px -20px rgba(0,0,0,.9), 0 0 0 1px rgba(255,30,45,.08); padding:.5rem; z-index:50; display:grid; gap:.1rem; }
    @media (max-width: 639px) { .menu-list { position:fixed; left:1rem; right:1rem; top:4.6rem; min-width:0; } }
    .menu-extra { display:contents; } @media (min-width: 1024px) { .menu-extra { display:none; } }
    .menu-cap { font-family: var(--font-elite); font-size:.72rem; letter-spacing:.2em; text-transform:uppercase; color: var(--muted); padding:.35rem .6rem .25rem; }
    .menu-item { display:flex; align-items:center; gap:.8rem; padding:.5rem .65rem; border:1px solid transparent; color:#e8e2ea; font-size:1rem; line-height:1.2; }
    .menu-item:hover, .menu-item:focus-visible { border-color: var(--line); background: rgba(255,30,45,.08); outline:none; color:#fff; }
    .menu-item[aria-current="true"] { background: rgba(255,30,45,.14); border-color: rgba(255,30,45,.5); color:#fff; }
    .menu-item[aria-current="true"]::after { content:"you are here"; margin-left:auto; padding-left:1rem; font-family: var(--font-elite); font-size:.7rem; letter-spacing:.14em; text-transform:uppercase; color: var(--red); }
    .menu-no { font-family: var(--font-rozha); color: var(--red); font-size:1.05rem; min-width:3.4rem; text-shadow: 0 0 10px rgba(255,30,45,.5); }
    @media (max-width: 639px) { .masthead { font-size:.95rem; letter-spacing:.05em; } .menu-btn { font-size:.72rem; padding:.4rem .6rem; letter-spacing:.08em; } header .btn.sm { font-size:.7rem; padding:.42rem .6rem; letter-spacing:.1em; } }
    .reels .type { white-space:nowrap; }
    .progress { position:absolute; left:0; right:0; bottom:-2px; height:2px; pointer-events:none; }
    .progress span { display:block; height:100%; background: var(--red); box-shadow: 0 0 8px var(--red); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
    /* cover */
    .title { font-size: clamp(2.6rem, 10.5vw, 9.5rem); line-height:.95; letter-spacing:.04em; text-align:center; }
    .polaroid { background:#f6f1e4; padding:.75rem .75rem 2.6rem; color:#2a2320; box-shadow: 0 30px 60px -20px rgba(0,0,0,.9), 0 0 0 1px rgba(0,0,0,.2); position:relative; }
    .polaroid .hand { position:absolute; left:0; right:0; bottom:.7rem; text-align:center; font-family: var(--font-elite); font-size:.9rem; letter-spacing:.06em; color:#3a312c; }
    .pron { font-family: var(--font-elite); font-size:.85rem; letter-spacing:.04em; border:1px solid var(--line); padding:.15rem .55rem; color:#e8e2ea; background: rgba(255,255,255,.04); display:inline-flex; align-items:center; gap:.4rem; vertical-align:middle; white-space:nowrap; }
    .pron:hover { border-color: var(--red); }
    /* episodes */
    .ep { display:block; font-family: var(--font-elite); font-size: clamp(.8rem, 1.4vw, .95rem); letter-spacing:.3em; text-transform:uppercase; color: var(--red); text-shadow: 0 0 10px rgba(255,30,45,.5); margin-bottom:.6rem; }
    .h2 { font-size: clamp(2rem, 5vw, 3.6rem); line-height:1.05; color: var(--ink); }
    .scene { padding:1.5rem; }
    .scene::before { content:""; position:absolute; inset:8px; border:1px solid rgba(243,239,230,.18); pointer-events:none; }
    .rec { display:inline-flex; align-items:center; gap:.45rem; font-family: var(--font-elite); font-size:.78rem; letter-spacing:.14em; color:#f3efe6; }
    .rec::before { content:""; width:9px; height:9px; border-radius:50%; background: var(--red); box-shadow: 0 0 8px var(--red); animation: blink 1.6s steps(2, start) infinite; }
    .narr { font-size:1.1rem; line-height:1.5; color:#e8e2ea; }
    .walkie { font-family: var(--font-elite); letter-spacing:.16em; text-transform:uppercase; font-size:.85rem; color: var(--red); text-shadow: 0 0 10px rgba(255,30,45,.5); }
    .walkie::before { content:""; display:inline-block; width:0; height:0; border-style:solid; border-width:5px 0 5px 7px; border-color: transparent transparent transparent var(--red); margin-right:.5rem; vertical-align:middle; filter: drop-shadow(0 0 4px rgba(255,30,45,.8)); }
    .scene-t { font-family: var(--font-rozha); font-size:1.35rem; line-height:1.15; color:#fff; }
    .radio { border:1px solid var(--line); background: rgba(255,255,255,.03); padding:.9rem 1.1rem; position:relative; color:#e8e2ea; }
    .radio::before { content:""; position:absolute; left:-1px; top:12px; bottom:12px; width:3px; background: var(--red); box-shadow: 0 0 8px var(--red); }
    /* lab files */
    .file { padding:1.5rem; margin-top:14px; }
    .folder-tab { position:absolute; top:-15px; left:14px; height:15px; line-height:15px; background: var(--paper); color:#6b5f52; font-family: var(--font-elite); font-size:.7rem; letter-spacing:.16em; text-transform:uppercase; padding:0 .8rem; border-radius:5px 5px 0 0; }
    .folder-tab::after { content:""; position:absolute; right:-10px; bottom:0; width:0; height:0; border-style:solid; border-width:0 0 15px 10px; border-color: transparent transparent var(--paper) transparent; }
    .file summary { list-style:none; cursor:pointer; } .file summary::-webkit-details-marker { display:none; }
    .file .close-cta, .file details[open] .open-cta { display:none; } .file details[open] .close-cta { display:inline-block; }
    .paper .btn { border-color:#1a1410; color:#1a1410; background: transparent; box-shadow:none; }
    .paper .btn:hover { background:#1a1410; color:#e9dcb5; transform:none; }
    .cell { border:1px solid rgba(26,20,16,.35); padding:.7rem .8rem; }
    .tag { display:inline-block; border:1px solid currentColor; padding:.08rem .5rem; font-family: var(--font-elite); font-size:.75rem; letter-spacing:.08em; text-transform:uppercase; }
    .emph { background: rgba(255,30,45,.18); box-shadow: 0 0 0 2px rgba(255,30,45,.18); color:#fff; font-weight:500; }
    .paper .emph { background:#f2c94c; box-shadow: 0 0 0 2px #f2c94c; color:#1a1410; }
    /* seasons */
    .seasons { position:relative; padding-left:2.2rem; }
    .seasons::before { content:""; position:absolute; left:.6rem; top:.5rem; bottom:.5rem; width:2px; background: var(--red); box-shadow: 0 0 10px var(--red); }
    .season { position:relative; }
    .season::before { content:""; position:absolute; left:-2.2rem; top:1.35rem; width:14px; height:14px; margin-left:.6rem; transform: translateX(-6px); border-radius:50%; background:#06050a; border:2px solid var(--red); box-shadow: 0 0 10px var(--red); }
    /* resume sheet */
    .sheet { display:block; position:relative; text-align:left; cursor:pointer; background:#fff; border:1px solid rgba(0,0,0,.4); box-shadow: 0 30px 60px -20px rgba(0,0,0,.9); transition: transform .2s, box-shadow .2s; }
    .sheet:hover { transform: translateY(-4px); box-shadow: 0 40px 70px -20px rgba(0,0,0,.95), 0 0 30px rgba(255,30,45,.25); }
    .sheet .stamp { position:absolute; right:1rem; top:1rem; font-size:1rem; padding:.3rem .8rem; }
    /* tapes */
    .tape { display:block; background:#141218; border:1px solid var(--line); padding:.6rem .6rem .9rem; box-shadow: 0 20px 40px -18px rgba(0,0,0,.9); transition: transform .2s, box-shadow .2s; }
    .tape:hover { transform: translateY(-4px); box-shadow: 0 30px 50px -18px rgba(0,0,0,.95), 0 0 24px rgba(255,30,45,.2); }
    .tape .label { background:#f6f1e4; color:#2a2320; padding:.45rem .6rem; font-family: var(--font-elite); font-size:.8rem; letter-spacing:.04em; line-height:1.25; border-top:3px solid var(--red); }
    .reels { display:flex; justify-content:space-between; padding:.35rem .4rem 0; }
    .reels span { width:16px; height:16px; border-radius:50%; border:3px solid #3a3340; background:#06050a; }
    .play { position:absolute; inset:0; display:grid; place-items:center; opacity:0; background: rgba(6,5,10,.55); transition: opacity .2s; }
    .tape:hover .play, .tape:focus-visible .play { opacity:1; }
    /* wall */
    .wall { display:grid; grid-template-columns: repeat(7, 1fr); gap:.6rem .4rem; list-style:none; padding:0; margin:0; }
    @media (min-width: 640px) { .wall { grid-template-columns: repeat(9, 1fr); gap:.9rem .5rem; } }
    .wall li { display:grid; justify-items:center; gap:.35rem; }
    .wall .bulb { width:10px; height:16px; border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%; background:#2a2430; transition: background .15s, box-shadow .15s; }
    .wall .ltr { font-family: var(--font-rozha); font-size: clamp(1.4rem, 4.5vw, 2.6rem); line-height:1; color:#8a8291; transition: color .15s, text-shadow .15s; }
    .wall li.on .bulb { background: var(--bulb); box-shadow: 0 0 10px var(--bulb), 0 0 22px var(--bulb); }
    .wall li.on .ltr { color:#fff; text-shadow: 0 0 12px var(--bulb); }
    @media (prefers-reduced-motion: reduce) { .vhs, .spores { display:none; } }
  </style>

  <div class="vignette" aria-hidden="true"></div>
  <div class="vhs" aria-hidden="true"></div>
  <canvas class="spores" aria-hidden="true" data-spores></canvas>

  <a href="#main" class="skip btn sm">Skip to the episodes</a>
  <header class="sticky top-0 z-40 bg-[#06050a]/85 backdrop-blur border-b border-[rgba(243,239,230,.14)] relative">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-3 flex items-center justify-between gap-3 sm:gap-6">
      <a href="#main" class="masthead shrink-0">STRANGER STACKS</a>
      <nav class="flex items-center gap-3 lg:gap-5" aria-label="Sections">
        <details class="menu" data-chapter-menu>
          <summary class="menu-btn" aria-label="Jump to an episode"><span data-chapter-label>Episodes</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <div class="menu-list">
            <p class="menu-cap">Season 2026</p>
            {episodes.map((e) => <a href={`#${e.id}`} data-label={`Chapter ${e.n}`} class="menu-item"><span class="menu-no">Ch. {e.n}</span><span>{e.t}</span></a>)}
            <div class="menu-extra">
              <p class="menu-cap mt-2">Also inside</p>
              {extras.map((e) => <a href={`#${e.id}`} data-label={e.t} class="menu-item pl-3">{e.t}</a>)}
            </div>
          </div>
        </details>
        {extras.map((e) => <a href={`#${e.id}`} data-label={e.t} class="navlink hidden lg:inline">{e.t}</a>)}
      </nav>
      <a href={mailto("A role")} class="btn primary sm shrink-0">Hire me</a>
    </div>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
  </header>
  <script>
    const menu = document.querySelector<HTMLDetailsElement>("[data-chapter-menu]");
    const label = menu?.querySelector<HTMLElement>("[data-chapter-label]");
    const items = [...document.querySelectorAll<HTMLAnchorElement>('header nav a[href^="#"]')];
    const targets = items.map((a) => ({ a, el: document.querySelector<HTMLElement>(a.getAttribute("href")!) })).filter((t) => t.el);
    const bar = document.querySelector<HTMLElement>("[data-progress]");
    const close = () => menu?.removeAttribute("open");
    items.forEach((a) => a.addEventListener("click", close));
    document.addEventListener("click", (e) => { if (menu?.open && !menu.contains(e.target as Node)) close(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu?.open) { close(); menu.querySelector<HTMLElement>("summary")?.focus(); } });
    let queued = false;
    const update = () => {
      queued = false;
      const y = scrollY + 140;
      let current: (typeof targets)[number] | undefined;
      for (const t of targets) if (t.el!.offsetTop <= y) current = t;
      items.forEach((a) => a.removeAttribute("aria-current"));
      const lbl = current?.a.dataset.label ?? "";
      if (current) items.filter((a) => a.getAttribute("href") === current!.a.getAttribute("href")).forEach((a) => a.setAttribute("aria-current", "true"));
      if (label) label.textContent = lbl.startsWith("Chapter") ? lbl : "Episodes";
      if (bar) { const max = document.documentElement.scrollHeight - innerHeight; bar.style.setProperty("--p", String(max > 0 ? Math.min(1, scrollY / max) : 0)); }
    };
    addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener("resize", update);
    update();
  </script>

  <main id="main" class="relative z-[2] max-w-6xl mx-auto px-5 sm:px-8 pt-6 pb-28">
    <!-- TITLE CARD -->
    <section aria-label="Title card" data-cover>
      <ul class="lights" aria-hidden="true">{Array.from({ length: 18 }).map((_, i) => <li style={`--bulb:${bulbs[i % 4]}; --d:${(i * 0.37) % 4}s`}></li>)}</ul>
      <div class="pt-14 sm:pt-20">
        <h1 class="title outline" data-title>STRANGER<br />STACKS</h1>
        <p class="type text-center mt-6 tracking-[.3em] text-balance">A Chennai production · Season {year} · Starring {site.name}</p>
      </div>
      <div class="mt-14 grid gap-10 md:grid-cols-[auto_1fr] items-center">
        <div class="polaroid w-64 sm:w-72 justify-self-center">
          <Image src={portrait} alt={`Portrait of ${site.name}`} width={520} height={520} widths={[256, 512, 576]} sizes="(min-width: 640px) 288px, 256px" loading="eager" fetchpriority="high" class="w-full aspect-square object-cover" style="filter: contrast(1.08) saturate(.9) sepia(.12)" />
          <span class="hand">Mubarak · Chennai, '{String(year).slice(2)}</span>
        </div>
        <div>
          <p class="text-xl sm:text-2xl leading-snug max-w-[48ch]">Starring <strong class="whitespace-nowrap">{site.name}</strong> <Pronounce class="pron cursor-pointer" />, Senior Software Engineer at Galent. {me.oneLiner}</p>
          <p class="type mt-4">{site.pronouns} · {site.location}</p>
          <div class="mt-7 flex flex-wrap gap-3"><a href={mailto("A role")} class="btn primary">Email me</a><button type="button" class="btn" data-resume-open>Read the resume</button><a href={site.linkedin} rel="noopener" target="_blank" class="btn">LinkedIn</a><a href={site.whatsapp} rel="noopener" target="_blank" class="btn">WhatsApp</a></div>
        </div>
      </div>
    </section>

    <!-- READINGS -->
    <section class="mt-20" aria-labelledby="num-h">
      <h2 id="num-h" class="sr-only">Readings</h2>
      <ul class="grid gap-4 grid-cols-2 lg:grid-cols-4" role="list">
        {numbers.map((n) => (
          <li class="card p-5">
            <p class="glow" style="font-family: var(--font-rozha); font-size: clamp(2.4rem, 4.8vw, 3.4rem); line-height:1">{n.v}</p>
            <p class="mt-2 text-lg font-medium leading-tight">{n.k}</p>
            <p class="mt-1 text-[#a9a1b1] leading-snug text-pretty">{n.d}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- CHAPTER ONE -->
    <section id="ep1" class="mt-24 scroll-mt-24" aria-labelledby="ch1">
      <h2 id="ch1" class="h2"><span class="ep">Chapter One</span>The Vanishing of $24,000</h2>
      <p class="mt-3 text-xl lede">A true story about a licence, a deadline, and AWS Glue. Five scenes, as recorded.</p>
      <ol class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-6 lg:auto-rows-[minmax(15rem,auto)]">
        <li class="card scene lg:col-span-4 grid gap-5 sm:grid-cols-[1fr_auto] items-center">
          <div class="space-y-4"><p class="rec">Scene 1 · {timecodes[0]}</p><h3 class="scene-t">{migration[0].t}</h3><p class="narr max-w-[44ch]">{migration[0].s}</p><p class="walkie">{walkie[0]}</p></div>
          <ComicArt kind="clock" ink="#f3efe6" paper="#0d0b14" font="var(--font-elite)" class="w-44 sm:w-56 lg:w-64 justify-self-center" />
        </li>
        <li class="card scene lg:col-span-2 flex flex-col gap-4">
          <p class="rec">Scene 2 · {timecodes[1]}</p><h3 class="scene-t">{migration[1].t}</h3>
          <ComicArt kind="fork" ink="#f3efe6" paper="#0d0b14" font="var(--font-elite)" class="w-36 self-center" />
          <p class="radio">{migration[1].s}</p>
          <p class="walkie self-end mt-auto">{walkie[1]}</p>
        </li>
        <li class="card scene lg:col-span-2 flex flex-col gap-4">
          <p class="rec">Scene 3 · {timecodes[2]}</p><h3 class="scene-t">{migration[2].t}</h3>
          <div class="flex items-center gap-4"><ComicArt kind="plan" ink="#f3efe6" paper="#0d0b14" font="var(--font-elite)" class="w-28 shrink-0" /><p class="narr">{migration[2].s}</p></div>
          <p class="walkie self-end mt-auto">{walkie[2]}</p>
        </li>
        <li class="card scene lg:col-span-2 flex flex-col gap-4">
          <p class="rec">Scene 4 · {timecodes[3]}</p><h3 class="scene-t">{migration[3].t}</h3>
          <ComicArt kind="switch" ink="#f3efe6" paper="#0d0b14" font="var(--font-elite)" class="w-40 self-center" />
          <p class="narr">{migration[3].s}</p>
          <p class="walkie self-end mt-auto">{walkie[3]}</p>
        </li>
        <li class="card scene lg:col-span-2 flex flex-col gap-4">
          <p class="rec">Scene 5 · {timecodes[4]}</p><h3 class="scene-t">{migration[4].t}</h3>
          <div class="flex items-center gap-4"><ComicArt kind="bill" ink="#f3efe6" paper="#0d0b14" font="var(--font-elite)" class="w-28 shrink-0" /><p class="narr">{migration[4].s}</p></div>
          <p class="radio"><strong class="emph">“Saved us $30,000 annually in licensing fees.”</strong> <cite class="not-italic type"> · <a href="#witness-jason-wheeler" class="underline underline-offset-2">Jason Wheeler</a>, VP of Technology</cite></p>
          <p class="walkie self-end mt-auto">{walkie[4]}</p>
        </li>
      </ol>
    </section>

    <!-- CHAPTER TWO -->
    <section id="ep2" class="mt-24 scroll-mt-24" aria-labelledby="ch2">
      <h2 id="ch2" class="h2"><span class="ep">Chapter Two</span>The Lab Files</h2>
      <p class="mt-3 text-xl lede">Eight files from the archive. Open one for the context, the decision and what it changed.</p>
      <ol class="mt-10 grid gap-8 md:grid-cols-2 items-start">
        {records.map((r, i) => {
          const headline = r.data.consequences.find((c) => c.emphasis)?.value ?? "";
          const ws = recordWitnesses[i];
          return (
            <li class="paper file">
              <span class="folder-tab" aria-hidden="true">File {String(i + 1).padStart(2, "0")}</span>
              <div class="flex items-start justify-between gap-3"><p class="type"><span class="sr-only">File {String(i + 1).padStart(2, "0")} · </span>{r.data.organisation} · {r.data.date}</p><span class="stamp">Declassified</span></div>
              <details class="group">
                <summary>
                  <h3 class="text-2xl sm:text-3xl mt-3 leading-tight">{r.data.index}</h3>
                  <p class="mt-2 text-lg">{r.data.summary}</p>
                  <p class:list={["mt-3", headline.length > 24 ? "font-bold text-lg" : "text-3xl"]} style={headline.length > 24 ? "" : "font-family: var(--font-rozha); color:#c1121f"}>{headline}</p>
                  <span class="btn sm mt-4 open-cta">Open the file</span>
                  <span class="btn sm mt-4 close-cta">Close the file</span>
                </summary>
                <div class="mt-5 border-t border-dashed border-[rgba(26,20,16,.5)] pt-5 space-y-4">
                  <p><strong class="type mr-1">Context.</strong> {r.data.context}</p>
                  <p><strong class="type mr-1">Decision.</strong> {r.data.decision}</p>
                  <ul class="grid grid-cols-2 gap-3">{r.data.consequences.map((c) => <li class="cell"><span class:list={["block", c.value.length > 24 ? "font-bold" : "text-2xl"]} style={c.value.length > 24 ? "" : "font-family: var(--font-rozha)"}>{c.value}</span><span class="type">{c.label}</span></li>)}</ul>
                  {ws.length > 0 && <p class="flex flex-wrap items-center gap-2"><strong class="type">Witnesses:</strong>{ws.map((w) => <a href={`#witness-${w.id}`} class="tag hover:bg-[#1a1410] hover:text-[#e9dcb5]">{w.data.name}</a>)}</p>}
                  <ul class="flex flex-wrap gap-2" aria-label="Tags">{r.data.tags.map((t) => <li class="tag">{t}</li>)}</ul>
                </div>
              </details>
            </li>
          );
        })}
      </ol>
    </section>

    <!-- CHAPTER THREE -->
    <section id="ep3" class="mt-24 scroll-mt-24" aria-labelledby="ch3">
      <h2 id="ch3" class="h2"><span class="ep">Chapter Three</span>The Nine Statements</h2>
      <p class="mt-3 text-xl lede">Every word verbatim, as given. Nothing paraphrased.</p>
      <ul class="mt-8 md:columns-2 md:gap-6">
        {witnesses.map((w, i) => {
          const pull = w.data.pull ?? "";
          const paras = w.data.quote.split(/\n\s*\n/);
          return (
            <li id={`witness-${w.id}`} class="break-inside-avoid mb-6">
              <article class="card p-6">
                <p class="type">Statement {String(i + 1).padStart(2, "0")}/09 · <strong class="text-[#f3efe6]">{w.data.name}</strong> · {w.data.title}{w.data.organisation ? `, ${w.data.organisation}` : ""}</p>
                <blockquote class="mt-4 space-y-3 text-[1.02rem] leading-relaxed text-[#e8e2ea]">
                  {paras.map((para) => { const k = pull && para.includes(pull) ? para.indexOf(pull) : -1; return k < 0 ? <p>{para}</p> : <p>{para.slice(0, k)}<strong class="emph">{pull}</strong>{para.slice(k + pull.length)}</p>; })}
                </blockquote>
              </article>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- CHAPTER FOUR -->
    <section id="ep4" class="mt-24 scroll-mt-24" aria-labelledby="ch4">
      <h2 id="ch4" class="h2"><span class="ep">Chapter Four</span>Previously On</h2>
      <p class="mt-3 text-xl lede">Where I am now, then how I got here. Four seasons, three promotions.</p>
      <ol class="mt-10 seasons grid gap-8">
        {roles.map((r, i) => (
          <li class="season">
            <article class="card p-6 sm:p-8">
              <header class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start">
                <div><p class="type">{seasons[i]} · {fmt(r.data.start)} → {fmt(r.data.end)}</p><h3 class="text-2xl sm:text-3xl mt-1 leading-tight">{r.data.role}</h3><p class="text-[#a9a1b1]">{r.data.company} · {r.data.type}</p></div>
                <p class="walkie sm:text-right">{promos[i]}</p>
              </header>
              <div class:list={["mt-6 grid gap-5", r.data.groups.length > 1 && "lg:grid-cols-2"]}>
                {r.data.groups.map((g) => <div class="radio"><p class="type !text-[#f3efe6]">{g.name}</p><ul class="mt-2 list-disc pl-5 space-y-2 max-w-[62ch] text-[#d8d2dc]">{g.bullets.map((b) => <li>{b}</li>)}</ul></div>)}
              </div>
              <ul class="mt-6 flex flex-wrap gap-2 text-[#cfc7d3]" aria-label="Worked with">{r.data.skills.map((sk) => <li class="tag">{sk}</li>)}</ul>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <!-- DOSSIER -->
    <section id="resume" class="mt-24 scroll-mt-24 paper p-6 sm:p-10 lg:p-12 grid gap-10 lg:grid-cols-[1.15fr_1fr] items-center" aria-labelledby="res-h" data-page="Dossier">
      <div>
        <p class="type">Personnel dossier · 2 pages</p>
        <h2 id="res-h" class="text-4xl sm:text-5xl mt-3 text-balance">The official resume</h2>
        <p class="mt-4 text-xl max-w-[46ch]">{site.yearsExperience} years, the whole stack, every role with its numbers, education and the 2021 award. Read it here or take the PDF home.</p>
        <div class="mt-6 flex flex-wrap gap-3"><button type="button" class="btn" data-resume-open>Read it here</button><a href={site.resume} download={site.resumeName} class="btn">Download PDF</a></div>
        <dl class="mt-8 grid gap-5 sm:grid-cols-2">
          <div class="cell"><dt class="type">Training</dt><dd class="mt-1 leading-snug">{site.education.degree}<br /><span class="text-[#6b5f52]">{site.education.school}</span><br /><span class="text-[#6b5f52]">{site.education.years} · CGPA {site.education.cgpa}</span></dd></div>
          <div class="cell"><dt class="type">Commendation</dt><dd class="mt-1 leading-snug">{site.award.title}<br /><span class="text-[#6b5f52]">{site.award.by}, {site.award.year}</span></dd></div>
        </dl>
      </div>
      <button type="button" class="sheet w-full max-w-sm justify-self-center lg:justify-self-end" data-resume-open aria-label="Open the resume preview">
        <Image src={resumePage} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 384px, 90vw" class="block w-full h-auto" loading="lazy" />
        <span class="stamp" aria-hidden="true">Declassified</span>
      </button>
      <ResumeDialog dialogClass="bg-[#0d0b14] text-[#f3efe6] border border-[rgba(243,239,230,.2)]" btnClass="btn primary sm" btnAltClass="btn sm" closeClass="btn sm" />
    </section>

    <!-- INVENTORY -->
    <section id="inventory" class="mt-24 scroll-mt-24" aria-labelledby="inv-h" data-page="Inventory">
      <h2 id="inv-h" class="h2">The party's inventory</h2>
      <p class="mt-3 text-xl lede">Nine kinds of equipment, collected over {site.yearsExperience} years. The AI and cloud items are the newest.</p>
      <ul class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {skillGroups.map(([group, items], i) => (
          <li class="card p-5">
            <p class="type">Slot {String(i + 1).padStart(2, "0")}</p>
            <h3 class="text-2xl mt-1">{group}</h3>
            <ul class="mt-3 flex flex-wrap gap-2 text-[#cfc7d3]">{items.map((it) => <li class="tag">{it}</li>)}</ul>
          </li>
        ))}
      </ul>
      <div class="card mt-6 p-6"><p class="type">Signals · GitHub, the last twelve months · <a href={site.github} class="underline">@MDmubarak786</a></p><div class="mt-4"><Calendar empty="#15121c" levels={["#5a1620", "#9e0b19", "#d81a2a", "#ff1e2d"]} ink="#f3efe6" showTotal totalClass="mt-3 type" /></div></div>
    </section>

    <!-- TAPES -->
    <section id="tapes" class="mt-24 scroll-mt-24" aria-labelledby="tapes-h" data-page="Tapes">
      <h2 id="tapes-h" class="h2">Season Zero · the 2020 tapes</h2>
      <p class="mt-3 text-xl lede">Eight Flutter apps from the year I was learning mobile. Minor issues, but every one shipped with a demo.</p>
      <ul class="mt-8 grid gap-5 grid-cols-2 lg:grid-cols-4">
        {projects.map((p, i) => {
          const id = p.data.link ? ytId(p.data.link) : undefined;
          return (
            <li>
              <a href={p.data.link} rel="noopener" target="_blank" class="tape group">
                <div class="relative overflow-hidden">
                  {id ? <img src={`https://img.youtube.com/vi/${id}/hqdefault.jpg`} alt={`Demo video of ${p.data.name}`} width="480" height="360" loading="lazy" class="w-full aspect-[4/3] object-cover" style="filter: saturate(.85) contrast(1.05)" /> : <div class="w-full aspect-[4/3] bg-[#2a2430]"></div>}
                  <span class="play"><span class="btn sm">Play tape</span></span>
                </div>
                <div class="reels" aria-hidden="true"><span></span><span class="type !text-[.65rem] !text-[#8a8291] self-center">Tape {i + 1}</span><span></span></div>
                <div class="label mt-2"><strong class="block text-[.95rem]">{p.data.name}</strong>{fmt(p.data.period)} · {p.data.tags[0]}{p.data.description && <span class="block mt-1 text-[#5a4f46] normal-case tracking-normal font-[var(--font-franklin)]">{p.data.description}</span>}</div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- CONTACT · THE WALL -->
    <section id="contact" class="mt-24 scroll-mt-24 card p-6 sm:p-12" aria-labelledby="ch5" data-page="The wall">
      <h2 id="ch5" class="h2 glow">Turn the lights on.</h2>
      <p class="mt-3 text-xl lede">Hiring for a senior or lead role? Spell it out. I read everything.</p>
      <ul class="wall mt-8" data-wall aria-hidden="true">{alphabet.map((l, i) => <li data-letter={l} style={`--bulb:${bulbs[i % 4]}`}><span class="bulb"></span><span class="ltr">{l}</span></li>)}</ul>
      <p class="sr-only">The wall lights up to spell HIRE ME.</p>
      <div class="mt-10 grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-start">
        <div class="flex items-start gap-4 sm:gap-6">
          <Image src={avatar} alt="" width={160} height={160} class="size-20 sm:size-24 rounded-full border border-[rgba(243,239,230,.3)] object-cover shrink-0" loading="lazy" />
          <div class="flex-1 min-w-0">
            <p class="text-xl leading-snug">Write, call, or send a message. Replies come from Chennai, usually the same day.</p>
            <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2"><strong>{site.name}</strong><Pronounce class="pron cursor-pointer" /><span class="type">{site.pronouns} · {site.location}</span></p>
          </div>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:flex-col">
          <a href={mailto("A role")} class="btn primary">Email me</a>
          <a href={site.whatsapp} rel="noopener" target="_blank" class="btn">WhatsApp</a>
          <a href={site.linkedin} rel="noopener" target="_blank" class="btn">LinkedIn</a>
        </div>
      </div>
      <dl class="mt-10 pt-6 border-t border-dashed border-[rgba(243,239,230,.25)] grid gap-x-6 gap-y-4 grid-cols-2 lg:grid-cols-4">
        {channels.map(([l, v, h]) => <div class="min-w-0"><dt class="type">{l}</dt><dd><a href={h} class="underline underline-offset-4 decoration-[rgba(255,30,45,.6)] [overflow-wrap:anywhere]">{v}</a></dd></div>)}
      </dl>
      <p class="mt-8 type">© {year} {site.name} · Filmed in Chennai, with real numbers.</p>
    </section>
  </main>
  <script src="../scripts/hawkins-motion.ts"></script>
  <script src="../scripts/page-curtain.ts"></script>
</FinalShell>
