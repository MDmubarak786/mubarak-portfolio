---
import { Image } from "astro:assets";
import { getCollection, getEntries } from "astro:content";
import FinalShell from "../layouts/FinalShell.astro";
import Calendar from "../components/final/Calendar.astro";
import Pronounce from "../components/final/Pronounce.astro";
import ResumeDialog from "../components/final/ResumeDialog.astro";
import ComicArt from "../components/final/ComicArt.astro";
import ComicLoader from "../components/final/ComicLoader.astro";
import portrait from "../assets/portrait.jpg";
import avatar from "../assets/avatar.jpg";
import resumePage from "../assets/resume-p1.png";
import { site, mailto } from "../lib/site";
import { me, numbers, migration, skillGroups } from "../lib/story";
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmtDay = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
import { experience } from "../lib/site";
const exp = experience();
const careerStartLabel = new Date(site.careerStart + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const records = (await getCollection("records")).sort((a, b) => a.data.order - b.data.order);
const witnesses = (await getCollection("witnesses")).sort((a, b) => a.data.order - b.data.order);
const recordWitnesses = await Promise.all(records.map((r) => getEntries(r.data.reviewedBy)));
const roles = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const fmt = (ym: string | null) => ym ? new Date(ym + "-01T00:00:00Z").toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" }) : "Now";
const sfx = ["TICK", "HMM", "PLAN!", "SWITCH!", "KA-CHING"];
const ytId = (u: string) => (u.match(/[?&]v=([\w-]+)/) ?? u.match(/youtu\.be\/([\w-]+)/))?.[1];
const colors = ["#ff2e63", "#1b998b", "#ffb703", "#3a86ff", "#8338ec"];
// Text colour that reads at 4.5:1 on each fill (ink everywhere except the purple).
const onColor = ["#111", "#111", "#111", "#111", "#fff"];
const chapters = [
  { n: "1", t: "The Great Migration", id: "migration" },
  { n: "2", t: "Case files", id: "cases" },
  { n: "3", t: "Nine witnesses", id: "witnesses" },
  { n: "4", t: "Origin story", id: "origin" },
];
const extras = [
  { t: "Resume", id: "resume" },
  { t: "Power-ups", id: "powers" },
  { t: "Back issues", id: "back-issues" },
  { t: "Contact", id: "contact" },
];
const channels = [["Email", site.email, mailto("A role")], ["WhatsApp", site.phoneDisplay, site.whatsapp], ["Call", site.phoneDisplay, `tel:${site.phoneE164}`], ["LinkedIn", "mohammed-mubarak", site.linkedin], ["GitHub", "MDmubarak786", site.github], ["X", "@MMubarakoo7", site.x], ["Instagram", "@scooby_doo.mk", site.instagram], ["YouTube", "@mohammedmubarak1478", site.youtube]];
---
<FinalShell title={`${site.name} – ${site.role}, ${site.roleAlt}`} description={me.oneLiner} fonts={["--font-bangers", "--font-patrick"]} theme="#fff8e7">
  <ComicLoader />
  <a href="#main" class="skip btn sm">Skip to the comic</a>
  <header class="sticky top-0 z-40 bg-[#fff8e7]/90 backdrop-blur border-b-4 border-[#111]">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-3 flex items-center justify-between gap-3 sm:gap-6">
      <a href="#main" class="bang text-2xl shrink-0 masthead" aria-label="MK Comics, back to the cover"><span class="pow" aria-hidden="true">POW!</span>{"MK".split("").map((l, i) => <span class="ml" style={`--i:${i}`}>{l}</span>)}<span class="ml-gap"></span>{"COMICS".split("").map((l, i) => <span class="ml ml-pink" style={`--i:${i + 2}`}>{l}</span>)}</a>
      <nav class="flex items-center gap-3 lg:gap-5 text-lg" aria-label="Sections">
        <details class="menu" data-chapter-menu>
          <summary class="menu-btn" aria-label="Jump to a chapter"><span data-chapter-label>Chapters</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <div class="menu-list">
            <p class="menu-cap">Chapters</p>
            {chapters.map((c) => <a href={`#${c.id}`} data-label={`Chapter ${c.n}`} class="menu-item"><span class="menu-no">{c.n}</span><span>{c.t}</span></a>)}
            <div class="menu-extra">
              <p class="menu-cap mt-2">Also inside</p>
              {extras.map((e) => <a href={`#${e.id}`} data-label={e.t} class="menu-item pl-3">{e.t}</a>)}
              <a href="/blog" class="menu-item pl-3">Blog · the weekly strip</a>
            </div>
          </div>
        </details>
        {extras.map((e) => <a href={`#${e.id}`} data-label={e.t} class="navlink hidden lg:inline">{e.t}</a>)}
        <a href="/blog" class="navlink hidden lg:inline">Blog</a>
      </nav>
      <a href={mailto("A role")} class="btn sm shrink-0">Hire me</a>
    </div>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
  </header>
  <script>
    const menu = document.querySelector<HTMLDetailsElement>("[data-chapter-menu]");
    const label = menu?.querySelector<HTMLElement>("[data-chapter-label]");
    const items = [...document.querySelectorAll<HTMLAnchorElement>('header nav a[href^="#"]')];
    const targets = items.map((a) => ({ a, el: document.querySelector<HTMLElement>(a.getAttribute("href")!) })).filter((t) => t.el);
    const bar = document.querySelector<HTMLElement>("[data-progress]");
    const close = () => menu?.removeAttribute("open");
    items.forEach((a) => a.addEventListener("click", close));
    document.addEventListener("click", (e) => { if (menu?.open && !menu.contains(e.target as Node)) close(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu?.open) { close(); menu.querySelector<HTMLElement>("summary")?.focus(); } });
    // Section tops are measured once after load and on resize, never inside the scroll handler (no forced reflow).
    let queued = false;
    let tops: number[] = [];
    // Measure the section box (it is laid out even while its content is skipped by content-visibility), not the heading.
    const measure = () => { tops = targets.map((t) => (t.el!.closest("section") ?? t.el!).offsetTop); };
    const update = () => {
      queued = false;
      const y = scrollY + 140;
      let current: (typeof targets)[number] | undefined;
      targets.forEach((t, i) => { if (tops[i] <= y) current = t; });
      items.forEach((a) => a.removeAttribute("aria-current"));
      const lbl = current?.a.dataset.label ?? "";
      if (current) items.filter((a) => a.getAttribute("href") === current!.a.getAttribute("href")).forEach((a) => a.setAttribute("aria-current", "true"));
      if (label) label.textContent = lbl.startsWith("Chapter") ? lbl : "Chapters";
      if (bar) { const max = document.documentElement.scrollHeight - innerHeight; bar.style.setProperty("--p", String(max > 0 ? Math.min(1, scrollY / max) : 0)); }
    };
    addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener("resize", () => { measure(); update(); });
    addEventListener("load", () => requestAnimationFrame(() => { measure(); update(); }), { once: true });
    document.addEventListener("contentvisibilityautostatechange", () => requestAnimationFrame(() => { measure(); update(); }), true);
  </script>

  <main id="main" class="max-w-6xl mx-auto px-5 sm:px-8 pt-10 pb-28">
    <!-- COVER -->
    <section class="panel p-6 sm:p-10 grid gap-8 md:grid-cols-[auto_1fr] items-center" aria-label="Cover" data-cover>
      <div class="relative"><Image src={portrait} alt={`Portrait of ${site.name}`} width={520} height={520} widths={[224, 448, 576]} sizes="(min-width: 640px) 288px, 224px" loading="eager" fetchpriority="high" class="w-56 sm:w-72 border-4 border-[#111] object-cover shadow-[6px_6px_0_#111]" style="filter: contrast(1.15) saturate(1.3)" /><span class="burst absolute -right-8 -top-8 bg-[#ffb703] size-28 grid place-items-center bang text-xl text-center leading-none rotate-12">2026<br />EDITION</span></div>
      <div>
        <p class="caption">Issue #1 · Chennai, India · {site.pronouns}</p>
        <h1 class="mt-4 text-[clamp(3rem,8vw,7rem)] leading-[0.9] text-[#ff2e63]" style="-webkit-text-stroke: 2px #111">The Full-Stack<br />+ AI Chronicles</h1>
        <p class="mt-5 text-xl sm:text-2xl max-w-[48ch]">Starring <strong class="whitespace-nowrap">{site.name}</strong> <Pronounce class="caption cursor-pointer" />, Senior Software Engineer at Galent, <span class="whitespace-nowrap" data-experience title={`Since ${careerStartLabel}`}>{exp.long}</span> into the IT sector. {me.oneLiner}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3"><a href={mailto("A role")} class="btn">Email me ▸</a><button type="button" class="btn alt" data-resume-open>Read the resume ▸</button><a href={site.linkedin} rel="noopener" target="_blank" class="btn alt">LinkedIn ▸</a><a href={site.whatsapp} rel="noopener" target="_blank" class="btn alt">WhatsApp ▸</a></div>
      </div>
    </section>

    <!-- NUMBERS -->
    <section class="mt-10" aria-labelledby="num-h">
      <h2 id="num-h" class="sr-only">By the numbers</h2>
      <ul class="grid gap-4 sm:gap-5 grid-cols-2 lg:grid-cols-4" role="list">
        {numbers.map((n, i) => (
          <li class="panel stat">
            <a href={n.to} class="stat-link p-4 sm:p-5" {...(n.to.startsWith("#") ? { "data-open-file": true } : { target: "_blank", rel: "noopener" })}>
              <p class="stat-v text-4xl sm:text-5xl" style={`color:${colors[i]}`}>{n.v}</p>
              <p class="mt-2 text-lg sm:text-xl font-bold leading-tight">{n.k}</p>
              <p class="mt-1 text-[#555] leading-snug text-pretty">{n.d}</p>
              <span class="stat-cta">{n.cta} ▸</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- CHAPTER 1 -->
    <section id="migration" class="cv mt-16 scroll-mt-24" aria-labelledby="ch1">
      <h2 id="ch1" class="text-5xl sm:text-6xl">Chapter 1 · The Great Migration</h2>
      <p class="mt-2 text-xl lede"><span>A true story about $24,000, a deadline, and AWS Glue. Five panels, in order.</span></p>
      <ol class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-6 lg:auto-rows-[minmax(15rem,auto)]">
        <!-- 1 · wide establishing panel -->
        <li class="panel p-6 lg:col-span-4 grid gap-5 sm:grid-cols-[1fr_auto] items-center">
          <span class="pnum">1</span>
          <div class="space-y-4"><p class="caption">{migration[0].t}</p><p class="narr">{migration[0].s}</p><p class="sfx text-[clamp(2rem,5vw,4rem)]" style={`color:${colors[0]}`}>{sfx[0]}</p></div>
          <ComicArt kind="clock" class="w-40 sm:w-48 lg:w-56 justify-self-center" />
        </li>
        <!-- 2 · the choice, spoken -->
        <li class="panel p-6 lg:col-span-2 flex flex-col gap-4">
          <span class="pnum">2</span>
          <p class="caption self-start">{migration[1].t}</p>
          <ComicArt kind="fork" class="w-36 self-center" />
          <p class="bubble text-base">{migration[1].s}</p>
          <p class="sfx self-end mt-auto text-[clamp(1.8rem,4vw,3rem)]" style={`color:${colors[1]}`}>{sfx[1]}</p>
        </li>
        <!-- 3 · the plan -->
        <li class="panel p-6 lg:col-span-2 flex flex-col gap-4">
          <span class="pnum">3</span>
          <p class="caption self-start">{migration[2].t}</p>
          <div class="flex items-center gap-4"><ComicArt kind="plan" class="w-28 shrink-0" /><p class="narr">{migration[2].s}</p></div>
          <p class="sfx self-end mt-auto text-[clamp(1.8rem,4vw,3rem)]" style={`color:${colors[2]}`}>{sfx[2]}</p>
        </li>
        <!-- 4 · the cutover -->
        <li class="panel p-6 lg:col-span-2 flex flex-col gap-4">
          <span class="pnum">4</span>
          <p class="caption self-start">{migration[3].t}</p>
          <ComicArt kind="switch" class="w-40 self-center" />
          <p class="narr">{migration[3].s}</p>
          <p class="sfx self-end mt-auto text-[clamp(1.8rem,4vw,3rem)]" style={`color:${colors[3]}`}>{sfx[3]}</p>
        </li>
        <!-- 5 · the bill, with the witness speaking -->
        <li class="panel p-6 lg:col-span-2 flex flex-col gap-4">
          <span class="pnum">5</span>
          <p class="caption self-start">{migration[4].t}</p>
          <div class="flex items-center gap-4"><ComicArt kind="bill" class="w-28 shrink-0" /><p class="narr">{migration[4].s}</p></div>
          <p class="bubble text-base"><strong class="emph">“Saved us $30,000 annually in licensing fees.”</strong> <cite class="not-italic text-sm">· <a href="#witness-jason-wheeler" class="underline underline-offset-2">Jason Wheeler</a>, VP of Technology</cite></p>
          <p class="sfx self-end mt-auto text-[clamp(1.8rem,4vw,3rem)]" style={`color:${colors[4]}`}>{sfx[4]}</p>
        </li>
      </ol>
    </section>

    <!-- CASE FILES -->
    <section id="cases" class="cv mt-16 scroll-mt-24" aria-labelledby="ch2">
      <h2 id="ch2" class="text-5xl sm:text-6xl">Chapter 2 · Case files</h2>
      <p class="mt-2 text-xl lede"><span>Eight cases. Open a file for the context, the decision and what it changed.</span></p>
      <ol class="mt-8 grid gap-7 md:grid-cols-2 items-start">
        {records.map((r, i) => {
          const headline = r.data.consequences.find((c) => c.emphasis)?.value ?? "";
          const ws = recordWitnesses[i];
          return (
            <li id={`file-${r.id}`} class="panel file p-6 pt-8 scroll-mt-24">
              <span class="filetab">File {String(i + 1).padStart(2, "0")}</span>
              <details class="group">
                <summary class="cursor-pointer">
                  <p class="text-sm">{r.data.organisation} · {r.data.date} · {r.data.tags[0]}</p>
                  <h3 class="text-3xl mt-1">{r.data.index}</h3>
                  <p class="mt-2 text-lg">{r.data.summary}</p>
                  <p class="mt-3"><span class:list={["hl", headline.length > 24 ? "font-bold text-lg" : "bang text-3xl"]} style={`background:${colors[i % 5]}; color:${onColor[i % 5]}`}>{headline}</span></p>
                  <span class="btn alt text-base py-1 mt-4 open-cta">Open the file ▸</span>
                  <span class="btn alt text-base py-1 mt-4 close-cta">Close the file ▾</span>
                </summary>
                <div class="mt-5 border-t-4 border-dashed border-[#111] pt-5 space-y-4">
                  <p><strong class="bang text-xl mr-1">Context.</strong> {r.data.context}</p>
                  <p><strong class="bang text-xl mr-1">Decision.</strong> {r.data.decision}</p>
                  <ul class="grid grid-cols-2 gap-3">{r.data.consequences.map((c) => <li class="tile !p-3"><span class:list={["block", c.value.length > 24 ? "font-bold" : "bang text-2xl"]}>{c.value}</span><span class="text-sm">{c.label}</span></li>)}</ul>
                  {ws.length > 0 && <p class="flex flex-wrap items-center gap-2"><strong class="bang text-xl">Witnesses:</strong>{ws.map((w) => <a href={`#witness-${w.id}`} class="tag !bg-white hover:!bg-[#fff3b0]">{w.data.name}</a>)}</p>}
                  <ul class="flex flex-wrap gap-2" aria-label="Tags">{r.data.tags.map((t) => <li class="tag">{t}</li>)}</ul>
                </div>
              </details>
            </li>
          );
        })}
      </ol>
    </section>

    <!-- WITNESSES -->
    <section id="witnesses" class="cv mt-16 scroll-mt-24" aria-labelledby="ch3">
      <h2 id="ch3" class="text-5xl sm:text-6xl">Chapter 3 · Nine witnesses</h2>
      <p class="mt-2 text-xl lede"><span>Every word verbatim. Nothing paraphrased.</span></p>
      <ul class="mt-8 md:columns-2 md:gap-10">
        {witnesses.map((w, i) => {
          const pull = w.data.pull ?? "";
          const paras = w.data.quote.split(/\n\s*\n/);
          const initials = w.data.name.split(" ").map((n) => n[0]).slice(0, 2).join("");
          return (
            <li id={`witness-${w.id}`} class="break-inside-avoid mb-10">
              <blockquote class="bubble text-lg space-y-3">
                {paras.map((para) => { const k = pull && para.includes(pull) ? para.indexOf(pull) : -1; return k < 0 ? <p>{para}</p> : <p>{para.slice(0, k)}<strong class="emph">{pull}</strong>{para.slice(k + pull.length)}</p>; })}
              </blockquote>
              <footer class="mt-6 ml-5 flex items-center gap-3">
                <span class="badge" aria-hidden="true">{initials}</span>
                <span class="caption"><span class="bang text-sm text-[#b5123b] mr-2">{String(i + 1).padStart(2, "0")}/09</span><strong>{w.data.name}</strong> · {w.data.title}{w.data.organisation ? `, ${w.data.organisation}` : ""}</span>
              </footer>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- ORIGIN -->
    <section id="origin" class="cv mt-16 scroll-mt-24" aria-labelledby="ch4">
      <h2 id="ch4" class="text-5xl sm:text-6xl">Chapter 4 · Origin story</h2>
      <p class="mt-2 text-xl lede"><span>Where I am now, then how I got here. Four issues, three promotions.</span></p>
      <ol class="mt-8 origin">
        {roles.map((r, i) => {
          const promo = ["Now", "Promoted from SDE 1 · 3 years 8 months", "Promoted to SDE 2 within five months", "Promoted to SDE 1 within a year"][i];
          return (
            <li class="origin-item">
              <div class="spine" aria-hidden="true"><span class="year bang">{r.data.start.slice(0, 4)}</span></div>
              <article class="panel p-6 sm:p-8">
                <span class="pnum">{i + 1}</span>
                <header class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-start">
                  <div><h3 class="text-3xl sm:text-4xl">{r.data.role}</h3><p class="text-lg">{r.data.company} · {r.data.type}</p></div>
                  <div class="flex flex-wrap gap-2 justify-self-start sm:justify-self-end sm:justify-end"><p class="caption">{fmt(r.data.start)} → {fmt(r.data.end)}</p><p class="caption !bg-[#1b998b]">{promo}</p></div>
                </header>
                <div class:list={["mt-6 grid gap-6", r.data.groups.length > 1 && "lg:grid-cols-2"]}>
                  {r.data.groups.map((g) => <div class="tile"><p class="bang text-2xl"><span class="hl" style={`background:${colors[i % 5]}; color:${onColor[i % 5]}`}>{g.name}</span></p><ul class="mt-2 list-disc pl-5 space-y-2 max-w-[62ch]">{g.bullets.map((b) => <li>{b}</li>)}</ul></div>)}
                </div>
                <ul class="mt-6 flex flex-wrap gap-2" aria-label="Worked with">{r.data.skills.map((sk) => <li class="tag">{sk}</li>)}</ul>
              </article>
            </li>
          );
        })}
      </ol>
    </section>

    <!-- RESUME -->
    <section id="resume" class="cv mt-16 scroll-mt-24 panel p-6 sm:p-10 lg:p-12 grid gap-10 lg:grid-cols-[1.15fr_1fr] items-center" aria-labelledby="res-h" data-page="Collector’s insert">
      <div>
        <p class="caption">Collector’s insert · 2 pages</p>
        <h2 id="res-h" class="text-5xl sm:text-6xl mt-4 text-balance">The official resume</h2>
        <p class="mt-4 text-xl max-w-[46ch]"><span data-experience>{exp.long}</span>, the whole stack, every role with its numbers, education and the 2021 award. Read it here or take the PDF home.</p>
        <div class="mt-6 flex flex-wrap gap-3"><button type="button" class="btn" data-resume-open>Read it here ▸</button><a href={site.resume} download={site.resumeName} class="btn alt">Download PDF ▸</a></div>
        <dl class="mt-8 grid gap-6 sm:grid-cols-2">
          <div class="tile tabbed relative"><dt class="filetab">Training</dt><dd class="text-lg leading-snug">{site.education.degree}<br /><span class="text-[#555]">{site.education.school}</span><br /><span class="text-[#555]">{site.education.years} · CGPA {site.education.cgpa}</span></dd></div>
          <div class="tile tabbed relative"><dt class="filetab">Medal</dt><dd class="text-lg leading-snug">{site.award.title}<br /><span class="text-[#555]">{site.award.by}, {site.award.year}</span></dd></div>
        </dl>
      </div>
      <button type="button" class="sheet w-full max-w-sm justify-self-center lg:justify-self-end" data-resume-open aria-label="Open the resume preview">
        <span class="sheet-face"><Image src={resumePage} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 384px, 90vw" class="block w-full h-auto" loading="lazy" /></span>
        <span class="pnum" aria-hidden="true">1/2</span>
        <span class="caption absolute right-3 bottom-3 !rotate-[1deg] sheet-cta">Read it ▸</span>
      </button>
      <ResumeDialog dialogClass="bg-[#fff8e7] text-[#111] border-4 border-[#111]" btnClass="btn text-sm sm:text-base py-1 px-3" btnAltClass="btn alt text-sm sm:text-base py-1 px-3" closeClass="btn alt text-sm sm:text-base py-1 px-3" />
    </section>

    <!-- POWERS -->
    <section id="powers" class="cv mt-16 scroll-mt-24" aria-labelledby="pow-h" data-page="Power-ups">
      <h2 id="pow-h" class="text-5xl sm:text-6xl">Power-ups</h2>
      <p class="mt-2 text-xl lede"><span>Nine groups of tools, collected over <span data-experience>{exp.long}</span>. The AI and cloud ones are the newest.</span></p>
      <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {skillGroups.map(([group, items], i) => (
          <li class="panel p-5 pt-7">
            <span class="filetab" style={`background:${colors[i % 5]}; border-color:#111; color:${onColor[i % 5]}`}>{String(i + 1).padStart(2, "0")}</span>
            <h3 class="text-2xl">{group}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">{items.map((it) => <li class="tag">{it}</li>)}</ul>
          </li>
        ))}
      </ul>
      <div class="panel mt-8 p-6 pt-8"><span class="filetab">Daily strip</span><p class="text-lg">GitHub, the last twelve months · <a href={site.github} class="underline">@MDmubarak786</a></p><div class="mt-4"><Calendar empty="#fff" levels={["#ffd6e0", "#ff9ab5", "#ff5c8a", "#ff2e63"]} ink="#111" showTotal totalClass="mt-3 text-base" /></div></div>
    </section>

    <!-- BACK ISSUES -->
    <section id="back-issues" class="cv mt-16 scroll-mt-24" aria-labelledby="back" data-page="Back issues">
      <h2 id="back" class="text-5xl sm:text-6xl">Back issues · 2020</h2>
      <p class="mt-2 text-xl lede"><span>Eight Flutter apps from the year I was learning mobile. Minor issues, but every one shipped with a demo.</span></p>
      <ul class="mt-8 grid gap-5 grid-cols-2 lg:grid-cols-4">
        {projects.map((p, i) => {
          const id = p.data.link ? ytId(p.data.link) : undefined;
          return (
            <li class="issue">
              <a href={p.data.link} rel="noopener" target="_blank" class="block group">
                <div class="cover">
                  {id ? <img src={`https://img.youtube.com/vi/${id}/hqdefault.jpg`} alt={`Demo video of ${p.data.name}`} width="480" height="360" loading="lazy" class="w-full aspect-[4/3] object-cover" /> : <div class="w-full aspect-[4/3] bg-[#fff3b0]"></div>}
                  <span class="issue-no">No. {i + 1}</span>
                  <span class="play"><span class="btn text-base py-1">▶ Watch demo</span></span>
                </div>
                <p class="mt-3 text-xs">{fmt(p.data.period)} · {p.data.tags[0]}</p>
                <h3 class="text-xl sm:text-2xl leading-tight group-hover:text-[#ff2e63]">{p.data.name}</h3>
                {p.data.description && <p class="text-sm mt-1">{p.data.description}</p>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- THE STRIP -->
    {posts.length > 0 && (
      <section id="strip" class="cv mt-16 scroll-mt-24" aria-labelledby="strip-h" data-page="The strip">
        <h2 id="strip-h" class="text-5xl sm:text-6xl">The weekly strip</h2>
        <p class="mt-2 text-xl lede"><span>What shipped in AI and what to build with it. New issue every week; primary sources only.</span></p>
        <ol class="mt-8 grid gap-6 md:grid-cols-3" role="list">
          {posts.map((p) => (
            <li class="panel p-5">
              <p class="text-sm">{fmtDay(p.data.date)}</p>
              <h3 class="text-2xl mt-1 leading-tight"><a href={`/blog/${p.id}/`} class="hover:text-[#ff2e63]">{p.data.title}</a></h3>
              <p class="mt-2 text-[#555] leading-snug">{p.data.description}</p>
              <a href={`/blog/${p.id}/`} class="btn alt text-base py-1 mt-4 inline-block">Read it ▸</a>
            </li>
          ))}
        </ol>
        <p class="mt-6"><a href="/blog" class="btn">All issues ▸</a></p>
      </section>
    )}

    <!-- CONTACT -->
    <section id="contact" class="cv mt-16 scroll-mt-24 panel p-6 sm:p-12" aria-labelledby="ch5" data-page="Back cover">
      <div class="zig mb-6"></div>
      <h2 id="ch5" class="text-5xl sm:text-7xl text-[#ff2e63]" style="-webkit-text-stroke:2px #111">Next issue needs a publisher.</h2>
      <div class="mt-8 grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-start">
        <div class="flex items-start gap-4 sm:gap-6">
          <Image src={avatar} alt="" width={160} height={160} class="size-20 sm:size-28 rounded-full border-4 border-[#111] object-cover shrink-0" style="box-shadow: 4px 4px 0 #111" loading="lazy" />
          <div class="flex-1 min-w-0">
            <p class="bubble text-xl"><strong>Hiring for a senior or lead role?</strong> Write, call, or send a message. I read everything.</p>
            <p class="mt-5 ml-4 text-lg flex flex-wrap items-center gap-x-3 gap-y-2"><strong>{site.name}</strong><Pronounce class="caption cursor-pointer" /><span class="text-base text-[#555]">{site.pronouns} · {site.location}</span></p>
          </div>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:flex-col">
          <a href={mailto("A role")} class="btn text-center">Email me ▸</a>
          <a href={site.whatsapp} class="btn alt text-center">WhatsApp ▸</a>
          <a href={site.linkedin} rel="noopener" target="_blank" class="btn alt text-center">LinkedIn ▸</a>
        </div>
      </div>
      <dl class="mt-10 pt-6 border-t-4 border-dashed border-[#111] grid gap-x-6 gap-y-4 grid-cols-2 lg:grid-cols-4">
        {channels.map(([l, v, h]) => <div class="min-w-0"><dt class="bang text-lg">{l}</dt><dd><a href={h} class="underline [overflow-wrap:anywhere]">{v}</a></dd></div>)}
      </dl>
      <p class="mt-8 text-sm">© {new Date().getFullYear()} {site.name} · Built as a comic, with real numbers.</p>
    </section>
  </main>
  <script define:vars={{ start: site.careerStart }}>
    const s = new Date(start + "T00:00:00Z"), n = new Date();
    let y = n.getUTCFullYear() - s.getUTCFullYear(), m = n.getUTCMonth() - s.getUTCMonth();
    if (n.getUTCDate() < s.getUTCDate()) m -= 1; if (m < 0) { y -= 1; m += 12; }
    const t = `${y} year${y === 1 ? "" : "s"}${m ? ` ${m} month${m === 1 ? "" : "s"}` : ""}`;
    document.querySelectorAll("[data-experience]").forEach((el) => { if (el.textContent !== t) el.textContent = t; });
  </script>
  <script>
    const openFile = (hash: string) => { if (!hash.startsWith("#file-")) return; const d = document.querySelector<HTMLDetailsElement>(`${hash} details`); if (d) d.open = true; };
    document.querySelectorAll<HTMLAnchorElement>("[data-open-file]").forEach((a) => a.addEventListener("click", () => openFile(a.getAttribute("href") ?? "")));
    openFile(location.hash);
    addEventListener("hashchange", () => openFile(location.hash));
  </script>
  <script src="../scripts/comic-motion.ts"></script>
  <script src="../scripts/page-curtain.ts"></script>
</FinalShell>
