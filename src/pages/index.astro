---
import Base from "../layouts/Base.astro";
import Preloader from "../components/Preloader.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Work from "../components/Work.astro";
import Testimonials from "../components/Testimonials.astro";
import Experience from "../components/Experience.astro";
import Resume from "../components/Resume.astro";
import StackMarquee from "../components/StackMarquee.astro";
import EarlierWork from "../components/EarlierWork.astro";
import Contact from "../components/Contact.astro";
import FinalsBar from "../components/final/FinalsBar.astro";
import { site } from "../lib/site";

const description = `${site.name}, ${site.role} in ${site.location}. Sole engineer behind a 1.25M-user multilingual platform, a 96% integration cost cut, and nine leaders vouching on record.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: [site.shortName, site.tamilName],
  jobTitle: site.role,
  worksFor: { "@type": "Organization", name: site.employer },
  address: { "@type": "PostalAddress", addressLocality: "Bangalore", addressCountry: "IN" },
  email: `mailto:${site.email}`,
  telephone: site.phoneE164,
  url: site.url,
  image: new URL("/og.png", site.url).href,
  sameAs: [site.linkedin, site.github, site.x, site.instagram, site.youtube],
  knowsAbout: ["TypeScript", "React", "Next.js", "Astro", "AWS Glue", "AWS Lambda", "Salesforce integration", "Storyblok", "Localization"],
};
---
<Base title={`${site.name} – ${site.role}`} description={description} path="/" jsonLd={jsonLd}>
  <Preloader />
  <Header />
  <main id="main" class="relative">
    <div id="top"></div>
    <Hero />
    <Intro />
    <Work />
    <Testimonials />
    <Experience />
        <Resume />
    <StackMarquee />
    <EarlierWork />
  </main>
  <Contact />
  <FinalsBar current="studio" />
  <script src="../scripts/motion.ts"></script>
</Base>
