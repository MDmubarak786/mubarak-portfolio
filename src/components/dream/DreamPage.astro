---
import Shell from "../../layouts/StoryShell.astro";
import Scene from "./Scene.astro";
import Audio from "./Audio.astro";
import { me, numbers, work, voices, roles } from "../../lib/story";
interface Props { n: number; kind: "room" | "dusk" | "greenhouse" | "deep" | "sky" | "plaster"; eyebrow: string; italic: string; plain: string; cta: string; storyTitle: string; story: { t: string; s: string }[]; wrapped: string; bg: string; fg: string; pill: string }
const { n, kind, eyebrow, italic, plain, cta, storyTitle, story, wrapped, bg, fg, pill } = Astro.props;
---
<Shell title={`${n} · ${plain}`} fonts={["--font-bodoni", "--font-hanken"]} n={n}>
  <style is:global>
    :root { --v-font-text: var(--font-hanken); --v-font-display: var(--font-hanken); }
    .dream { color: var(--fg); background: var(--bg); font-family: var(--font-hanken); }
    .dream ::selection { background: var(--fg); color: var(--bg); }
    .it { font-family: var(--font-bodoni); font-style: italic; font-weight: 400; letter-spacing: -0.02em; }
    .pl { font-family: var(--font-hanken); font-weight: 400; letter-spacing: -0.035em; }
    .pill { display:inline-flex; align-items:center; gap:.4rem; border:1px solid color-mix(in oklab, var(--fg) 45%, transparent); border-radius:999px; padding:.45rem 1rem; font-size:.8rem; background: var(--pill); backdrop-filter: blur(8px); transition: background .3s, color .3s; }
    .pill:hover { background: var(--fg); color: var(--bg); }
    .tiny { font-size:.68rem; letter-spacing:.14em; text-transform:uppercase; }
    .row { border-top:1px solid color-mix(in oklab, var(--fg) 18%, transparent); transition: padding .4s; }
    .row:hover { padding-left:.75rem; }
    .round { width:2.4rem; height:2.4rem; border-radius:999px; border:1px solid color-mix(in oklab, var(--fg) 45%, transparent); display:grid; place-items:center; }
    .fade { animation: fade 1.6s cubic-bezier(.2,.8,.2,1) both; } @keyframes fade { from { opacity:0; transform: translateY(14px); } }
  </style>
  <div class="dream" style={`--bg:${bg};--fg:${fg};--pill:${pill}`}>
  <Audio />
  <script define:vars={{ bg, fg }}>document.documentElement.style.background = bg; document.documentElement.style.color = fg;</script>
  <!-- hero scene -->
  <section class="relative h-dvh overflow-hidden">
    <Scene kind={kind} />
    <header class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-6 sm:px-10 pt-6 text-sm">
      <a href="#" class="pl text-lg tracking-tight">{me.shortName.toLowerCase()}<span class="it text-xl">studio</span></a>
      <nav class="hidden sm:flex items-center gap-7"><a href="#index" class="hover:opacity-60">Index</a><a href="#story" class="hover:opacity-60">Story</a><a href="#contact" class="hover:opacity-60">Contact</a><button type="button" class="round" data-audio-toggle aria-pressed="false" aria-label="Toggle sound"><span class="eq"><i></i><i></i><i></i><i></i></span></button></nav>
    </header>
    <div class="absolute inset-0 z-10 grid place-items-center text-center px-6">
      <div class="fade">
        <p class="tiny opacity-70">{eyebrow}</p>
        <h1 class="mt-3 leading-[0.92]"><span class="it block text-[clamp(3rem,8vw,7.5rem)]">{italic}</span><span class="pl block text-[clamp(2.6rem,7.4vw,7rem)] -mt-2">{plain}</span></h1>
        <a href="#index" class="pill mt-7">{cta} <span aria-hidden="true">↘</span></a>
      </div>
    </div>
    <div class="absolute inset-x-0 bottom-0 z-10 flex items-center justify-between px-6 sm:px-10 pb-6 text-xs">
      <div class="flex items-center gap-3"><span class="round"><span class="w-2 h-2 rounded-full bg-current"></span></span><a href="#story" class="pill">{wrapped}</a></div>
      <button type="button" class="round" data-audio-toggle aria-pressed="false" aria-label="Toggle sound"><span class="eq"><i></i><i></i><i></i><i></i></span></button>
      <span class="opacity-70">©2026</span>
    </div>
  </section>

  <!-- index -->
  <section id="index" class="px-6 sm:px-10 py-24 max-w-6xl mx-auto">
    <div class="flex items-end justify-between gap-6"><h2 class="it text-5xl sm:text-6xl">Index</h2><p class="tiny opacity-70">{work.length} selected works · 2021 → 2026</p></div>
    <ol class="mt-10">
      {work.map((w, i) => <li class="row py-6 grid grid-cols-[2.5rem_1fr_auto] sm:grid-cols-[3rem_1.4fr_1fr_auto] gap-4 items-baseline"><span class="tiny opacity-60">{String(i + 1).padStart(2, "0")}</span><span><span class="pl text-2xl sm:text-3xl">{w.title}</span><span class="block text-sm opacity-70 mt-1 sm:hidden">{w.out}</span></span><span class="hidden sm:block text-sm opacity-80">{w.out}</span><span class="tiny opacity-60">{w.kind} · {w.year}</span></li>)}
    </ol>
  </section>

  <!-- numbers -->
  <section class="px-6 sm:px-10 pb-24 max-w-6xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
    {numbers.map((x) => <div><p class="it text-6xl">{x.v}</p><p class="pl text-lg mt-1">{x.k}</p><p class="text-sm opacity-70 max-w-[22ch]">{x.d}</p></div>)}
  </section>

  <!-- story -->
  <section id="story" class="relative overflow-hidden py-28">
    <div class="absolute inset-0 opacity-60"><Scene kind={kind} /></div>
    <div class="relative max-w-3xl mx-auto px-6 text-center">
      <h2 class="leading-[0.95]"><span class="it block text-5xl sm:text-7xl">{storyTitle.split("|")[0]}</span><span class="pl block text-4xl sm:text-6xl">{storyTitle.split("|")[1]}</span></h2>
      <ol class="mt-12 space-y-8 text-left">{story.map((b, i) => <li class="grid grid-cols-[3rem_1fr] gap-4"><span class="tiny opacity-60 pt-2">0{i + 1}</span><div><p class="it text-3xl">{b.t}</p><p class="mt-1 opacity-85 max-w-[52ch]">{b.s}</p></div></li>)}</ol>
    </div>
  </section>

  <!-- voices + roles -->
  <section class="px-6 sm:px-10 py-24 max-w-6xl mx-auto grid gap-16 lg:grid-cols-[1.2fr_1fr]">
    <div><h2 class="it text-5xl">Kind words</h2><div class="mt-8 space-y-8">{voices.map((v) => <blockquote><p class="pl text-2xl leading-snug">“{v.q}”</p><footer class="tiny opacity-60 mt-2">{v.n} · {v.t}</footer></blockquote>)}</div></div>
    <div><h2 class="it text-5xl">Chapters</h2><ol class="mt-8">{roles.map((r) => <li class="row py-4 flex justify-between gap-4"><span class="pl text-lg">{r.r}<span class="block text-sm opacity-70">{r.c}</span></span><span class="tiny opacity-60 pt-1 text-right">{r.w}</span></li>)}</ol></div>
  </section>

  <!-- contact, the "Say hello" page -->
  <section id="contact" class="relative h-[80dvh] min-h-[32rem] overflow-hidden">
    <Scene kind={kind} />
    <div class="absolute inset-0 z-10 grid place-items-center text-center px-6">
      <div>
        <h2 class="it text-[clamp(3rem,8vw,7rem)] leading-none">Say hello</h2>
        <p class="tiny opacity-70 mt-3">We look forward<br />to hearing from you</p>
        <div class="mt-6 flex flex-wrap justify-center gap-2"><a href={`mailto:${me.email}?subject=A%20role`} class="pill">Hiring ↘</a><a href={me.whatsapp} class="pill">WhatsApp ↘</a><a href={me.linkedin} class="pill">LinkedIn ↘</a></div>
        <a href={`mailto:${me.email}`} class="pl block mt-6 text-xl sm:text-3xl hover:opacity-60 [overflow-wrap:anywhere]">{me.email}</a>
        <p class="tiny opacity-60 mt-3">{me.location} · <span lang="ta" class="normal-case tracking-normal">{me.tamilName}</span></p>
      </div>
    </div>
  </section>
  </div>
</Shell>
