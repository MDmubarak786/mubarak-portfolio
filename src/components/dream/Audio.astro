---
import { me } from "../../lib/story";
---
<!-- Entry gate: audio needs a user gesture, so the first click is the one that starts it. -->
<div class="gate fixed inset-0 z-[80] grid place-items-center text-center px-6" data-gate>
  <div>
    <div class="eyes mx-auto mb-5" aria-hidden="true"><span></span><span></span></div>
    <p class="tiny">{me.name}</p>
    <p class="mt-2 text-sm max-w-xs mx-auto opacity-80">A senior engineer building products where full-stack meets AI. Chennai, India.</p>
    <button type="button" class="pill mt-6" data-enter>Enter <span aria-hidden="true">↘</span></button>
  </div>
  <button type="button" class="absolute bottom-8 tiny underline underline-offset-4 opacity-70 hover:opacity-100" data-enter-silent>Enter without audio</button>
</div>
<style>
  .gate { background: var(--bg); color: var(--fg); transition: opacity .9s cubic-bezier(.76,0,.24,1), visibility .9s; }
  .gate.is-closed { opacity:0; visibility:hidden; pointer-events:none; }
  .eyes { display:flex; gap:.3rem; width:fit-content; }
  .eyes span { width:2.4rem; height:2.4rem; border-radius:50%; background:#fff; border:3px solid var(--fg); position:relative; animation: blink 5s infinite; }
  .eyes span::after { content:""; position:absolute; width:1rem; height:1rem; border-radius:50%; background: var(--fg); top:.55rem; left:.9rem; animation: look 7s ease-in-out infinite; }
  @keyframes blink { 0%,94%,100% { transform: scaleY(1);} 97% { transform: scaleY(.1);} }
  @keyframes look { 0%,20% { left:.9rem } 40%,60% { left:.3rem } 80%,100% { left:.9rem } }
  /* equaliser bars inside any [data-audio-toggle] */
  [data-audio-toggle] .eq { display:flex; align-items:flex-end; gap:2px; height:12px; }
  [data-audio-toggle] .eq i { width:2px; height:3px; background: currentColor; transition: height .3s; }
  [data-audio-toggle][data-on="true"] .eq i { animation: eq .8s ease-in-out infinite alternate; }
  [data-audio-toggle][data-on="true"] .eq i:nth-child(2) { animation-delay:-.2s } [data-audio-toggle][data-on="true"] .eq i:nth-child(3) { animation-delay:-.5s } [data-audio-toggle][data-on="true"] .eq i:nth-child(4) { animation-delay:-.35s }
  @keyframes eq { from { height:3px } to { height:12px } }
</style>
<script>
  // ---- A small generative soundscape and UI tones, all synthesised. No files, nothing to license. ----
  type Ctx = AudioContext;
  let ctx: Ctx | null = null, master: GainNode | null = null, padGain: GainNode | null = null, voices: { osc: OscillatorNode[]; gain: GainNode }[] = [];
  let chordTimer = 0, on = false;
  const CHORDS = [[130.81, 196.0, 329.63, 493.88], [110.0, 164.81, 261.63, 440.0], [87.31, 174.61, 261.63, 329.63], [98.0, 146.83, 246.94, 392.0]]; // Cmaj7 · Am7 · Fmaj7 · G6

  function impulse(c: Ctx, seconds = 2.8, decay = 3) {
    const len = c.sampleRate * seconds, buf = c.createBuffer(2, len, c.sampleRate);
    for (let ch = 0; ch < 2; ch++) { const d = buf.getChannelData(ch); for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, decay); }
    return buf;
  }
  function build() {
    ctx = new AudioContext();
    master = ctx.createGain(); master.gain.value = 0;
    const reverb = ctx.createConvolver(); reverb.buffer = impulse(ctx);
    const wet = ctx.createGain(); wet.gain.value = 0.55;
    master.connect(ctx.destination); master.connect(reverb); reverb.connect(wet); wet.connect(ctx.destination);
    // pad
    padGain = ctx.createGain(); padGain.gain.value = 0.16;
    const lp = ctx.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 700; lp.Q.value = 0.7;
    const lfo = ctx.createOscillator(); lfo.frequency.value = 0.06; const lfoGain = ctx.createGain(); lfoGain.gain.value = 320; lfo.connect(lfoGain); lfoGain.connect(lp.frequency); lfo.start();
    padGain.connect(lp); lp.connect(master);
    voices = CHORDS[0].map((f) => {
      const g = ctx!.createGain(); g.gain.value = 0.25; g.connect(padGain!);
      const oscs = [["sine", -6], ["triangle", 6]].map(([type, cents]) => { const o = ctx!.createOscillator(); o.type = type as OscillatorType; o.frequency.value = f; o.detune.value = Number(cents); o.connect(g); o.start(); return o; });
      return { osc: oscs, gain: g };
    });
    // noise wash
    const n = ctx.createBufferSource(); const nb = ctx.createBuffer(1, ctx.sampleRate * 4, ctx.sampleRate); const nd = nb.getChannelData(0); for (let i = 0; i < nd.length; i++) nd[i] = Math.random() * 2 - 1; n.buffer = nb; n.loop = true;
    const bp = ctx.createBiquadFilter(); bp.type = "bandpass"; bp.frequency.value = 420; bp.Q.value = 0.5;
    const ng = ctx.createGain(); ng.gain.value = 0.018;
    const nl = ctx.createOscillator(); nl.frequency.value = 0.045; const nlg = ctx.createGain(); nlg.gain.value = 0.012; nl.connect(nlg); nlg.connect(ng.gain); nl.start();
    n.connect(bp); bp.connect(ng); ng.connect(master); n.start();
    let i = 0;
    chordTimer = window.setInterval(() => { i = (i + 1) % CHORDS.length; const t = ctx!.currentTime; voices.forEach((v, k) => v.osc.forEach((o) => o.frequency.exponentialRampToValueAtTime(CHORDS[i][k], t + 3))); }, 16000);
  }
  function tone(freqs: number[], dur: number, gainV: number, type: OscillatorType = "sine") {
    if (!ctx || !master || !on) return;
    const t = ctx.currentTime;
    freqs.forEach((f, k) => { const o = ctx!.createOscillator(); const g = ctx!.createGain(); o.type = type; o.frequency.value = f; g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(gainV, t + 0.006 + k * 0.01); g.gain.exponentialRampToValueAtTime(0.0001, t + dur); o.connect(g); g.connect(master!); o.start(t); o.stop(t + dur + 0.05); });
  }
  const hover = () => tone([1480], 0.09, 0.05);
  const click = () => tone([520, 784], 0.16, 0.08, "triangle");

  function setOn(v: boolean) {
    on = v;
    if (v && !ctx) build();
    if (ctx && master) { if (ctx.state === "suspended") void ctx.resume(); master.gain.cancelScheduledValues(ctx.currentTime); master.gain.linearRampToValueAtTime(v ? 0.9 : 0, ctx.currentTime + 1.2); }
    sessionStorage.setItem("audio", v ? "on" : "off");
    document.querySelectorAll<HTMLElement>("[data-audio-toggle]").forEach((b) => { b.dataset.on = String(v); b.setAttribute("aria-pressed", String(v)); });
  }
  // gate
  const gate = document.querySelector<HTMLElement>("[data-gate]");
  const close = () => { gate?.classList.add("is-closed"); sessionStorage.setItem("gated", "1"); };
  document.querySelector("[data-enter]")?.addEventListener("click", () => { setOn(true); click(); close(); });
  document.querySelector("[data-enter-silent]")?.addEventListener("click", () => { setOn(false); close(); });
  if (sessionStorage.getItem("gated") === "1") { gate?.classList.add("is-closed"); gate?.remove(); if (sessionStorage.getItem("audio") === "on") { const resume = () => { setOn(true); window.removeEventListener("pointerdown", resume); }; window.addEventListener("pointerdown", resume, { once: true }); document.querySelectorAll<HTMLElement>("[data-audio-toggle]").forEach((b) => (b.dataset.on = "true")); } }
  // toggles
  document.querySelectorAll<HTMLElement>("[data-audio-toggle]").forEach((b) => b.addEventListener("click", (e) => { e.preventDefault(); setOn(!on); if (on) click(); }));
  // UI sounds: hover ticks and click pops on every control
  const fine = matchMedia("(pointer: fine)").matches;
  document.addEventListener("pointerover", (e) => { if (!fine) return; const t = (e.target as HTMLElement).closest<HTMLElement>("a, button, .row"); if (t && !t.dataset.sounded) { hover(); t.dataset.sounded = "1"; setTimeout(() => delete t.dataset.sounded, 120); } });
  document.addEventListener("click", (e) => { const t = (e.target as HTMLElement).closest("a, button"); if (t && !t.hasAttribute("data-audio-toggle") && !t.hasAttribute("data-enter")) click(); });
  window.addEventListener("pagehide", () => { if (chordTimer) clearInterval(chordTimer); ctx?.close(); });
</script>
