---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const fmt = (ym: string) => new Date(ym + "-01T00:00:00Z").toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
---
<section id="earlier-work" class="px-5 sm:px-8 py-20 sm:py-28 scroll-mt-10" aria-labelledby="earlier-heading">
  <div class="max-w-7xl mx-auto grid gap-10 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <h2 id="earlier-heading" class="font-display text-xl font-medium text-muted">Earlier work</h2>
      <p class="mt-4 text-muted max-w-sm">Eight Flutter apps from 2020, built while I was learning mobile. Each has a short demo on YouTube.</p>
    </div>
    <ol class="border-t border-line">
      {projects.map((p) => (
        <li class="border-b border-line grid grid-cols-[auto_1fr_auto] items-center gap-4 py-4">
          <span class="text-xs text-muted tabular w-16">{fmt(p.data.period)}</span>
          <span><span class="font-medium">{p.data.name}</span>{p.data.description && <span class="block text-sm text-muted">{p.data.description}</span>}</span>
          {p.data.link && <a href={p.data.link} rel="noopener" target="_blank" class="link-draw text-sm inline-flex items-center gap-1">Demo <Icon name="lucide:arrow-up-right" size={14} aria-hidden="true" /></a>}
        </li>
      ))}
    </ol>
  </div>
</section>
