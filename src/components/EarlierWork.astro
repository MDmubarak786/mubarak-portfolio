---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import SectionHeading from "./SectionHeading.astro";
import { site } from "../lib/site";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const fmt = (ym: string) => new Date(ym + "-01T00:00:00Z").toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
---
<section id="earlier-work" data-section aria-labelledby="earlier-work-heading" class="sheet px-5 py-6 sm:px-8 sm:py-8 xl:px-10 xl:py-10 scroll-mt-20 lg:scroll-mt-6">
  <SectionHeading id="earlier-work" title="Earlier work" lede="Eight Flutter apps from 2020, built while I was learning mobile. Each has a short demo on YouTube." />
  <ol class="mt-8 divide-y divide-rule max-w-[70ch]">
    {projects.map((p) => (
      <li class="py-4 grid gap-1 sm:grid-cols-[7rem_minmax(0,1fr)_auto] sm:gap-6 sm:items-baseline">
        <p class="mono text-xs text-ink-muted tabular"><time datetime={p.data.period}>{fmt(p.data.period)}</time></p>
        <div>
          <p class="font-semibold">{p.data.name}</p>
          {p.data.description && <p class="text-sm text-ink-soft mt-0.5">{p.data.description}</p>}
          {p.data.bullets.length > 0 && <ul class="mt-1.5 list-disc pl-5 text-sm text-ink-soft space-y-0.5">{p.data.bullets.map((b) => <li>{b}</li>)}</ul>}
          {p.data.tags.length > 0 && <p class="text-xs text-ink-muted mt-1">{p.data.tags.join(" · ")}</p>}
        </div>
        {p.data.link && <a href={p.data.link} rel="noopener" target="_blank" class="press inline-flex items-center gap-1.5 px-2.5 py-1 text-sm no-underline hover:no-underline self-start"><Icon name="lucide:play" size={14} aria-hidden="true" /> Demo</a>}
      </li>
    ))}
  </ol>
  <div class="mt-10 pt-8 border-t border-rule max-w-[70ch] grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
    <div>
      <p class="font-display font-semibold">Whac-a-Thief, a mini game</p>
      <p class="text-sm text-ink-soft mt-1">Built in Spline. Tap the burglars, spare the cops, and keep the score climbing on a full-screen canvas.</p>
    </div>
    <a href={site.game} class="press inline-flex items-center gap-1.5 px-3 py-2 no-underline hover:no-underline self-start sm:self-center"><Icon name="lucide:gamepad-2" size={16} aria-hidden="true" /> Play the game</a>
  </div>
</section>
