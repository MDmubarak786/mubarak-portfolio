---
import { getCollection } from "astro:content";
import Contributions from "./Contributions.astro";
const items = (await getCollection("stack")).sort((a, b) => a.data.order - b.data.order).map((i) => i.data.id);
const third = Math.ceil(items.length / 3);
const rows = [items.slice(0, third), items.slice(third, third * 2), items.slice(third * 2)];
---
<section id="stack" class="py-20 sm:py-28 scroll-mt-10 border-y border-line bg-bg-2" aria-labelledby="stack-heading">
  <h2 id="stack-heading" class="sr-only">Stack</h2>
  {rows.map((row, i) => (
    <div class="marquee select-none" style={`--marquee-speed:${34 + i * 10}s`} aria-hidden="true">
      <div class="marquee-track font-display text-[clamp(2.5rem,7vw,6rem)] leading-none tracking-[-0.03em] py-2" data-reverse={i === 1 ? "" : undefined}>
        {[0, 1].map(() => row.map((s) => <span class="px-6 whitespace-nowrap hover:text-accent transition-colors">{s}<span class="text-muted pl-6">·</span></span>))}
      </div>
    </div>
  ))}
  <p class="sr-only">{items.join(", ")}</p>
  <div class="px-5 sm:px-8 mt-16 max-w-7xl mx-auto"><Contributions /></div>
</section>
