---
interface Line { label: string; value: string; emphasis: boolean }
interface Props { lines: Line[] }
const { lines } = Astro.props;
---
<dl class="tabular divide-y divide-rule border-y border-rule">
  {lines.map((l) => (
    <div class:list={["grid grid-cols-[1fr_auto] gap-x-6 py-2 items-baseline", l.emphasis ? "bg-ink text-paper px-3 -mx-3" : ""]}>
      <dt class:list={["text-sm", l.emphasis ? "text-paper" : "text-ink-soft"]}>{l.label}</dt>
      <dd class:list={["text-right", l.emphasis ? "font-display font-bold text-xl" : "font-semibold"]}>{l.value}</dd>
    </div>
  ))}
</dl>
