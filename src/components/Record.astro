---
import type { CollectionEntry } from "astro:content";
import StatusStamp from "./StatusStamp.astro";
import OptionsTable from "./OptionsTable.astro";
import Ledger from "./Ledger.astro";
import ReviewedBy from "./ReviewedBy.astro";
import ContactBlock from "./ContactBlock.astro";
interface Props { record: CollectionEntry<"records">; first?: boolean }
const { record, first = false } = Astro.props;
const d = record.data;
const anchor = d.id.toLowerCase();
---
<article id={anchor} data-record class="sheet px-5 py-6 sm:px-8 sm:py-8 xl:px-10 xl:py-10 scroll-mt-20 lg:scroll-mt-6">
  <header class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-start">
    <div class="space-y-2">
      <h2 class:list={[first ? "text-4xl" : "text-3xl"]}>{d.title}</h2>
      <p class="text-sm text-ink-soft">
        <span class="mono">{d.id}</span> · {d.organisation} · {d.role}
      </p>
    </div>
    <div class="justify-self-start sm:justify-self-end"><StatusStamp status={d.status} date={d.date} /></div>
  </header>

  <div class="mt-8 grid gap-10 xl:grid-cols-[minmax(0,1fr)_15rem]">
    <div class="space-y-8 max-w-[70ch]">
      <section>
        <h3 class="text-lg">Context</h3>
        <p class="mt-2">{d.context}</p>
      </section>
      <section>
        <h3 class="text-lg">Options considered</h3>
        <div class="mt-3 overflow-x-auto"><OptionsTable options={d.options} /></div>
      </section>
      <section>
        <h3 class="text-lg">Decision</h3>
        <p class="mt-2">{d.decision}</p>
      </section>
      <section>
        <h3 class="text-lg">Consequences</h3>
        <div class="mt-3"><Ledger lines={d.consequences} /></div>
      </section>
      <ContactBlock compact subject={`About ${d.id}: ${d.title}`} heading="Talk to me about this one" />
    </div>
    <ReviewedBy refs={d.reviewedBy} />
  </div>
</article>
