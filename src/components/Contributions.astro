---
import { getContributions } from "../lib/github";
import { site } from "../lib/site";
const c = await getContributions();
// Lay out weeks as columns, Sunday first, like the source calendar.
const first = new Date(c.days[0].date + "T00:00:00Z");
const offset = first.getUTCDay();
const cells: (typeof c.days[number] | null)[] = [...Array(offset).fill(null), ...c.days];
const weeks: (typeof cells)[] = [];
for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));
const size = 11, gap = 3, step = size + gap;
const w = weeks.length * step - gap, h = 7 * step - gap;
const fill = ["var(--color-paper-deep)", "color-mix(in oklab, var(--color-stamp) 35%, var(--color-paper))", "color-mix(in oklab, var(--color-stamp) 60%, var(--color-paper))", "color-mix(in oklab, var(--color-stamp) 82%, var(--color-paper))", "var(--color-stamp)"];
const months: { label: string; x: number }[] = [];
weeks.forEach((wk, i) => {
  const d = wk.find(Boolean);
  if (!d) return;
  const dt = new Date(d.date + "T00:00:00Z");
  if (dt.getUTCDate() <= 7) months.push({ label: dt.toLocaleDateString("en-US", { month: "short", timeZone: "UTC" }), x: i * step });
});
const year = c.days[c.days.length - 1].date.slice(0, 4);
---
<figure class="max-w-[70ch]">
  <figcaption class="flex flex-wrap items-baseline justify-between gap-2">
    <span class="font-display font-semibold">GitHub, the last twelve months</span>
    <span class="text-sm text-ink-soft tabular">{c.total.toLocaleString("en-US")} contributions · <a href={site.github} rel="noopener" target="_blank">@MDmubarak786</a>{c.source === "fallback" ? ` · snapshot ${c.fetchedAt}` : ""}</span>
  </figcaption>
  <div class="mt-3">
    <svg viewBox={`0 0 ${w} ${h + 16}`} role="img" aria-label={`${c.total} contributions on GitHub in the last year, shown as a calendar heat map`} class="block w-full h-auto">
      {months.map((m) => <text x={m.x} y={10} class="fill-ink-muted" font-size="10" font-family="var(--font-mono)">{m.label}</text>)}
      <g transform="translate(0 16)">
        {weeks.map((wk, x) => wk.map((d, y) => d && (
          <rect x={x * step} y={y * step} width={size} height={size} rx="2" fill={fill[Math.min(d.level, 4)]}>
            <title>{d.count} on {d.date}</title>
          </rect>
        )))}
      </g>
    </svg>
  </div>
  <p class="sr-only">Contribution calendar for {year}.</p>
</figure>
