---
import { getContributions } from "../lib/github";
import { site } from "../lib/site";
const c = await getContributions();
const first = new Date(c.days[0].date + "T00:00:00Z");
const offset = first.getUTCDay();
const cells: (typeof c.days[number] | null)[] = [...Array(offset).fill(null), ...c.days];
const weeks: (typeof cells)[] = [];
for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));
const size = 11, gap = 3, step = size + gap;
const w = weeks.length * step - gap, h = 7 * step - gap;
const fill = ["rgb(242 242 240 / 0.07)", "oklch(0.45 0.12 264)", "oklch(0.55 0.16 264)", "oklch(0.65 0.19 264)", "oklch(0.75 0.19 264)"];
---
<figure class="max-w-4xl">
  <figcaption class="flex flex-wrap items-baseline justify-between gap-2 text-sm text-muted">
    <span>GitHub, the last twelve months</span>
    <span class="tabular">{c.total.toLocaleString("en-US")} contributions · <a href={site.github} rel="noopener" target="_blank" class="link-draw text-fg">@MDmubarak786</a></span>
  </figcaption>
  <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={`${c.total} contributions on GitHub in the last year`} class="block w-full h-auto mt-4">
    {weeks.map((wk, x) => wk.map((d, y) => d && <rect x={x * step} y={y * step} width={size} height={size} rx="2.5" fill={fill[Math.min(d.level, 4)]}><title>{d.count} on {d.date}</title></rect>))}
  </svg>
</figure>
