---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.png";
import { site, mailto } from "../lib/site";
const socials = [["LinkedIn", site.linkedin], ["GitHub", site.github], ["X", site.x], ["Instagram", site.instagram], ["YouTube", site.youtube], ["WhatsApp", site.whatsapp]];
const year = new Date().getFullYear();
---
<footer id="contact" class="relative bg-bg-2 px-5 sm:px-8 pt-28 pb-8 scroll-mt-10 overflow-hidden" aria-labelledby="contact-heading">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center gap-5" data-reveal>
      <Image src={portrait} alt="" width={120} height={120} class="size-16 sm:size-24 rounded-full object-cover" loading="lazy" />
      <h2 id="contact-heading" class="font-display font-medium text-[clamp(2.6rem,8vw,7.5rem)] leading-[0.95] tracking-[-0.04em]" data-split>Let’s work together</h2>
    </div>
    <div class="relative mt-10 border-t border-line pt-10 flex flex-wrap items-center gap-4">
      <a href={mailto("A conversation about a role")} class="rounded-full border border-line-strong px-7 py-4 hover:bg-fg hover:text-bg transition">{site.email}</a>
      <a href={site.whatsapp} class="rounded-full border border-line-strong px-7 py-4 hover:bg-fg hover:text-bg transition">{site.phoneDisplay}</a>
      <a href={mailto("Let's talk")} class="btn-round sm:absolute sm:right-10 sm:-top-14 size-36 sm:size-44 bg-accent text-white text-lg font-medium" data-magnetic>Get in touch</a>
    </div>
    <div class="mt-24 grid gap-10 sm:grid-cols-[1fr_auto] text-sm">
      <div class="flex flex-wrap gap-x-10 gap-y-6">
        <div><p class="text-muted text-xs uppercase tracking-widest">Version</p><p class="mt-2">{year} © Edition</p></div>
        <div><p class="text-muted text-xs uppercase tracking-widest">Local time</p><p class="mt-2 tabular" data-clock>--:-- IST</p></div>
        <div><p class="text-muted text-xs uppercase tracking-widest">Name</p><p class="mt-2 font-tamil" lang="ta">{site.tamilName}</p></div>
      </div>
      <div>
        <p class="text-muted text-xs uppercase tracking-widest">Socials</p>
        <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-2">{socials.map(([l, h]) => <li><a href={h} rel="noopener" target="_blank" class="link-draw">{l}</a></li>)}</ul>
      </div>
    </div>
  </div>
  <a href="#top" class="btn-round fixed bottom-6 right-6 z-40 size-20 bg-fg text-bg text-sm font-medium opacity-0 translate-y-4 transition-all duration-500 data-[show]:opacity-100 data-[show]:translate-y-0" data-sticky-cta data-magnetic href={mailto("Let's talk")}>Let’s talk</a>
</footer>
<script>
  const el = document.querySelector("[data-clock]");
  const tick = () => { if (el) el.textContent = new Date().toLocaleTimeString("en-IN", { timeZone: "Asia/Kolkata", hour: "2-digit", minute: "2-digit", hour12: true }).toUpperCase() + " IST"; };
  tick(); setInterval(tick, 20000);
</script>
