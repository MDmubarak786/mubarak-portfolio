---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import portrait from "../assets/portrait.png";
import Pronounce from "./Pronounce.astro";
import ContactBlock from "./ContactBlock.astro";
import { site, sections } from "../lib/site";
interface Props { records: CollectionEntry<"records">[] }
const { records } = Astro.props;
const shortTitle = (r: CollectionEntry<"records">) => r.data.index;
---
<aside class="record-index lg:sticky lg:top-0 lg:h-dvh lg:overflow-y-auto lg:flex lg:flex-col border-b lg:border-b-0 lg:border-r border-rule bg-paper" aria-label="Record index">
  <!-- Identity -->
  <div class="px-4 pt-5 pb-3 lg:px-6 lg:pt-6 flex items-start gap-4">
    <Image src={portrait} alt={`Portrait of ${site.name}`} width={64} height={64} class="size-14 lg:size-16 rounded-sm border border-rule object-cover shrink-0" loading="eager" />
    <div class="min-w-0">
      <p class="font-display font-bold text-xl leading-tight">{site.name}</p>
      <p class="font-tamil text-lg leading-tight mt-0.5" lang="ta">{site.tamilName}</p>
      <p class="text-sm text-ink-soft mt-1">{site.role}, {site.employer}</p>
      <p class="text-xs text-ink-muted">{site.location} · {site.pronouns}</p>
    </div>
  </div>
  <div class="px-4 lg:px-6 pb-3 flex items-center gap-2">
    <Pronounce />
    <a href={site.github} class="press inline-flex items-center gap-1.5 px-2 py-1 text-sm no-underline hover:no-underline" rel="noopener" target="_blank"><Icon name="simple-icons:github" size={14} aria-hidden="true" /> GitHub</a>
  </div>

  <!-- Mobile: a disclosure. Desktop: always open. -->
  <details class="group lg:hidden border-t border-b border-rule sticky top-0 z-20 bg-paper">
    <summary class="list-none cursor-pointer px-4 py-3 flex items-center justify-between font-display font-semibold">
      <span>Index of records</span>
      <Icon name="lucide:chevron-down" size={18} class="transition-transform group-open:rotate-180" aria-hidden="true" />
    </summary>
    <nav class="px-2 pb-3" aria-label="Records, mobile">
      <ol class="space-y-0.5">
        {records.map((r) => (
          <li><a href={`#${r.data.id.toLowerCase()}`} class="index-link flex gap-3 px-2 py-1.5 text-sm no-underline hover:no-underline" data-index-link><span class="mono text-xs text-ink-muted pt-0.5 w-14 shrink-0">{r.data.id}</span><span>{shortTitle(r)}</span></a></li>
        ))}
        {sections.map((s) => (
          <li><a href={`#${s.id}`} class="index-link flex gap-3 px-2 py-1.5 text-sm no-underline hover:no-underline" data-index-link><span class="w-14 shrink-0" aria-hidden="true"></span><span>{s.label}</span></a></li>
        ))}
      </ol>
    </nav>
  </details>

  <nav class="hidden lg:block px-3 pt-3 border-t border-rule" aria-label="Records">
    <p class="px-3 font-display font-semibold">Index of records</p>
    <ol class="mt-2 space-y-0.5">
      {records.map((r) => (
        <li>
          <a href={`#${r.data.id.toLowerCase()}`} class="index-link flex gap-3 px-3 py-1.5 text-sm no-underline hover:no-underline rounded-[2px]" data-index-link>
            <span class="mono text-xs text-ink-muted pt-0.5 w-14 shrink-0">{r.data.id}</span>
            <span class="leading-snug">{shortTitle(r)}</span>
          </a>
        </li>
      ))}
    </ol>
    <ol class="mt-3 pt-3 border-t border-rule space-y-0.5">
      {sections.map((s) => (
        <li>
          <a href={`#${s.id}`} class="index-link flex gap-3 px-3 py-1.5 text-sm no-underline hover:no-underline rounded-[2px]" data-index-link>
            <span class="w-14 shrink-0" aria-hidden="true"></span><span>{s.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="hidden lg:block px-6 py-5 mt-auto border-t border-rule">
    <ContactBlock compact />
  </div>
</aside>

<style>
  .index-link { transition: background-color 120ms, box-shadow 120ms; }
  .index-link:hover { background-color: var(--color-paper-deep); }
  .index-link:active { box-shadow: var(--shadow-press); }
  .index-link[aria-current="true"] { background-color: var(--color-paper-deep); box-shadow: var(--shadow-press); font-weight: 600; }
</style>

<script>
  // Keep the index row of the record in view marked current. One observer, no layout reads per scroll.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-index-link]"));
  const targets = Array.from(document.querySelectorAll<HTMLElement>("[data-record], [data-section]"));
  if (links.length && targets.length && "IntersectionObserver" in window) {
    const byId = new Map<string, HTMLAnchorElement[]>();
    for (const l of links) {
      const id = l.getAttribute("href")!.slice(1);
      byId.set(id, [...(byId.get(id) ?? []), l]);
    }
    let current = "";
    const io = new IntersectionObserver((entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (!visible.length) return;
      const id = (visible[0].target as HTMLElement).id;
      if (id === current) return;
      current = id;
      for (const l of links) l.removeAttribute("aria-current");
      for (const l of byId.get(id) ?? []) l.setAttribute("aria-current", "true");
    }, { rootMargin: "-20% 0px -60% 0px", threshold: 0 });
    for (const t of targets) io.observe(t);
  }
</script>
