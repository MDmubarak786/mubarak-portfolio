---
import { greetings } from "../lib/site";
---
<div class="preloader fixed inset-0 z-[90] bg-bg text-fg grid place-items-center" data-preloader aria-hidden="true">
  <p class="font-display text-4xl sm:text-5xl flex items-center gap-3" data-greeting><span class="size-2 rounded-full bg-fg"></span><span>{greetings[0]}</span></p>
  <svg class="absolute left-0 right-0 top-full w-full h-[18vh] -mt-px text-bg" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path data-curtain d="M0 0 L100 0 L100 0 Q50 20 0 0 Z" fill="currentColor" /></svg>
</div>
<script define:vars={{ greetings }}>
  // Greetings cycle, then the curtain lifts with a curved edge. Once per session; never with reduced motion.
  const el = document.querySelector("[data-preloader]");
  const text = el?.querySelector("[data-greeting] span:last-child");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const seen = sessionStorage.getItem("preloaded") === "1";
  if (!el) {} else if (reduce || seen) { el.remove(); document.documentElement.classList.add("is-ready"); }
  else {
    document.documentElement.classList.add("is-loading");
    let i = 0;
    const step = () => { i++; if (i < greetings.length && text) { text.textContent = greetings[i]; setTimeout(step, 160); } else { finish(); } };
    const finish = () => {
      sessionStorage.setItem("preloaded", "1");
      el.style.transition = "transform 900ms cubic-bezier(0.76, 0, 0.24, 1)";
      el.style.transform = "translateY(-120%)";
      document.documentElement.classList.remove("is-loading");
      document.documentElement.classList.add("is-ready");
      setTimeout(() => el.remove(), 1000);
    };
    setTimeout(step, 650);
  }
</script>
