---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import portrait from "../assets/portrait.png";
import Pronounce from "./Pronounce.astro";
import { site } from "../lib/site";
---
<section class="relative min-h-dvh overflow-hidden bg-bg-2" aria-label="Introduction">
  <div class="sm:absolute sm:inset-0 grid place-items-center pointer-events-none pt-24 sm:pt-0">
    <div class="relative w-[min(78vw,26rem)] sm:w-[min(44vw,32rem)] aspect-[4/5] overflow-hidden rounded-[1.5rem]" data-parallax="0.12">
      <Image src={portrait} alt={`Portrait of ${site.name}`} width={800} height={1000} class="w-full h-full object-cover object-top scale-[1.05]" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-bg-2/70 via-transparent to-transparent"></div>
    </div>
  </div>

  <div class="relative z-10 flex flex-col sm:min-h-dvh px-5 sm:px-8 pt-8 sm:pt-28 pb-6">
    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 items-center gap-8">
      <div class="justify-self-start">
        <a href="#contact" class="group inline-flex items-center gap-3 rounded-full bg-fg text-bg pl-5 pr-2 py-2 text-sm font-medium" data-reveal>
          <span class="leading-tight">Located in<br />{site.location}</span>
          <span class="size-9 rounded-full bg-bg text-fg grid place-items-center overflow-hidden"><Icon name="lucide:globe" size={18} class="animate-[spin_12s_linear_infinite]" aria-hidden="true" /></span>
        </a>
      </div>
      <div class="justify-self-end text-right sm:max-w-[26vw] lg:max-w-xs" data-reveal>
        <Icon name="lucide:arrow-down-right" size={28} class="mb-3 inline-block" aria-hidden="true" />
        <p class="font-display text-2xl sm:text-3xl leading-tight">Lead Software Engineer<br /><span class="text-muted">&amp; Front-End Team Lead</span></p>
        <p class="mt-2 text-sm text-muted">{site.employer} · since 2021</p>
        <div class="mt-3 flex justify-end"><Pronounce /></div>
      </div>
    </div>

    <div class="marquee -mx-5 sm:-mx-8 mt-6 select-none" aria-hidden="true" style="--marquee-speed: 22s">
      <div class="marquee-track font-display font-semibold leading-none tracking-[-0.04em] text-[clamp(5rem,16vw,15rem)]">
        {[0, 1].map(() => <span class="pr-[0.35em]">{site.name} <span class="text-muted">—</span>&nbsp;</span>)}
      </div>
    </div>
    <h1 class="sr-only">{site.name}, {site.role}</h1>
  </div>
</section>
