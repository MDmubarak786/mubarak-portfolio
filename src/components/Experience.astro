---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
const roles = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const fmt = (ym: string | null) => ym ? new Date(ym + "-01T00:00:00Z").toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" }) : "Present";
---
<section id="experience" class="px-5 sm:px-8 py-20 sm:py-28 scroll-mt-10" aria-labelledby="experience-heading">
  <div class="max-w-7xl mx-auto">
    <h2 id="experience-heading" class="font-display text-xl font-medium text-muted mb-10">Experience</h2>
    <ol class="border-b border-line">
      {roles.map((r) => (
        <li class="border-t border-line">
          <details class="group">
            <summary class="list-none cursor-pointer grid grid-cols-[1fr_auto] sm:grid-cols-[1.2fr_1fr_auto] items-baseline gap-4 py-7 [&::-webkit-details-marker]:hidden">
              <span class="font-display text-2xl sm:text-3xl tracking-tight">{r.data.role}</span>
              <span class="text-sm text-muted tabular hidden sm:block">{r.data.company} · {fmt(r.data.start)} – {fmt(r.data.end)}</span>
              <Icon name="lucide:plus" size={20} class="transition-transform duration-500 group-open:rotate-45" aria-hidden="true" />
            </summary>
            <div class="pb-8 grid gap-6 lg:grid-cols-[1fr_1fr]">
              {r.data.groups.map((g) => <div><p class="font-medium">{g.name}</p><ul class="mt-2 space-y-2 text-muted list-disc pl-5">{g.bullets.map((b) => <li>{b}</li>)}</ul></div>)}
              <p class="text-sm text-muted lg:col-span-2">{r.data.skills.join(" · ")}</p>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>
