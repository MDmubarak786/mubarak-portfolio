---
import { site } from "../../lib/site";
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
---
<button type="button" class:list={["inline-flex items-center gap-2", cls]} data-pronounce aria-label={`Hear how to pronounce ${site.name}`}>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a9 9 0 0 1 0 14"/></svg>
  <span lang="ta">{site.tamilName}</span>
</button>
<audio preload="none" src={site.audio} data-pronounce-audio></audio>
<script>
  const audio = document.querySelector<HTMLAudioElement>("[data-pronounce-audio]");
  document.querySelectorAll<HTMLButtonElement>("[data-pronounce]").forEach((b) => b.addEventListener("click", () => { if (!audio) return; audio.currentTime = 0; void audio.play(); }));
</script>
