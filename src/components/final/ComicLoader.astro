---
/** Preloader host. The intro ("The story so far", src/components/final/loaders/Story.astro) ships as an inert <template>
 *  that is cloned into this overlay and run. Desktop, first visit per session, never with reduced motion; the page renders
 *  underneath from the first frame. Any `?loader=` value replays it. */
import { getImage } from "astro:assets";
import portrait from "../../assets/portrait.jpg";
import Story from "./loaders/Story.astro";
const art = await getImage({ src: portrait, width: 520, height: 520, widths: [448], format: "webp" });
const DEFAULT = "s";
---
<div class="press fixed inset-0 z-[90]" data-preloader aria-hidden="true" data-portrait={art.src}>
  <Story />
  <p class="caption press-skip" data-skip>press any key · skip ▸</p>
</div>
<style is:global>
  .press { background:#0b0b0c; }
  .press-skip { position:absolute; right: clamp(1rem, 4vw, 3rem); bottom: clamp(1rem, 5vh, 3rem); opacity:0; transition: opacity .3s; transform:none; z-index:2; }
  .press-skip.is-on { opacity:1; }
  html.is-loading { overflow:hidden; }
</style>
<script define:vars={{ DEFAULT }}>
  const el = document.querySelector("[data-preloader]");
  const params = new URLSearchParams(location.search);
  const forced = params.get("loader");
  const variant = window.__loaders && window.__loaders[forced] ? forced : DEFAULT;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const phone = matchMedia("(max-width: 767px)").matches;
  const seen = sessionStorage.getItem("preloaded") === "1" && !forced;
  const ready = () => { if (ready.did) return; ready.did = true; document.documentElement.classList.remove("is-loading"); document.documentElement.classList.add("is-ready"); document.dispatchEvent(new Event("comic:ready")); };
  if (!el) {} else if (reduce || seen || phone || !window.__loaders || !window.__loaders[variant]) { el.remove(); ready(); }
  else {
    document.documentElement.classList.add("is-loading");
    sessionStorage.setItem("preloaded", "1");
    const tpl = el.querySelector(`template[data-loader="${variant}"]`);
    el.querySelectorAll("template").forEach((t) => t !== tpl && t.remove());
    el.insertBefore(tpl.content, el.firstChild); tpl.remove();
    const skip = el.querySelector("[data-skip]");
    let finished = false;
    const api = {
      root: el,
      portrait: el.dataset.portrait,
      ready,
      finish: (ms) => { if (finished) return; finished = true; ready(); setTimeout(() => el.remove(), ms || 0); },
      onSkip: (fn) => ["keydown", "pointerdown"].forEach((ev) => addEventListener(ev, () => { skip.style.opacity = "0"; fn(); }, { once: true })),
    };
    setTimeout(() => skip.classList.add("is-on"), 800);
    window.__loaders[variant](api);
  }
</script>
