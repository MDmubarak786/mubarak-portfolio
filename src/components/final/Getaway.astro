---
/** The getaway: the ways to reach me are balloons drifting over the back cover, and the hero runs along the ledge
 *  after whichever one the pointer is near, arm stretching toward it. Click (or tab to) a balloon to catch it: a
 *  sound-effect sticker, a jump, and the link opens. Leave them alone for a while and they start leaking out of the
 *  top; once they are all gone, R brings them back.
 *  Every balloon is a real link, so keyboards and readers get the same list the chase is built on. */
import HeroFigure from "./HeroFigure.astro";
import simple from "@iconify-json/simple-icons/icons.json";
interface Props { links: { label: string; href: string; external?: boolean; icon: string }[]; colors: string[] }
const { links, colors } = Astro.props;
const ENVELOPE = '<path d="M2 4h20a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm1 3.6V18h18V7.6l-9 5.6-9-5.6zM4.3 6l7.7 4.8L19.7 6H4.3z"/>';
const mark = (name: string) => name === "envelope" ? ENVELOPE : ((simple as any).icons[name]?.body ?? "");
// Text colour that reads on each balloon fill (ink everywhere except the purple).
const ink = (c: string) => (c.toLowerCase() === "#8338ec" ? "#fff" : "#111");
---
<div class="getaway" data-getaway>
  <span class="filetab">The getaway</span>
  <p class="caption getaway-hint" data-hint>Five ways to reach me, and they are drifting off. Catch one.</p>
  <div class="stage" data-stage role="group" aria-label="Ways to reach me">
    <svg class="cloud c1" viewBox="-6 -12 132 78" aria-hidden="true"><path d="M22 52a16 16 0 0 1 6-31 23 23 0 0 1 44-7 15 15 0 0 1 27 11 14 14 0 0 1 1 27Z" /></svg>
    <svg class="cloud c2" viewBox="-6 -12 132 78" aria-hidden="true"><path d="M22 52a16 16 0 0 1 6-31 23 23 0 0 1 44-7 15 15 0 0 1 27 11 14 14 0 0 1 1 27Z" /></svg>
    <svg class="cloud c3" viewBox="-6 -12 132 78" aria-hidden="true"><path d="M22 52a16 16 0 0 1 6-31 23 23 0 0 1 44-7 15 15 0 0 1 27 11 14 14 0 0 1 1 27Z" /></svg>
    {links.map((l, i) => (
      <a href={l.href} class="balloon" style={`--c:${colors[i % 5]};--ink:${ink(colors[i % 5])}`} data-balloon {...(/^https?:/.test(l.href) ? { target: "_blank", rel: "noopener" } : {})}>
        <svg class="mark" viewBox="0 0 24 24" aria-hidden="true" set:html={mark(l.icon)} /><span>{l.label}</span>
      </a>
    ))}
    <div class="ledge" aria-hidden="true"></div>
    <div class="catcher" data-hero><HeroFigure pose="reach" /></div>
    <div class="catch-fx sfx" data-pow aria-hidden="true">POW!</div>
    <div class="gone" data-gone hidden><p class="bubble text-lg"><strong data-gone-text>They all got away!</strong> <button type="button" class="btn sm ml-2" data-again>Again <kbd>R</kbd></button></p></div>
  </div>
</div>
<script>
  import { track, linkKind } from "../../lib/track";
  const root = document.querySelector<HTMLElement>("[data-getaway]");
  if (root) {
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const balloons = [...stage.querySelectorAll<HTMLAnchorElement>("[data-balloon]")];
    const hero = stage.querySelector<HTMLElement>("[data-hero]")!;
    const arm = hero.querySelector<SVGGElement>("[data-arm]")!;
    const pow = stage.querySelector<HTMLElement>("[data-pow]")!;
    const gone = stage.querySelector<HTMLElement>("[data-gone]")!;
    const goneText = gone.querySelector<HTMLElement>("[data-gone-text]")!;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const WORDS = ["POW!", "YOINK!", "GRAB!", "ZAP!", "WHAM!"];
    type B = { el: HTMLAnchorElement; x: number; y: number; vx: number; vy: number; r: number; live: boolean; held: boolean; phase: number; home: number };
    const bs: B[] = balloons.map((el, i) => ({ el, x: 0, y: 0, vx: 0, vy: 0, r: 48, live: true, held: false, phase: i * 1.3, home: 0.2 + (i % 3) * 0.17 }));
    let W = 0, H = 0, running = false, escaping = false, lastCatch = 0, raf = 0, last = 0, caught = 0, inView = false;
    // The hero: where he is, where the pointer wants him, and where the pointer is (for the arm).
    let hx = 0, tx = 0, px = -1, py = -1, pointerIn = false;
    const audio: Record<string, HTMLAudioElement> = {};
    let ac: AudioContext | null = null;
    const burst = () => {
      try { if (localStorage.getItem("mk-sound") === "off") return; } catch {}
      try {
        ac ??= new AudioContext(); if (ac.state === "suspended") ac.resume();
        const t = ac.currentTime, out = ac.createGain(); out.gain.value = 0.9; out.connect(ac.destination);
        // the crack: 70 ms of noise through a band-pass, snapped shut
        const len = Math.floor(ac.sampleRate * 0.09), buf = ac.createBuffer(1, len, ac.sampleRate), d = buf.getChannelData(0);
        for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 2.2);
        const n = ac.createBufferSource(); n.buffer = buf;
        const bp = ac.createBiquadFilter(); bp.type = "bandpass"; bp.frequency.setValueAtTime(2600 + Math.random() * 800, t); bp.frequency.exponentialRampToValueAtTime(900, t + 0.08); bp.Q.value = 0.8;
        const ng = ac.createGain(); ng.gain.setValueAtTime(1, t); ng.gain.exponentialRampToValueAtTime(0.001, t + 0.09);
        n.connect(bp).connect(ng).connect(out); n.start(t); n.stop(t + 0.1);
        // the thump: the rubber letting go
        const o = ac.createOscillator(); o.type = "sine"; o.frequency.setValueAtTime(190, t); o.frequency.exponentialRampToValueAtTime(55, t + 0.12);
        const og = ac.createGain(); og.gain.setValueAtTime(0.7, t); og.gain.exponentialRampToValueAtTime(0.001, t + 0.14);
        o.connect(og).connect(out); o.start(t); o.stop(t + 0.15);
      } catch {}
    };
    const sound = (name: string, vol = 0.5) => {
      try { if (localStorage.getItem("mk-sound") === "off") return; } catch {}
      const a = (audio[name] ??= new Audio(`/sfx/${name}.m4a`)); a.currentTime = 0; a.volume = vol; a.play().catch(() => {});
    };
    const place = (b: B) => {
      const tx = `${b.x - b.r}px`, ty = `${b.y - b.r}px`;
      b.el.style.transform = `translate3d(${tx}, ${ty}, 0)`; b.el.style.setProperty("--tx", tx); b.el.style.setProperty("--ty", ty);
      b.el.style.setProperty("--sway", `${Math.max(-28, Math.min(28, -b.vx * 0.35))}deg`);
    };
    const heroW = () => hero.getBoundingClientRect().width || 200;
    const placeHero = () => { hero.style.setProperty("--x", `${hx - heroW() / 2}px`); };
    const measure = () => { W = stage.clientWidth; H = stage.clientHeight; const r = W < 560 ? 34 : 48; bs.forEach((b) => { b.r = r; b.el.style.setProperty("--r", r + "px"); }); };
    const reset = () => {
      measure(); escaping = false; caught = 0; lastCatch = 0; gone.hidden = true; hint.textContent = "Five ways to reach me, and they are drifting off. Catch one.";
      const n = bs.length, pad = Math.min(70, bs[0].r + 12);
      bs.forEach((b, i) => { b.live = true; b.held = false; b.el.hidden = false; b.el.classList.remove("caught");
        b.home = 0.2 + (i % 3) * 0.17; b.x = pad + (W - 2 * pad) * (i + 0.5) / n; b.y = H * (0.55 + (i % 2) * 0.25); b.vx = (Math.random() - 0.5) * 40; b.vy = -60 - Math.random() * 30; place(b); });
      if (reduce) bs.forEach((b) => { b.y = H * 0.35; place(b); });
      hx = tx = Math.max(heroW() / 2, W * 0.18); placeHero();
    };
    const finish = (text: string) => { goneText.textContent = text; gone.hidden = false; hint.textContent = "Scroll down for the plain list, or press R."; };
    // The arm swings from the shoulder toward the pointer and stretches when the pointer is out of reach.
    const aim = () => {
      const hr = hero.getBoundingClientRect(), sr = stage.getBoundingClientRect();
      const sx = hr.left - sr.left + hr.width * (206 / 320), sy = hr.top - sr.top + hr.height * (222 / 550);
      if (!pointerIn) { arm.style.transform = ""; hero.style.setProperty("--lean", "0deg"); return; }
      const dx = px - sx, dy = py - sy, d = Math.hypot(dx, dy);
      const ang = Math.atan2(dx, -dy) * 180 / Math.PI;                                         // 0 = straight up
      const reach = 1 + 0.4 * Math.max(0, Math.min(1, (d - 90) / 240)) * (dy < 40 ? 1 : 0);   // stretch for the far ones
      arm.style.transform = `rotate(${Math.max(-70, Math.min(100, ang - 28))}deg) scale(${reach.toFixed(3)})`;
      hero.style.setProperty("--lean", `${Math.max(-7, Math.min(7, dx / 36))}deg`);
    };
    const step = (t: number) => {
      if (!running) return;
      const dt = Math.min(0.05, (t - last) / 1000 || 0.016); last = t;
      if (!escaping && lastCatch && t - lastCatch > 22000 && bs.some((b) => b.live)) { escaping = true; hint.textContent = "They're getting away! Grab one."; sound("whoosh", 0.35); }
      const live = bs.filter((b) => b.live && !b.held);
      for (const b of live) {
        b.phase += dt;
        // Each balloon bobs around its own float height; when they are escaping that height is above the ceiling.
        const home = escaping ? -160 : b.home * H;
        b.vy += (home - b.y) * (escaping ? 0.12 : 0.9) * dt + Math.cos(b.phase * 0.7) * 12 * dt;   // the escape is a slow leak, not a launch
        b.vx += Math.sin(b.phase * 0.5 + b.home * 9) * 22 * dt;
        b.vx *= 0.992; b.vy *= 0.985;
        if (!escaping && Math.random() < dt * 0.08) b.home = 0.14 + Math.random() * 0.5;   // drift to a new height now and then
        b.x += b.vx * dt; b.y += b.vy * dt;
        if (b.x < b.r) { b.x = b.r; b.vx = Math.abs(b.vx) * 0.8; } else if (b.x > W - b.r) { b.x = W - b.r; b.vx = -Math.abs(b.vx) * 0.8; }
        if (b.y > H - b.r - 24) { b.y = H - b.r - 24; b.vy = -Math.abs(b.vy) * 0.6; }
        if (b.y < b.r + 4) { if (escaping) { if (b.y < -b.r - 40) { b.live = false; b.el.hidden = true; } } else { b.y = b.r + 4; b.vy = Math.abs(b.vy) * 0.5 + 6; } }
      }
      for (let i = 0; i < live.length; i++) for (let j = i + 1; j < live.length; j++) {           // keep them off each other
        const a = live[i], c = live[j], dx = c.x - a.x, dy = c.y - a.y, d = Math.hypot(dx, dy) || 1, min = a.r + c.r + 6;
        if (d < min) { const push = (min - d) / 2, nx = dx / d, ny = dy / d; a.x -= nx * push; a.y -= ny * push; c.x += nx * push; c.y += ny * push;
          const dv = (c.vx - a.vx) * nx + (c.vy - a.vy) * ny; if (dv < 0) { a.vx += nx * dv * 0.9; a.vy += ny * dv * 0.9; c.vx -= nx * dv * 0.9; c.vy -= ny * dv * 0.9; } }
      }
      live.forEach(place);
      // The hero runs along the ledge toward the pointer.
      const half = heroW() / 2, goal = Math.max(half, Math.min(W - half, tx));
      const moving = Math.abs(goal - hx) > 4;
      if (moving) { hx += (goal - hx) * Math.min(1, 7 * dt); placeHero(); }
      hero.classList.toggle("run", moving);
      if (pointerIn) aim();
      if (!bs.some((b) => b.live)) { running = false; hero.classList.remove("run"); finish(caught ? "You caught them all. Nice reflexes." : "They all got away!"); return; }
      raf = requestAnimationFrame(step);
    };
    // The escape clock only runs while the stage is on screen.
    const start = () => { if (running || reduce) return; running = true; last = performance.now(); if (!lastCatch) lastCatch = last; raf = requestAnimationFrame(step); };
    const stop = () => { running = false; cancelAnimationFrame(raf); };
    stage.addEventListener("pointermove", (e) => { if (reduce) return; const r = stage.getBoundingClientRect(); px = e.clientX - r.left; py = e.clientY - r.top; tx = px; pointerIn = true; if (!running) aim(); });
    stage.addEventListener("pointerleave", () => { pointerIn = false; aim(); });
    bs.forEach((b) => {
      b.el.addEventListener("focus", () => { b.held = true; tx = b.x; });
      b.el.addEventListener("blur", () => { b.held = false; });
      b.el.addEventListener("click", (e) => {
        if (!b.live) return;
        // Let the catch play out before the link opens. Modified clicks (new tab by hand) keep the browser's own behaviour.
        if (!(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button)) {
          e.preventDefault();
          const href = b.el.href, blank = b.el.target === "_blank";
          setTimeout(() => { if (blank) window.open(href, "_blank", "noopener"); else location.href = href; }, 620);
        }
        b.live = false; lastCatch = performance.now(); track("getaway", "catch", b.el.getAttribute("aria-label") || b.el.textContent?.trim() || "");
        pow.textContent = WORDS[caught % WORDS.length]; caught++;
        pow.style.left = b.x + "px"; pow.style.top = b.y + "px"; pow.classList.remove("show"); void pow.offsetWidth; pow.classList.add("show");
        b.el.classList.add("caught"); setTimeout(() => { b.el.hidden = true; }, 420);
        burst();
        if (!reduce) { hero.classList.remove("grab"); void hero.offsetWidth; hero.classList.add("grab"); }
        if (!bs.some((x) => x.live)) setTimeout(() => finish("You caught them all. Nice reflexes."), 500);
      });
    });
    const again = () => { stop(); reset(); start(); };
    gone.querySelector("[data-again]")!.addEventListener("click", again);
    addEventListener("keydown", (e) => { if ((e.key === "r" || e.key === "R") && inView && !(e.target as HTMLElement).closest("input,textarea")) again(); });
    new IntersectionObserver((es) => es.forEach((e) => { inView = e.isIntersecting; if (e.isIntersecting) start(); else stop(); }), { threshold: 0.2 }).observe(stage);
    document.addEventListener("visibilitychange", () => { if (document.hidden) stop(); else if (inView) start(); });
    new ResizeObserver(() => { const w = W; measure(); if (w && W !== w) { bs.forEach((b) => { b.x = Math.min(Math.max(b.r, b.x * W / w), W - b.r); place(b); }); hx = tx = Math.min(hx, W - heroW() / 2); placeHero(); } }).observe(stage);
    reset();
  }
</script>
