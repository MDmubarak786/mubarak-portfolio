---
/** Off panel: what happens outside the frames. The list on the left, and a board of photo and clip stickers scattered
 *  across the right, each with a hand-lettered caption, a coloured pin and a slight tilt. From 768px the stickers can
 *  be dragged anywhere on the board (the one you touch comes to the front; a 1st-print stamp appears once you have
 *  moved something); on phones they sit in a loose two-column scatter. Clips are muted loops that play on hover, focus
 *  or tap and are fetched only when the chapter is near. Captions and the list are drafts in src/lib/offpanel.ts. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { stickers, loves } from "../../lib/offpanel";
interface Props { colors: string[] }
const { colors } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>("../../assets/offpanel/*.jpg", { eager: true });
const photo = (stem: string) => photos[`../../assets/offpanel/${stem}.jpg`]?.default;
const icons: Record<string, string> = {
  raft: "M3 14 q3 -3 6 0 t6 0 t6 0 M5 10 h14 l-2 4 H7 Z M9 7 l3 -3 3 3",
  boots: "M5 15 V7 h5 v4 h3 l4 2 v3 H5 Z M8 9 h2",
  ball: "M12 3 a9 9 0 1 0 0 18 a9 9 0 1 0 0 -18 M12 3 q4 4 0 9 t0 9 M3 12 h18",
  mic: "M12 3 a3 3 0 0 1 3 3 v5 a3 3 0 0 1 -6 0 V6 a3 3 0 0 1 3 -3 Z M7 11 a5 5 0 0 0 10 0 M12 16 v4 M9 20 h6",
  camera: "M4 8 h4 l2 -2 h4 l2 2 h4 v10 H4 Z M12 10 a3 3 0 1 0 0 6 a3 3 0 1 0 0 -6",
  sun: "M3 17 h18 M6 17 a6 6 0 0 1 12 0 M12 5 v2 M5 8 l1.5 1.5 M19 8 l-1.5 1.5",
  friends: "M8 7 a2.5 2.5 0 1 0 0 5 a2.5 2.5 0 1 0 0 -5 M16 7 a2.5 2.5 0 1 0 0 5 a2.5 2.5 0 1 0 0 -5 M3 19 a5 5 0 0 1 10 0 M11 19 a5 5 0 0 1 10 0",
};
---
<div class="panel op p-5 pt-8 sm:p-8 sm:pt-9" data-offpanel>
  <span class="filetab">Off panel</span>
  <div class="op-grid">
    <div class="op-list">
      <p class="caption">Still here? Good. This is the part with no deadlines.</p>
      <h3 class="text-3xl sm:text-4xl mt-4">Things I love doing</h3>
      <ul class="op-loves">
        {loves.map((l, i) => <li><svg viewBox="0 0 24 24" aria-hidden="true" style={`--c:${colors[i % 5]}`}><path d={icons[l.icon]} /></svg><span>{l.text}</span></li>)}
      </ul>
      <p class="op-hint text-sm text-[#555]"><span class="op-drag">Drag the stickers around. They stay where you leave them until you reload.</span><span class="op-tap">Tap a clip to play it.</span></p>
    </div>
    <div class="op-board" data-board-area>
      <span class="op-stamp bang" data-stamp hidden aria-hidden="true">1st print</span>
      <ul class="op-stickers">
        {stickers.map((s, i) => {
          const img = s.kind === "photo" ? photo(s.src) : undefined;
          const portrait = img ? img.height > img.width : true;
          return (
            <li class:list={["op-sticker", portrait ? "is-portrait" : "is-landscape"]} style={`--x:${s.x}%;--y:${s.y}%;--r:${s.r}deg;--w:${s.w}rem;--c:${colors[i % 5]}`} data-sticker>
              <span class="pin" aria-hidden="true"></span>
              {s.kind === "photo" && img && <Image src={img} alt={s.alt} widths={[320, 640]} sizes="(min-width: 1024px) 280px, 45vw" loading="lazy" class="op-img" />}
              {s.kind === "clip" && (
                <button type="button" class="op-clip" aria-pressed="false" aria-label={`Play clip: ${s.alt}`}>
                  <video muted loop playsinline preload="none" poster={`/offpanel/${s.src}.jpg`} data-src={`/offpanel/${s.src}.mp4`} class="op-img"></video>
                  <span class="op-live bang" aria-hidden="true">Live</span>
                </button>
              )}
              <span class="op-cap">{s.caption}</span>
            </li>
          );
        })}
      </ul>
      <button type="button" class="btn alt sm op-more" data-more>Show all {stickers.length} ▸</button>
    </div>
  </div>
</div>
<script>
  import { track, linkKind } from "../../lib/track";
  const root = document.querySelector<HTMLElement>("[data-offpanel]");
  if (root) {
    const board = root.querySelector<HTMLElement>("[data-board-area]")!;
    const stamp = root.querySelector<HTMLElement>("[data-stamp]")!;
    const items = [...root.querySelectorAll<HTMLElement>("[data-sticker]")];
    const fine = matchMedia("(pointer: fine) and (min-width: 768px)");
    let top = items.length;
    // Drag, from 768px with a mouse or pen: the sticker follows the pointer and comes to the front.
    items.forEach((el) => {
      let sx = 0, sy = 0, ox = 0, oy = 0, moved = false;
      el.addEventListener("pointerdown", (e) => {
        if (!fine.matches || e.button !== 0 || (e.target as Element).closest("button")) return;
        sx = e.clientX; sy = e.clientY; ox = parseFloat(el.dataset.dx ?? "0"); oy = parseFloat(el.dataset.dy ?? "0"); moved = false;
        el.classList.add("is-held"); el.style.zIndex = String(++top);
        try { el.setPointerCapture(e.pointerId); } catch {}
      });
      el.addEventListener("pointermove", (e) => {
        if (!el.classList.contains("is-held")) return;
        const dx = ox + e.clientX - sx, dy = oy + e.clientY - sy;
        el.dataset.dx = String(dx); el.dataset.dy = String(dy); el.style.setProperty("--dx", `${dx}px`); el.style.setProperty("--dy", `${dy}px`);
        if (Math.abs(e.clientX - sx) + Math.abs(e.clientY - sy) > 6 && !moved) { moved = true; if (stamp.hidden) track("offpanel", "drag"); stamp.hidden = false; }
      });
      const drop = () => el.classList.remove("is-held");
      el.addEventListener("pointerup", drop); el.addEventListener("pointercancel", drop);
      el.addEventListener("dragstart", (e) => e.preventDefault());
    });
    // Clips: fetched when the chapter is near, played on hover (fine pointers) or on tap.
    const more = root.querySelector<HTMLButtonElement>("[data-more]")!;
    more.addEventListener("click", () => { root.querySelector(".op-stickers")!.classList.add("is-all"); more.hidden = true; });
    const clips = [...root.querySelectorAll<HTMLButtonElement>(".op-clip")];
    const load = (v: HTMLVideoElement) => { if (!v.src && v.dataset.src) { v.src = v.dataset.src; v.load(); } };
    new IntersectionObserver((es, io) => { if (es.some((e) => e.isIntersecting)) { clips.forEach((b) => load(b.querySelector("video")!)); io.disconnect(); } }, { rootMargin: "400px" }).observe(board);
    clips.forEach((b) => {
      const v = b.querySelector("video")!;
      const play = () => { load(v); v.play().catch(() => {}); if (b.getAttribute("aria-pressed") !== "true") track("offpanel", "play", v.dataset.src?.split("/").pop() ?? ""); b.setAttribute("aria-pressed", "true"); };
      const stop = () => { v.pause(); b.setAttribute("aria-pressed", "false"); };
      b.addEventListener("click", () => (v.paused ? play() : stop()));
      b.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") play(); });
      b.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") stop(); });
      b.addEventListener("focus", play); b.addEventListener("blur", stop);
    });
    document.addEventListener("visibilitychange", () => { if (document.hidden) clips.forEach((b) => b.querySelector("video")!.pause()); });
  }
</script>
