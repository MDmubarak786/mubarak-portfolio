---
import { calendar } from "../../lib/calendar";
interface Props { showTotal?: boolean; totalClass?: string }
const { showTotal = false, totalClass = "" } = Astro.props;
const c = await calendar();
// The grid itself lives at /calendar.svg (see src/lib/calendar.ts) and is fetched when this slot comes near the
// viewport; the slot keeps the grid's aspect ratio, so mounting moves nothing.
---
<div class="w-full" style={`aspect-ratio:${c.w}/${c.h}`} data-calendar-slot></div>
<script is:inline>
  (function () {
    var slot = document.querySelector("[data-calendar-slot]");
    if (!slot) return;
    var mount = function () { fetch("/calendar.svg").then(function (r) { return r.text(); }).then(function (t) { slot.innerHTML = t; }).catch(function () {}); };
    if (!("IntersectionObserver" in window)) return mount();
    var io = new IntersectionObserver(function (entries) { if (entries.some(function (e) { return e.isIntersecting; })) { io.disconnect(); mount(); } }, { rootMargin: "800px" });
    io.observe(slot);
  })();
</script>
{showTotal && <p class={totalClass}>{c.total.toLocaleString("en-US")} contributions in the last twelve months{c.source === "fallback" ? ` (snapshot ${c.fetchedAt})` : ""}</p>}
<p class="sr-only">{c.total} contributions in the last twelve months.</p>
<span data-total hidden>{c.total}</span>
