        const warm = () => { if (!ended && step === 0) [`/music/${track}.m4a`, "/sfx/open.m4a", "/sfx/turn.m4a", "/sfx/cam.m4a"].forEach(prefetch); };
        if (document.readyState === "complete") setTimeout(warm, 300); else addEventListener("load", () => setTimeout(warm, 300), { once: true });
      }
      setTimeout(() => { skipBtn.classList.add("is-on"); soundBtn.classList.add("is-on"); }, 1200);
    })();
  };
</script>
