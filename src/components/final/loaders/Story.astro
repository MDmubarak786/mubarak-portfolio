---
/** Loader S, "The story so far": a ~34 s motion comic. A camera dollies in on the closed issue, the cover opens, and on
 *  each of seven spreads the camera lands on the art, glides to the story as it inks itself in, and pulls back for the
 *  page turn. Then it dives into the last page, ink floods it, the masthead plates stamp, and the ink drains off the real
 *  page. No on-screen controls beyond "Skip intro": a click, Esc or a scroll skips to the ink; → and ← turn pages.
 *  Pure CSS 3D + one SVG mask; every fact comes from the content collections. */
import { getCollection } from "astro:content";
import ComicArt from "../ComicArt.astro";
import { site, stats } from "../../../lib/site";
import { migration } from "../../../lib/story";
const witnesses = (await getCollection("witnesses")).sort((a, b) => a.data.order - b.data.order);
const lead = witnesses[0].data;
const initials = witnesses.map((w) => w.data.name.split(/\s+/).map((p) => p[0]).slice(0, 2).join(""));
const year = new Date().getFullYear();
type Art = { type: "year"; big: string; sub: string } | { type: "count"; value: number; dec: number; suffix: string; label: string; sub: string } | { type: "svg"; kind: "clock" | "bill"; label: string } | { type: "faces" } | { type: "portrait"; badge: string };
const pages: { tag: string; h: string; body: string; by?: string; sfx?: string; art: Art }[] = [
  { tag: "Chapter 0 · Origin", h: "Day one", body: `June 2021, ${"Incresco"}. A first engineering job, and an award for outstanding contribution before the year was out.`, sfx: "BOOT UP!", art: { type: "year", big: "2021", sub: "Episode one" } },
  { tag: "The platform", h: "One engineer, one front door", body: `Sole engineer on EF Academy's digital presence: ${stats[0].value} million monthly users in ${stats[1].value}+ languages, from one codebase.`, sfx: "WHOOSH!", art: { type: "count", value: stats[0].value, dec: 2, suffix: stats[0].suffix, label: "monthly users", sub: `${stats[1].value}+ languages` } },
  { tag: migration[0].t, h: "$24,000 a year", body: migration[0].s, sfx: "TICK… TOCK…", art: { type: "svg", kind: "clock", label: "Licence ends" } },
  { tag: "The cutover", h: "Beat the deadline", body: `Rebuilt on AWS Glue and finished before the contract ended. $24,000 a year became $840: a ${stats[2].value}% cut.`, sfx: "KA-CHING!", art: { type: "svg", kind: "bill", label: "$24,000 → $840" } },
  { tag: "The machines read", h: "17 document types", body: "GPT-4 Vision plus OCR for admissions paperwork: 17+ document types at 95% accuracy, manual entry down 70%.", sfx: "ZAP!", art: { type: "count", value: 95, dec: 0, suffix: "%", label: "accuracy", sub: "17+ document types" } },
  { tag: "The witnesses", h: `${witnesses.length} on record`, body: `“${lead.pull}”`, by: `${lead.name}, ${lead.title}, ${lead.organisation}`, art: { type: "faces" } },
  { tag: "Today", h: site.role, body: `May 2026: ${site.employer}, Chennai. AI inside enterprise software, and notes for ${site.followers.replace("K+", ",000+")} developers on the side.`, sfx: "TO BE CONTINUED…", art: { type: "portrait", badge: String(year) } },
];
const N = pages.length;
const colors = ["#ff2e63", "#1b998b", "#ffb703", "#3a86ff", "#8338ec"];
---
<template data-loader="s">
  <div class="st-stage" data-stage>
    <p class="st-presents">MK Comics presents</p>
    <div class="st-cam" data-cam>
      <div class="st-float">
        <div class="st-shift" data-shift>
          <div class="st-book" data-book>
            <div class="st-base"><div class="st-face st-text" data-text={N}>
              <p class="st-tag">{pages[N - 1].tag}</p><h3 class="st-h">{pages[N - 1].h}</h3><p class="st-body">{pages[N - 1].body}</p>
              {pages[N - 1].sfx && <p class="st-sfx st-sfx-end">{pages[N - 1].sfx}</p>}<span class="st-num">{N}</span>
            </div></div>
            {Array.from({ length: N }, (_, i) => {
              const art = pages[i].art; // the back of leaf i is the art for page i+1
              return (
                <div class="st-leaf" data-leaf style={`--z:${(N - i) * 1.2}px`}>
                  {i === 0 ? (
                    <div class="st-face st-front st-cover">
                      <div class="st-mast"><span>MK</span> <span class="pink">COMICS</span></div>
                      <div class="st-meta"><span>No. 1</span><span>{year} edition</span><span>The story so far</span></div>
                      <img class="st-cover-art" alt="" data-portrait-img width="520" height="520" />
                      <div class="st-burst">{site.role}</div>
                      <div class="st-title">The Full-Stack<br />+ AI Chronicles</div>
                    </div>
                  ) : (
                    <div class="st-face st-front st-text" data-text={i}>
                      <p class="st-tag">{pages[i - 1].tag}</p><h3 class="st-h">{pages[i - 1].h}</h3><p class="st-body">{pages[i - 1].body}</p>
                      {pages[i - 1].by && <p class="st-by">— {pages[i - 1].by}</p>}
                      {pages[i - 1].sfx && <p class="st-sfx">{pages[i - 1].sfx}</p>}<span class="st-num">{i}</span>
                    </div>
                  )}
                  <div class="st-face st-back st-art" data-art={i + 1}>
                    {art.type === "year" && <><p class="st-big">{art.big}</p><p class="caption st-cap">{art.sub}</p></>}
                    {art.type === "count" && <><p class="st-big st-count" data-count={art.value} data-dec={art.dec} data-suffix={art.suffix}>{art.value}{art.suffix}</p><p class="st-label">{art.label}</p><p class="caption st-cap">{art.sub}</p></>}
                    {art.type === "svg" && <><ComicArt kind={art.kind} class={`st-svg st-svg-${art.kind}`} /><p class="caption st-cap">{art.label}</p></>}
                    {art.type === "faces" && <div class="st-faces">{initials.map((t, j) => <span style={`--i:${j};background:${colors[j % 5]}`}>{t}</span>)}</div>}
                    {art.type === "portrait" && <div class="st-port"><img alt="" data-portrait-img width="520" height="520" /><span class="st-badge">{art.badge}</span></div>}
                    <span class="st-num st-num-l">{i + 1}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
        <div class="st-shadow"></div>
      </div>
    </div>
    <div class="st-vig"></div>
    <div class="st-grain"></div>
  </div>
  <svg class="st-ink" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id="st-f" x="-30%" y="-30%" width="160%" height="160%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="2" data-turb /><feDisplacementMap in="SourceGraphic" scale="14" xChannelSelector="R" yChannelSelector="G" /></filter>
      <mask id="st-m"><rect width="100" height="100" fill="#000" /><circle cx="50" cy="48" r="0" fill="#fff" filter="url(#st-f)" data-blob /></mask>
    </defs>
    <rect width="100" height="100" fill="#0b0b0c" mask="url(#st-m)" />
  </svg>
  <div class="st-plates" data-plates><span class="p1">MK COMICS</span><span class="p2">MK COMICS</span><span class="p3">MK COMICS</span><span class="p4">MK COMICS</span></div>
  <p class="st-plates-sub" data-plates-sub>Issue #1 · now reading</p>
  <div class="st-bars" data-bars></div>
  <button type="button" tabindex="-1" class="st-skip" data-skipintro>Skip intro <span aria-hidden="true">›</span></button>
</template>
<style is:global>
  .st-stage { position:absolute; inset:0; display:grid; place-items:center; background: radial-gradient(ellipse at 50% 42%, #29292c, #0b0b0c 70%); opacity:0; transition: opacity .8s; overflow:hidden; }
  .st-stage.is-in { opacity:1; }
  .st-presents { position:absolute; top: 12vh; left:0; right:0; text-align:center; margin:0; z-index:2; font-family: var(--font-bangers); letter-spacing:.32em; font-size: clamp(.9rem, 1.4vw, 1.2rem); color:#ffb703; opacity:0; transform: translateY(-8px); transition: opacity .8s .6s, transform .8s .6s; }
  .st-stage.is-in .st-presents { opacity:1; transform:none; }
  .st-stage.is-open .st-presents { opacity:0; transition-delay:0s; transition-duration:.4s; }
  .st-cam { position:relative; transform: scale(.82); }
  .st-float { position:relative; animation: st-float 6s ease-in-out infinite; }
  @keyframes st-float { 50% { transform: translateY(-8px) rotate(.3deg); } }
  .st-shift { perspective: 1800px; transition: transform 1s cubic-bezier(.66,0,.3,1); }
  .st-shift.is-open { transform: translateX(50%); }
  .st-book { position:relative; width: min(calc(74vh * .72), 440px, 42vw); aspect-ratio:.72; transform-style: preserve-3d; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .4s ease-out; }
  .st-shadow { position:absolute; left:50%; bottom:-7%; width:80%; height:9%; translate:-50% 0; background: radial-gradient(closest-side, rgba(0,0,0,.65), transparent); filter: blur(6px); transition: width 1s cubic-bezier(.66,0,.3,1); }
  .st-shift.is-open + .st-shadow { width:170%; }
  .st-base, .st-leaf { position:absolute; inset:0; transform-style: preserve-3d; }
  .st-base { transform: translateZ(0); box-shadow: 3px 0 0 #ece2cc, 6px 0 0 #ded3bb, 9px 0 0 #111; }
  .st-leaf { transform-origin: left center; transform: rotateY(0deg) translateZ(var(--z)); transition: transform 1.1s cubic-bezier(.45,.05,.22,1); }
  .st-leaf.is-flipped { transform: rotateY(-180deg) translateZ(var(--z)); }
  .st-face { position:absolute; inset:0; backface-visibility:hidden; -webkit-backface-visibility:hidden; border:3px solid #111; overflow:hidden; container-type:size; background:#fff8e7; color:#111; }
  .st-face::after { content:""; position:absolute; inset:0; pointer-events:none; opacity:0; background: linear-gradient(90deg, rgba(0,0,0,.35), rgba(0,0,0,0) 40%, rgba(255,255,255,.25) 60%, rgba(0,0,0,.2)); }
  .st-leaf.is-turning .st-face::after { animation: st-shade 1.1s ease-in-out; }
  @keyframes st-shade { 50% { opacity:1; } }
  .st-back { transform: rotateY(180deg); }
  /* Cover */
  .st-cover { background: radial-gradient(#111 .7px, transparent .8px) 0 0 / 6px 6px, #fff8e7; display:grid; grid-template-rows: auto auto 1fr auto auto; padding: 3.2cqw 3.6cqw 3.8cqw; gap: 1.6cqw; }
  .st-cover::before { content:""; position:absolute; inset:0; background: linear-gradient(112deg, rgba(255,255,255,0) 40%, rgba(255,255,255,.45) 50%, rgba(255,255,255,0) 60%); background-size: 260% 100%; background-position: var(--gx, 60%) 0; pointer-events:none; mix-blend-mode: screen; z-index:1; transition: background-position .4s ease-out; }
  .st-mast { font-family: var(--font-bangers); font-size: 15cqw; line-height:.9; letter-spacing:.02em; }
  .st-mast .pink, .st-title { color:#ff2e63; -webkit-text-stroke: .3cqw #111; }
  .st-meta { display:flex; justify-content:space-between; font-family: var(--font-bangers); font-size:3.4cqw; letter-spacing:.08em; border-top:.6cqw solid #111; border-bottom:.6cqw solid #111; padding:.6cqw 0; }
  .st-cover-art { width:100%; height:100%; object-fit:cover; border:.8cqw solid #111; box-shadow: 1.4cqw 1.4cqw 0 #111; min-height:0; }
  .st-burst { justify-self:start; background:#ffb703; border:.5cqw solid #111; padding:.6cqw 2cqw; font-family: var(--font-bangers); font-size:3.6cqw; letter-spacing:.06em; transform: rotate(-2deg); }
  .st-title { font-family: var(--font-bangers); font-size: 10cqw; line-height:.95; text-shadow: .9cqw .9cqw 0 #111; }
  /* Story page */
  .st-text { padding: 7cqw 7cqw 6cqw; display:flex; flex-direction:column; gap: 3cqw; background: radial-gradient(rgba(17,17,17,.12) .7px, transparent .8px) 0 0 / 6px 6px, #fff8e7; }
  .st-tag { align-self:flex-start; margin:0; background:#fff3b0; border:.6cqw solid #111; padding:.6cqw 2.2cqw; font-family: var(--font-patrick); font-size:4.8cqw; transform: rotate(-1deg); }
  .st-h { margin:0; font-family: var(--font-bangers); font-weight:400; font-size: 14cqw; line-height:.92; color:#ff2e63; -webkit-text-stroke: .35cqw #111; text-shadow: .8cqw .8cqw 0 #111; }
  .st-body { margin:0; font-family: var(--font-patrick); font-size: 6.6cqw; line-height:1.3; }
  .st-by { margin:0; font-family: var(--font-patrick); font-size: 4.8cqw; opacity:.75; }
  .st-sfx { margin: auto 0 0 auto; font-family: var(--font-bangers); font-size: 13cqw; line-height:1; color:#ffb703; -webkit-text-stroke: .4cqw #111; text-shadow: 1cqw 1cqw 0 #111; transform: rotate(-7deg); }
  .st-sfx-end { color:#ff2e63; font-size: 11cqw; }
  .st-num { position:absolute; bottom: 2.4cqw; right: 3.4cqw; font-family: var(--font-bangers); font-size: 3.6cqw; opacity:.6; }
  .st-num-l { right:auto; left: 3.4cqw; }
  /* Art page */
  .st-art { display:grid; place-items:center; align-content:center; gap: 3cqw; padding: 6cqw; background: radial-gradient(#111 .8px, transparent .9px) 0 0 / 7px 7px, #fff3b0; }
  .st-big { margin:0; font-family: var(--font-bangers); font-size: 30cqw; line-height:.9; color:#fff8e7; -webkit-text-stroke: .7cqw #111; text-shadow: 2cqw 2cqw 0 #ff2e63; }
  .st-count { font-size: 25cqw; }
  .st-label { margin:0; font-family: var(--font-bangers); font-size: 7cqw; letter-spacing:.06em; }
  .st-cap { font-size: 4.4cqw !important; }
  .st-svg { width: 66cqw; height:auto; background:#fff; border:.8cqw solid #111; box-shadow: 1.6cqw 1.6cqw 0 #111; padding: 3cqw; }
  .st-faces { display:grid; grid-template-columns: repeat(3, 1fr); gap: 4cqw; }
  .st-faces span { width: 20cqw; aspect-ratio:1; border-radius:50%; border:.8cqw solid #111; display:grid; place-items:center; font-family: var(--font-bangers); font-size: 7cqw; color:#111; box-shadow: 1cqw 1cqw 0 #111; }
  .st-port { position:relative; width: 74cqw; }
  .st-port img { display:block; width:100%; aspect-ratio:1; object-fit:cover; border: .9cqw solid #111; box-shadow: 2cqw 2cqw 0 #111; }
  .st-badge { position:absolute; top:-5cqw; right:-5cqw; width: 22cqw; aspect-ratio:1; display:grid; place-items:center; background:#ffb703; clip-path: polygon(50% 0, 61% 33%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 33%); font-family: var(--font-bangers); font-size: 6cqw; }
  /* Pages ink themselves in when the camera arrives: hidden until live, held once seen. */
  .st-text > :not(.st-num), .st-art > :not(.st-num) { opacity:0; }
  .st-text.is-live > *, .st-text.is-seen > *, .st-art.is-live > *, .st-art.is-seen > * { opacity:1; }
  .st-text.is-live .st-tag { animation: st-up .45s ease-out .1s both; }
  .st-text.is-live .st-h { animation: st-slam .55s cubic-bezier(.2,.9,.25,1.25) .3s both; }
  .st-text.is-live .st-body, .st-text.is-live .st-by { animation: st-type 1s steps(18) .75s both; }
  .st-text.is-live .st-sfx { animation: st-pop .6s cubic-bezier(.2,.9,.3,1.6) 1.5s both; }
  .st-art.is-live .st-big, .st-art.is-live .st-svg, .st-art.is-live .st-port { animation: st-pop .7s cubic-bezier(.2,.9,.3,1.4) .1s both; }
  .st-art.is-live .st-svg-clock { animation: st-pop .7s cubic-bezier(.2,.9,.3,1.4) .1s both, st-tick 1s steps(1) .9s infinite; }
  .st-art.is-live .st-label, .st-art.is-live .st-cap { animation: st-up .5s ease-out .55s both; }
  .st-art.is-live .st-faces span { animation: st-pop .45s cubic-bezier(.2,.9,.3,1.6) calc(.15s + var(--i) * .09s) both; }
  @keyframes st-slam { from { opacity:0; transform: translateY(-25%) scale(1.35) rotate(-4deg); } }
  @keyframes st-up { from { opacity:0; transform: translateY(14px); } }
  @keyframes st-type { from { clip-path: inset(0 0 100% 0); } }
  @keyframes st-pop { 0% { opacity:0; transform: scale(.2) rotate(-12deg); } 70% { opacity:1; transform: scale(1.08) rotate(2deg); } }
  @keyframes st-tick { 0% { rotate: -1.5deg; } 50% { rotate: 1.5deg; } }
  /* Film: vignette, grain, letterbox */
  .st-vig { position:absolute; inset:0; pointer-events:none; background: radial-gradient(ellipse at 50% 50%, transparent 52%, rgba(0,0,0,.6)); z-index:2; }
  .st-grain { position:absolute; inset:-50%; pointer-events:none; z-index:2; opacity:.09; mix-blend-mode: overlay; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); animation: st-grain .6s steps(6) infinite; }
  @keyframes st-grain { 0% { transform: translate(0,0) } 20% { transform: translate(-4%,3%) } 40% { transform: translate(3%,-5%) } 60% { transform: translate(-6%,-2%) } 80% { transform: translate(5%,4%) } 100% { transform: translate(-2%,6%) } }
  .st-bars { position:absolute; inset:0; pointer-events:none; z-index:6; }
  .st-bars::before, .st-bars::after { content:""; position:absolute; left:0; right:0; height: 8.5vh; background:#000; transition: transform 1s cubic-bezier(.7,0,.25,1); }
  .st-bars::before { top:0; transform: translateY(-100%); }
  .st-bars::after { bottom:0; transform: translateY(100%); }
  .st-bars.is-in::before, .st-bars.is-in::after { transform:none; }
  .st-bars.is-out::before { transform: translateY(-100%); } .st-bars.is-out::after { transform: translateY(100%); }
  .st-skip { position:absolute; right: clamp(1rem, 3vw, 2.5rem); bottom: 2.6vh; z-index:7; background:none; border:0; padding:.3rem .2rem; cursor:pointer; font: 500 .8rem/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing:.14em; text-transform:uppercase; color: rgba(255,248,231,.62); opacity:0; transition: opacity .6s, color .2s; }
  .st-skip.is-on { opacity:1; }
  .st-skip:hover { color:#fff8e7; }
  .st-skip.is-off { opacity:0; pointer-events:none; }
  /* Ink ending */
  .st-ink { position:absolute; inset:0; width:100%; height:100%; display:block; pointer-events:none; z-index:3; }
  .st-plates { position:absolute; left:50%; top:46%; translate:-50% -50%; z-index:4; font-family: var(--font-bangers); font-size: clamp(3rem, 11vw, 11rem); line-height:1; letter-spacing:.02em; white-space:nowrap; width:max-content; opacity:0; transition: opacity .25s; pointer-events:none; }
  .st-plates.is-on { opacity:1; }
  .st-plates.is-off { opacity:0; transition: opacity .3s; }
  .st-plates span { position:absolute; left:0; top:0; mix-blend-mode: screen; transition: transform .7s cubic-bezier(.2,.9,.25,1.2); }
  .st-plates .p1 { color:#ff2e63; transform: translate(-22px, 10px) rotate(-1.5deg); }
  .st-plates .p2 { color:#ffb703; transform: translate(18px, -12px) rotate(1.2deg); }
  .st-plates .p3 { color:#1b998b; transform: translate(6px, 16px); }
  .st-plates .p4 { position:relative; color:#fff8e7; opacity:0; mix-blend-mode:normal; transition: opacity .25s ease .55s; -webkit-text-stroke: 2px #111; text-shadow: 8px 8px 0 #ff2e63; }
  .st-plates.is-reg .p1, .st-plates.is-reg .p2, .st-plates.is-reg .p3 { transform:none; }
  .st-plates.is-reg .p4 { opacity:1; }
  .st-plates-sub { position:absolute; left:50%; top: calc(46% + 7vw); translate:-50% 0; margin:0; z-index:4; font-family: var(--font-bangers); font-size: clamp(1rem, 2vw, 1.6rem); letter-spacing:.08em; color:#ffb703; opacity:0; transition: opacity .3s; pointer-events:none; }
  .st-plates-sub.is-on { opacity:1; }
</style>
<script is:inline define:vars={{ N }}>
  window.__loaders = window.__loaders || {};
  window.__loaders.s = (api) => {
    const root = api.root, $ = (q) => root.querySelector(q);
    $("[data-skip]")?.remove();
    const stage = $("[data-stage]"), cam = $("[data-cam]"), shift = $("[data-shift]"), book = $("[data-book]"), bars = $("[data-bars]"), skipBtn = $("[data-skipintro]");
    const leaves = [...root.querySelectorAll("[data-leaf]")];
    root.querySelectorAll("[data-portrait-img]").forEach((i) => { i.src = api.portrait; });

    // Step 0 is the closed cover; steps 1..N are spreads. Each spread has its own length (ms).
    const DUR = [3400, 4100, 3700, 3900, 3700, 3500, 4200, 4100];
    // Camera framings. `art` centres the left page, `text` the top of the right page.
    const CAM = { far: "scale(.82)", near: "scale(1.07)", wide: "none", art: "scale(1.42) translate(50%, 0)", text: "scale(1.32) translate(-50%, 9%)" };
    const camTo = (name, ms, ease = "cubic-bezier(.65,0,.35,1)") => { cam.style.transition = ms ? `transform ${ms}ms ${ease}` : "none"; cam.style.transform = CAM[name]; };

    let step = -1, ended = false, beats = [], stepAt = 0, offset = 0;
    const pageEls = (k) => [root.querySelector(`[data-text="${k}"]`), root.querySelector(`[data-art="${k}"]`)];
    const countUp = (el) => {
      const to = Number(el.dataset.count), dec = Number(el.dataset.dec || 0), suf = el.dataset.suffix || "", t0 = performance.now() + 250, d = 1200;
      el.textContent = (0).toFixed(dec) + suf;
      const tick = (now) => { if (ended) return; const p = Math.max(0, Math.min(1, (now - t0) / d)); el.textContent = (to * (1 - Math.pow(1 - p, 3))).toFixed(dec) + suf; if (p < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    };
    const setState = (el, state) => {
      if (!el) return;
      el.classList.remove("is-live", "is-seen");
      if (state === "live") { void el.offsetWidth; el.classList.add("is-live"); el.querySelectorAll("[data-count]").forEach(countUp); }
      else if (state === "seen") el.classList.add("is-seen");
    };
    // The beats of one step, in ms from the step's start.
    const plan = (k) => {
      const d = DUR[k];
      if (k === 0) return [{ at: 0, run: () => { camTo("far", 0); requestAnimationFrame(() => requestAnimationFrame(() => camTo("near", d + 800, "cubic-bezier(.3,.1,.3,1)"))); } }, { at: d, run: () => go(1) }];
      const [text, art] = pageEls(k), toArt = 1050, toText = Math.round(toArt + (d - toArt) * 0.4), back = d - 950;
      return [
        { at: 0, run: () => camTo("wide", 950) },
        { at: toArt, run: () => { camTo("art", 1250); setState(art, "live"); } },
        { at: toText, run: () => { camTo("text", 1350); setState(text, "live"); } },
        { at: back, run: () => camTo("wide", 950) },
        { at: d, run: () => (k < N ? go(k + 1) : end()) },
      ];
    };
    const clearBeats = () => { beats.forEach(clearTimeout); beats = []; };
    const run = (k, from) => {
      clearBeats(); stepAt = performance.now() - from;
      for (const b of plan(k)) { if (b.at < from) continue; if (b.at === 0) b.run(); else beats.push(setTimeout(b.run, b.at - from)); }
    };
    const go = (k) => {
      if (ended) return;
      k = Math.max(0, Math.min(N, k));
      if (k === step) return;
      leaves.forEach((l, i) => {
        const flip = i < k;
        if (flip !== l.classList.contains("is-flipped")) { l.classList.add("is-turning"); setTimeout(() => l.classList.remove("is-turning"), 1150); }
        l.classList.toggle("is-flipped", flip);
      });
      shift.classList.toggle("is-open", k > 0); stage.classList.toggle("is-open", k > 0);
      for (let i = 1; i <= N; i++) pageEls(i).forEach((e) => setState(e, i < k ? "seen" : null));
      step = k; run(k, 0);
    };
    // A hidden tab holds the story where it was.
    const onVis = () => { if (ended || step < 0) return; if (document.hidden) { offset = performance.now() - stepAt; clearBeats(); } else run(step, offset); };
    document.addEventListener("visibilitychange", onVis);

    // Ending: dive into the page, ink floods it, the plates stamp, the ink drains off the real page.
    const blob = $("[data-blob]"), turb = $("[data-turb]"), plates = $("[data-plates]"), platesSub = $("[data-plates-sub]");
    const clamp01 = (v) => Math.max(0, Math.min(1, v)), smooth = (p) => p * p * (3 - 2 * p), easeIn = (p) => p * p * p;
    const anim = (ms, fn) => new Promise((res) => { const t0 = performance.now(); let seed = 2; const f = (now) => { const p = clamp01((now - t0) / ms); if (((now / 40) | 0) % 2) turb.setAttribute("seed", String(seed = (seed % 40) + 1)); fn(p); if (p < 1) requestAnimationFrame(f); else res(); }; requestAnimationFrame(f); });
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));
    const end = async () => {
      if (ended) return; ended = true; clearBeats(); detach(); document.removeEventListener("visibilitychange", onVis);
      skipBtn.classList.add("is-off");
      // Measure the page with the camera at rest, then fly from wherever the camera is now.
      const cur = getComputedStyle(cam).transform;
      book.style.transition = "none"; book.style.setProperty("--rx", "0deg"); book.style.setProperty("--ry", "0deg");
      cam.style.transition = "none"; cam.style.transform = "none";
      const b = book.getBoundingClientRect(), c = cam.getBoundingClientRect();
      cam.style.transform = cur === "none" ? "none" : cur; void cam.offsetWidth;
      const s = Math.max(innerWidth / b.width, innerHeight / b.height) * 1.3;
      const ox = c.left + c.width / 2, oy = c.top + c.height / 2, bx = b.left + b.width / 2, by = b.top + b.height / 2;
      cam.style.transition = "transform .95s cubic-bezier(.7,0,.25,1)";
      cam.style.transform = `translate(${innerWidth / 2 - ox - s * (bx - ox)}px, ${innerHeight / 2 - oy - s * (by - oy)}px) scale(${s})`;
      await wait(700);
      await anim(1000, (p) => blob.setAttribute("r", String(92 * smooth(p))));
      stage.style.display = "none"; root.style.background = "transparent";
      plates.classList.add("is-on"); await wait(120); plates.classList.add("is-reg"); platesSub.classList.add("is-on");
      await wait(1150);
      api.ready();
      plates.classList.add("is-off"); platesSub.classList.remove("is-on"); bars.classList.add("is-out");
      blob.setAttribute("cx", "84"); blob.setAttribute("cy", "-6");
      await anim(1150, (p) => blob.setAttribute("r", String(150 * (1 - easeIn(p)))));
      api.finish(30);
    };

    // Input, captured at the window so the page underneath (and its smooth scroller) never sees it.
    const onKey = (e) => {
      const k = e.key;
      if (k === "ArrowRight" || k === " " || k === "Enter" || k === "PageDown") { e.preventDefault(); e.stopImmediatePropagation(); step >= N ? end() : go(step + 1); }
      else if (k === "ArrowLeft" || k === "PageUp") { e.preventDefault(); e.stopImmediatePropagation(); go(step - 1); }
      else if (k === "Escape" || k.toLowerCase() === "s") { e.preventDefault(); e.stopImmediatePropagation(); end(); }
    };
    const onWheel = (e) => { e.preventDefault(); e.stopImmediatePropagation(); end(); };
    const onTouch = (e) => { e.stopImmediatePropagation(); end(); };
    const onDown = (e) => { e.stopImmediatePropagation(); end(); };
    const tilt = (e) => {
      if (ended) return;
      const k = step > 0 ? 0.2 : 1;
      book.style.setProperty("--rx", `${((e.clientY / innerHeight) - 0.5) * -20 * k}deg`);
      book.style.setProperty("--ry", `${((e.clientX / innerWidth) - 0.5) * 26 * k}deg`);
      leaves[0].querySelector(".st-cover")?.style.setProperty("--gx", `${30 + (e.clientX / innerWidth) * 60}%`);
    };
    addEventListener("keydown", onKey, true);
    addEventListener("wheel", onWheel, { capture: true, passive: false });
    addEventListener("touchmove", onTouch, { capture: true, passive: true });
    root.addEventListener("pointerdown", onDown);
    addEventListener("pointermove", tilt, { passive: true });
    function detach() {
      removeEventListener("keydown", onKey, true); removeEventListener("wheel", onWheel, true); removeEventListener("touchmove", onTouch, true);
      root.removeEventListener("pointerdown", onDown); removeEventListener("pointermove", tilt);
    }

    (async () => {
      if (document.hidden) await new Promise((r) => document.addEventListener("visibilitychange", () => { if (!document.hidden) r(); }));
      // `&page=7` opens straight at a spread (design review only).
      const first = Math.max(0, Math.min(N, Number(new URLSearchParams(location.search).get("page")) || 0));
      requestAnimationFrame(() => { stage.classList.add("is-in"); bars.classList.add("is-in"); go(first); });
      setTimeout(() => skipBtn.classList.add("is-on"), 1200);
    })();
  };
</script>
