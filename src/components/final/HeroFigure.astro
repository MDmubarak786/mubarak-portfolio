---
/** The hero: a photo head on a hand-inked comic body. `pose` sets the arms; `gear` adds the nine power-up layers that
 *  PowerUps.astro switches between (all hidden until one is chosen). The shirt colour is --shirt on the <svg>. */
import { getImage } from "astro:assets";
import headCut from "../../assets/head.png";
interface Props { pose?: "stand" | "reach"; gear?: boolean; class?: string }
const { pose = "stand", gear = false, class: cls = "" } = Astro.props;
const head = await getImage({ src: headCut, width: 300, format: "webp" });   // 828×1195 cut-out, keeps its alpha
// Ids are per instance: two figures share one document, and a clipPath id must not collide.
const uid = `hf-${pose}${gear ? "-gear" : ""}`;
const ink = "#111", skin = "#b9743f";
// Arms as polylines from the shoulder; the right arm is one group so a script can swing it from the shoulder.
const arms = pose === "reach"
  ? { l: "104,162 64,104 46,34", r: "196,162 236,104 254,34", lh: [42, 26], rh: [258, 26] }
  : { l: "104,162 58,232 36,292", r: "196,162 242,232 264,292", lh: [32, 300], rh: [268, 300] };
---
<svg viewBox="-10 -60 320 550" class:list={["hero-figure", cls]} data-pose={pose} aria-hidden="true" fill="none" stroke={ink} stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
  <defs>
    <filter id={`${uid}-sticker`} x="-12%" y="-8%" width="124%" height="116%" color-interpolation-filters="sRGB">
      <feMorphology in="SourceAlpha" operator="dilate" radius="4" result="ink" /><feFlood flood-color="#111" /><feComposite in2="ink" operator="in" result="inkL" />
      <feMorphology in="SourceAlpha" operator="dilate" radius="2.2" result="w" /><feFlood flood-color="#fff" /><feComposite in2="w" operator="in" result="wL" />
      <feMerge><feMergeNode in="inkL" /><feMergeNode in="wL" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    <pattern id={`${uid}-dots`} width="7" height="7" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.5" fill={ink} opacity=".35" /></pattern>
  </defs>
  <ellipse cx="150" cy="456" rx="96" ry="11" fill={`url(#${uid}-dots)`} stroke="none" />
  {gear && <g class="gear-back">
    <!-- 3 · the data pack -->
    <g data-gear="3" hidden><path d="M118 168 L96 262 M182 168 L204 262" stroke-width="8" /><rect x="206" y="176" width="54" height="56" rx="8" fill="#8338ec" /><ellipse cx="233" cy="176" rx="27" ry="11" fill="#c9a7ff" /><rect x="206" y="236" width="54" height="52" rx="8" fill="#8338ec" /><ellipse cx="233" cy="236" rx="27" ry="11" fill="#c9a7ff" /><rect x="40" y="176" width="54" height="56" rx="8" fill="#8338ec" /><ellipse cx="67" cy="176" rx="27" ry="11" fill="#c9a7ff" /></g>
    <!-- 4 · the cape -->
    <g data-gear="4" hidden><path d="M106 150 Q58 250 44 404 Q150 436 256 404 Q242 250 194 150 Z" fill="#3a86ff" /><path d="M72 300 l28 -36 l-10 30 l30 -12 l-40 46 l8 -30 Z" fill="#ffb703" stroke-width="4" /><path d="M228 300 l-28 -36 l10 30 l-30 -12 l40 46 l-8 -30 Z" fill="#ffb703" stroke-width="4" /></g>
  </g>}
  <!-- body -->
  <polyline points={arms.l} stroke-width="40" /><polyline points={arms.l} stroke="var(--shirt, #1b998b)" stroke-width="28" />
  <g class="arm-r" data-arm>
    <polyline points={arms.r} stroke-width="40" /><polyline points={arms.r} stroke="var(--shirt, #1b998b)" stroke-width="28" />
    <circle cx={arms.rh[0]} cy={arms.rh[1]} r="17" fill={skin} />
  </g>
  <circle cx={arms.lh[0]} cy={arms.lh[1]} r="17" fill={skin} />
  <rect x="108" y="296" width="40" height="126" rx="16" fill="#243b53" /><rect x="152" y="296" width="40" height="126" rx="16" fill="#243b53" />
  <rect x="92" y="412" width="64" height="32" rx="15" fill="#ff2e63" /><rect x="92" y="424" width="26" height="20" rx="10" fill="#fff" stroke-width="4" />
  <rect x="144" y="412" width="64" height="32" rx="15" fill="#ff2e63" /><rect x="182" y="424" width="26" height="20" rx="10" fill="#fff" stroke-width="4" />
  <rect x="136" y="126" width="28" height="26" rx="8" fill={skin} />
  <path d="M100 152 Q150 136 200 152 L216 302 Q150 320 84 302 Z" fill="var(--shirt, #1b998b)" />
  <path d="M132 150 L150 172 L168 150" stroke-width="5" />
  <circle cx="150" cy="222" r="24" fill="#ffb703" /><text x="150" y="231" font-size="22" font-family="var(--font-bangers)" text-anchor="middle" fill={ink} stroke="none">MK</text>
  <!-- head: the real photo, cut out and stuck on like a sticker -->
  <image href={head.src} x="80" y="-42" width="140" height="202" filter={`url(#${uid}-sticker)`} preserveAspectRatio="xMidYMid meet" />
  {gear && <g class="gear-front">
    <!-- 0 · the word balloon -->
    <g data-gear="0" hidden transform="translate(16 -22)"><path d="M206 -8 h92 a12 12 0 0 1 12 12 v34 a12 12 0 0 1 -12 12 h-56 l-20 16 l4 -16 h-20 a12 12 0 0 1 -12 -12 v-34 a12 12 0 0 1 12 -12 Z" fill="#fff" stroke-width="5" /><text x="252" y="38" font-size="32" font-family="var(--font-bangers)" text-anchor="middle" fill="#ff2e63" stroke="none">{"{ }"}</text></g>
    <!-- 1 · the shield -->
    <g data-gear="1" hidden><path d="M54 206 L90 220 L86 270 Q54 298 22 270 L18 220 Z" fill="#3a86ff" stroke-width="5" /><rect x="38" y="232" width="34" height="28" rx="4" fill="#fff" stroke-width="3" /><path d="M38 241 h34" stroke-width="3" /><circle cx="44" cy="236.5" r="1.8" fill={ink} stroke="none" /><circle cx="50" cy="236.5" r="1.8" fill={ink} stroke="none" /><circle cx="56" cy="236.5" r="1.8" fill={ink} stroke="none" /></g>
    <!-- 2 · the wrench and belt -->
    <g data-gear="2" hidden><rect x="92" y="286" width="116" height="24" rx="6" fill="#111" /><rect x="138" y="283" width="24" height="30" rx="5" fill="#ffb703" stroke-width="4" /><rect x="102" y="290" width="22" height="18" rx="4" fill="#c68642" stroke-width="3" /><rect x="176" y="290" width="22" height="18" rx="4" fill="#c68642" stroke-width="3" /><g transform="translate(268 300) rotate(-32)"><rect x="-7" y="-74" width="14" height="86" rx="6" fill="#9aa5b1" stroke-width="4" /><circle cx="0" cy="-82" r="19" fill="#9aa5b1" stroke-width="4" /><rect x="-6" y="-104" width="12" height="18" fill="#fff8e7" stroke-width="4" /></g></g>
    <!-- 3 · data pack straps -->
    <g data-gear="3" hidden><path d="M118 160 L108 230 M182 160 L192 230" stroke-width="9" /><path d="M118 160 L108 230 M182 160 L192 230" stroke="#8338ec" stroke-width="4" /></g>
    <!-- 4 · the cape's clasp -->
    <g data-gear="4" hidden><path d="M112 154 h76" stroke-width="10" /><path d="M150 140 l6 10 h-12 Z" fill="#ffb703" stroke-width="4" /><circle cx="150" cy="150" r="9" fill="#ffb703" stroke-width="4" /></g>
    <!-- 5 · the visor -->
    <g data-gear="5" hidden><path d="M150 -42 v-24" stroke-width="5" /><path d="M150 -84 l5 10 l11 1 l-8 7 l3 11 l-11 -6 l-11 6 l3 -11 l-8 -7 l11 -1 Z" fill="#ffb703" stroke-width="3" /><rect x="82" y="38" width="136" height="36" rx="18" fill="#8338ec" stroke-width="5" /><path d="M96 56 h108" stroke="#e9d5ff" stroke-width="5" /><circle cx="116" cy="56" r="4" fill="#fff" stroke="none" /></g>
    <!-- 6 · the headset -->
    <g data-gear="6" hidden><path d="M84 60 A66 66 0 0 1 216 60" stroke-width="10" /><rect x="72" y="48" width="22" height="38" rx="9" fill="#111" /><rect x="206" y="48" width="22" height="38" rx="9" fill="#111" /><path d="M94 86 Q104 122 136 110" stroke-width="5" /><circle cx="140" cy="108" r="8" fill="#ff2e63" stroke-width="4" /><rect x="110" y="244" width="80" height="38" rx="7" fill="#fff" stroke-width="4" /><path d="M118 264 h14 l6 -12 l8 24 l8 -18 l6 6 h22" stroke="#1b998b" stroke-width="4" /></g>
    <!-- 7 · the cable -->
    <g data-gear="7" hidden><path d="M196 162 C250 150 262 206 236 236 S176 262 202 294" stroke-width="12" /><path d="M196 162 C250 150 262 206 236 236 S176 262 202 294" stroke="#ffb703" stroke-width="6" /><rect x="192" y="290" width="26" height="18" rx="4" fill="#111" /><path d="M198 308 v10 M212 308 v10" stroke-width="4" /><rect x="14" y="282" width="36" height="24" rx="5" fill="#111" /><path d="M24 282 v-10 M40 282 v-10" stroke-width="4" /></g>
    <!-- 8 · the hardhat and hammer -->
    <g data-gear="8" hidden><g transform="translate(0 -66)"><path d="M96 62 Q150 -14 204 62 Z" fill="#ffb703" stroke-width="5" /><rect x="78" y="56" width="144" height="16" rx="8" fill="#ffb703" stroke-width="5" /><path d="M150 10 v24" stroke-width="5" /></g><g transform="translate(268 300) rotate(-22)"><rect x="-6" y="-84" width="12" height="92" rx="5" fill="#c68642" stroke-width="4" /><rect x="-28" y="-104" width="56" height="26" rx="6" fill="#9aa5b1" stroke-width="4" /></g></g>
  </g>}
</svg>
