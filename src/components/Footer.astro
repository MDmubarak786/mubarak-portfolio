---
import { site } from "../lib/site";
const year = new Date().getFullYear();
---
<footer class="px-3 sm:px-6 lg:px-10 pb-10 text-sm text-ink-muted flex flex-wrap items-center gap-x-4 gap-y-2">
  <img src="/brand/MK-dark.svg" alt="" width="36" height="23" class="h-5 w-auto opacity-80" loading="lazy" />
  <span><span class="text-ink">{site.name}</span> · <span class="font-tamil" lang="ta">{site.tamilName}</span></span>
  <span>{site.location}</span>
  <span class="ml-auto tabular">Filed {year}</span>
</footer>
