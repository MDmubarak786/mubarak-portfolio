---
import { getCollection, getEntries } from "astro:content";
import { Icon } from "astro-icon/components";
const records = (await getCollection("records")).sort((a, b) => a.data.order - b.data.order);
const tints = [0.46, 0.4, 0.52, 0.36, 0.58, 0.44];
const kinds = ["Integration", "Platform", "Serverless", "Marketing site", "IoT, real-time", "Leadership"];
const withWitnesses = await Promise.all(records.map(async (r) => ({ r, witnesses: await getEntries(r.data.reviewedBy) })));
---
<section id="work" class="px-5 sm:px-8 py-20 sm:py-28 scroll-mt-10" aria-labelledby="work-heading">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-end justify-between gap-6 mb-10">
      <h2 id="work-heading" class="font-display text-xl font-medium text-muted">Selected work</h2>
      <p class="text-sm text-muted hidden sm:block">Hover a row to preview, open it for the full story.</p>
    </div>
    <ol class="work-list border-b border-line">
      {withWitnesses.map(({ r, witnesses }, i) => (
        <li class="work-row" style={`--l:${tints[i % tints.length]}`}>
          <details class="group" data-work data-title={r.data.index} data-metric={r.data.consequences.find((c) => c.emphasis)?.value ?? ""} data-kind={kinds[i]}>
            <summary class="list-none cursor-pointer grid grid-cols-[1fr_auto] sm:grid-cols-[1fr_auto_auto] items-center gap-4 py-7 sm:py-9 px-1 sm:px-4 transition-[padding] duration-500 hover:px-6 sm:hover:px-10 [&::-webkit-details-marker]:hidden">
              <span class="font-display text-[clamp(1.6rem,4vw,3.5rem)] leading-none tracking-[-0.03em]">{r.data.index}</span>
              <span class="hidden sm:block text-sm text-muted">{r.data.organisation} · {r.data.date}</span>
              <span class="flex items-center gap-3 text-sm text-muted"><span class="hidden sm:inline">{kinds[i]}</span><Icon name="lucide:plus" size={20} class="transition-transform duration-500 group-open:rotate-45" aria-hidden="true" /></span>
            </summary>
            <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] pb-10 px-1 sm:px-4">
              <div class="space-y-5 max-w-[62ch]">
                <h3 class="font-display text-2xl sm:text-3xl font-medium leading-tight">{r.data.title}</h3>
                <p class="text-muted">{r.data.context}</p>
                <p><span class="text-muted">Decision. </span>{r.data.decision}</p>
                <dl class="grid grid-cols-2 gap-x-6 gap-y-3 pt-2 border-t border-line">
                  {r.data.consequences.map((c) => <div><dd class:list={["font-display text-2xl tracking-tight", c.emphasis && "text-accent"]}>{c.value}</dd><dt class="text-xs text-muted">{c.label}</dt></div>)}
                </dl>
                <p class="text-xs text-muted">{r.data.tags.join(" · ")}</p>
              </div>
              <div class="space-y-6">
                {witnesses.map((w) => <blockquote class="border-l border-line-strong pl-5"><p class="leading-snug">“{w.data.pull}”</p><footer class="mt-2 text-sm text-muted"><a href={`#witness-${w.id}`} class="link-draw text-fg">{w.data.name}</a>, {w.data.title}</footer></blockquote>)}
                <div class="rounded-2xl p-6 bg-[oklch(0.3_0.07_264)]"><p class="text-xs uppercase tracking-widest text-white/60">Role</p><p class="mt-1">{r.data.role}</p></div>
              </div>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
  <!-- Cursor-following preview, desktop only -->
  <div class="pointer-events-none fixed left-0 top-0 z-30 hidden lg:block opacity-0 will-change-transform" data-preview aria-hidden="true">
    <div class="w-[22rem] aspect-[4/3] rounded-2xl overflow-hidden grid place-items-center text-center p-8 bg-[oklch(var(--l,0.46)_0.17_264)] text-white shadow-2xl">
      <p class="font-display text-5xl font-semibold tracking-tight" data-preview-metric></p>
      <p class="mt-3 text-sm text-white/80" data-preview-title></p>
      <p class="mt-6 text-xs uppercase tracking-widest text-white/60" data-preview-kind></p>
    </div>
  </div>
</section>
