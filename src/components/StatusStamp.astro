---
interface Props { status: "accepted" | "superseded" | "proposed"; date: string }
const { status, date } = Astro.props;
const label = { accepted: "Accepted", superseded: "Superseded", proposed: "Proposed" }[status];
const tone = status === "accepted" ? "text-stamp border-stamp" : "text-rust border-rust";
---
<span class:list={["stamp inline-flex flex-col items-center px-3 py-1 border-[3px] rounded-[4px] font-display font-bold uppercase leading-none select-none", tone]} data-stamp aria-label={`${label}, ${date}`}>
  <span class="text-base tracking-[0.18em]">{label}</span>
  <span class="mono text-[0.65rem] tracking-[0.12em] mt-1 normal-case font-normal" aria-hidden="true">{date}</span>
</span>
<style>
  /* Default: already landed. Only a script arms a stamp, and only when motion is allowed. */
  .stamp {
    --tilt: -6deg;
    transform: rotate(var(--tilt));
    mix-blend-mode: multiply;
    box-shadow: inset 0 0 0 1px currentColor;
    mask-image: radial-gradient(circle at 30% 40%, #000 0 70%, rgb(0 0 0 / 0.75) 100%);
    will-change: auto;
  }
  .stamp.is-armed {
    opacity: 0;
    transform: rotate(calc(var(--tilt) + 4deg)) scale(1.5);
    filter: blur(1.5px);
  }
  .stamp.is-landing {
    animation: stamp-land 560ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: transform, opacity, filter;
  }
  @keyframes stamp-land {
    0%   { opacity: 0; transform: rotate(calc(var(--tilt) + 4deg)) scale(1.5); filter: blur(1.5px); }
    55%  { opacity: 1; transform: rotate(var(--tilt)) scale(0.96); filter: blur(0); }
    75%  { transform: rotate(var(--tilt)) scale(1.02); box-shadow: inset 0 0 0 1px currentColor, 0 0 0 2px color-mix(in oklab, currentColor 25%, transparent); }
    100% { opacity: 1; transform: rotate(var(--tilt)) scale(1); filter: blur(0); box-shadow: inset 0 0 0 1px currentColor; }
  }
</style>
<script>
  // The one authored motion on the page: a status stamp lands when its record comes into view.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const stamps = Array.from(document.querySelectorAll<HTMLElement>("[data-stamp]"));
  if (!reduce && stamps.length && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        io.unobserve(el);
        el.classList.add("is-landing");
        el.addEventListener("animationend", () => el.classList.remove("is-armed", "is-landing"), { once: true });
      }
    }, { threshold: 0.6 });
    for (const s of stamps) {
      const r = s.getBoundingClientRect();
      const inView = r.top < window.innerHeight && r.bottom > 0;
      s.classList.add("is-armed");
      if (inView) {
        // First paint: let the page settle for a beat, then land.
        setTimeout(() => { s.classList.add("is-landing"); s.addEventListener("animationend", () => s.classList.remove("is-armed", "is-landing"), { once: true }); }, 350);
      } else {
        io.observe(s);
      }
    }
  }
</script>
