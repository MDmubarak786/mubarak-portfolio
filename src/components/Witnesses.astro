---
import { getCollection } from "astro:content";
import SectionHeading from "./SectionHeading.astro";
const witnesses = (await getCollection("witnesses")).sort((a, b) => a.data.order - b.data.order);
---
<section id="witnesses" data-section aria-labelledby="witnesses-heading" class="sheet px-5 py-6 sm:px-8 sm:py-8 xl:px-10 xl:py-10 scroll-mt-20 lg:scroll-mt-6">
  <SectionHeading id="witnesses" title="Witnesses" lede="Nine people who have worked with me, in their own words. Nothing here is paraphrased." />
  <ol class="mt-8 divide-y divide-rule">
    {witnesses.map((w) => (
      <li id={`witness-${w.id}`} class="py-7 grid gap-3 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-8 scroll-mt-20 lg:scroll-mt-6">
        <div class="lg:pt-1">
          <p class="font-display font-semibold leading-tight">{w.data.name}</p>
          <p class="text-sm text-ink-muted leading-snug mt-1">{w.data.title}{w.data.organisation ? `, ${w.data.organisation}` : ""}</p>
        </div>
        <blockquote class="max-w-[68ch] space-y-3">
          {w.data.quote.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
        </blockquote>
      </li>
    ))}
  </ol>
</section>
