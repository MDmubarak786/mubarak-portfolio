---
interface Option { name: string; chosen: boolean; pros: string[]; cons: string[] }
interface Props { options: Option[] }
const { options } = Astro.props;
---
<table class="options w-full border-collapse text-sm block sm:table">
  <thead class="hidden sm:table-header-group">
    <tr class="text-left border-b-2 border-ink">
      <th scope="col" class="py-2 pr-4 font-display font-semibold">Option</th>
      <th scope="col" class="py-2 pr-4 font-display font-semibold">For</th>
      <th scope="col" class="py-2 font-display font-semibold">Against</th>
    </tr>
  </thead>
  <tbody class="block sm:table-row-group">
    {options.map((o) => (
      <tr class:list={["block sm:table-row border-b border-rule align-top py-3 sm:py-0", o.chosen ? "bg-paper-deep sm:bg-paper-deep -mx-3 px-3 sm:mx-0 sm:px-0" : ""]}>
        <th scope="row" class="block sm:table-cell sm:py-3 sm:pr-4 font-text font-semibold text-left">
          {o.name}
          {o.chosen
            ? <span class="inline sm:block ml-2 sm:ml-0 sm:mt-1 text-xs font-normal text-stamp">Chosen</span>
            : <span class="inline sm:block ml-2 sm:ml-0 sm:mt-1 text-xs font-normal text-rust">Rejected</span>}
        </th>
        <td class="block sm:table-cell mt-2 sm:mt-0 sm:py-3 sm:pr-4" data-label="For">
          <ul class="list-disc pl-4 space-y-1">{o.pros.map((p) => <li>{p}</li>)}</ul>
        </td>
        <td class="block sm:table-cell mt-2 sm:mt-0 sm:py-3" data-label="Against">
          <ul class="list-disc pl-4 space-y-1">{o.cons.map((c) => <li>{c}</li>)}</ul>
        </td>
      </tr>
    ))}
  </tbody>
</table>
<style>
  @media (width < 40rem) {
    td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--color-ink-soft);
      margin-bottom: 0.25rem;
    }
  }
</style>
