---
import "../styles/variants.css";
import { Font } from "astro:assets";
import { site } from "../lib/site";
interface Props { title: string; description: string; fonts: string[]; theme: string }
const { title, description, fonts, theme } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="theme-color" content={theme} /><link rel="canonical" href={site.url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {fonts.map((f) => <Font cssVariable={f as any} preload />)}
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={new URL("/og.png", site.url).href} />
  </head>
  <body>
    <slot />
  </body>
</html>
