---
import "../styles/variants.css";
import "../styles/comic.css";
import { Font } from "astro:assets";
import { site } from "../lib/site";
interface Props { title: string; description: string; fonts: string[]; theme: string; canonical?: string; image?: string; ogType?: string }
const { title, description, fonts, theme, canonical = site.url, image = new URL("/og.png", site.url).href, ogType = "website" } = Astro.props;
const GTM = import.meta.env.PUBLIC_GTM_ID as string | undefined;
const CLARITY = import.meta.env.PUBLIC_CLARITY_ID as string | undefined;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: [site.legalName, site.tamilName],
  jobTitle: site.role,
  description,
  url: site.url,
  image: new URL("/og.png", site.url).href,
  email: `mailto:${site.email}`,
  telephone: site.phoneE164,
  worksFor: { "@type": "Organization", name: site.employer },
  address: { "@type": "PostalAddress", addressLocality: "Chennai", addressRegion: "Tamil Nadu", addressCountry: "IN" },
  alumniOf: { "@type": "CollegeOrUniversity", name: site.education.school },
  sameAs: [site.linkedin, site.github, site.x, site.instagram, site.youtube],
  knowsAbout: ["Full-stack engineering", "React", "Next.js", "Node.js", "Python", "AWS", "LLMs", "RAG", "Agentic workflows"],
};
// Google picks the result's site name from WebSite data; without it a *.vercel.app page is labelled "Vercel".
const website = { "@context": "https://schema.org", "@type": "WebSite", name: "MK Comics", alternateName: [site.name, "MK Comics by Mubarak Shajahan"], url: `${site.url}/` };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="theme-color" content={theme} /><link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" /><link rel="manifest" href="/manifest.webmanifest" />
    <meta name="google-site-verification" content="L0WEPb7xzY07_re74A0a5X_sxEs2H6Ko6WlHp6Pel5c" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {fonts.map((f) => <Font cssVariable={f as any} preload />)}
    <meta property="og:type" content={ogType} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="MK Comics" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={image} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:site" content="@MMubarakoo7" /><meta name="twitter:creator" content="@MMubarakoo7" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={image} />
    <link rel="sitemap" href="/sitemap-index.xml" /><link rel="author" href="/llms.txt" /><link rel="alternate" type="application/rss+xml" title="The strip – MK Comics" href="/rss.xml" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {canonical.replace(/\/$/, "") === site.url.replace(/\/$/, "") && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
    <script is:inline>
      // One event for everything a reader does: `mk_action` with an area, an action and a label on the data layer. Tag
      // Manager forwards it to GA4 ("GA4 - mk_action"); GA4 derives contact_click, resume_open, case_opened and
      // witness_read from it as key events. Pushes queue until the tags load. No personal data: a submitted birthday
      // counts as "submit", never the date. Inline (not a module) so component scripts import nothing and stay inlined.
      (function () {
        var kinds = [[/^mailto:/, "email"], [/^tel:/, "call"], [/wa\.me|whatsapp/, "whatsapp"], [/linkedin\.com/, "linkedin"], [/github\.com/, "github"], [/x\.com|twitter\.com/, "x"], [/instagram\.com/, "instagram"], [/youtube\.com|youtu\.be/, "youtube"]];
        window.mk = {
          track: function (area, action, label) { try { (window.dataLayer = window.dataLayer || []).push({ event: "mk_action", area: area, action: action, label: String(label == null ? "" : label).slice(0, 100) }); } catch (e) {} },
          linkKind: function (href) { for (var i = 0; i < kinds.length; i++) if (kinds[i][0].test(href)) return kinds[i][1]; return ""; },
        };
      })();
    </script>
    {(GTM || CLARITY) && <script is:inline data-gtm={GTM ?? ""} data-clarity={CLARITY ?? ""}>
      (function () {
      var cfg = document.currentScript.dataset, GTM = cfg.gtm, CLARITY = cfg.clarity;
      // Analytics load after the page is interactive so they never sit on the first-paint path.
      // GA4 is configured inside the Tag Manager container; window.gtag pushes custom events to the same dataLayer.
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      if (CLARITY) { window.clarity = window.clarity || function(){ (window.clarity.q = window.clarity.q || []).push(arguments); }; }
      var booted = false;
      function boot() {
        if (booted) return; booted = true;
        var add = function (src) { var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); };
        if (GTM) { dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' }); add('https://www.googletagmanager.com/gtm.js?id=' + GTM); }
        if (CLARITY) add('https://www.clarity.ms/tag/' + CLARITY);
      }
      var later = function () { ('requestIdleCallback' in window ? requestIdleCallback : function (f) { setTimeout(f, 1); })(boot); };
      // Tags load on the first interaction (scroll, touch, pointer, key). A reader who sits still gets them after 15 s. Nothing
      // on a timer inside the first seconds: analytics must never be what the browser is busy with while the page settles.
      if (document.readyState === 'complete') setTimeout(later, 15000); else addEventListener('load', function () { setTimeout(later, 15000); });
      ['pointerdown', 'keydown', 'touchstart', 'scroll', 'wheel'].forEach(function (ev) { addEventListener(ev, boot, { once: true, passive: true }); });
      })();
    </script>}
  </head>
  <body>
    {GTM && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <slot />
    <footer class="max-w-6xl mx-auto px-5 sm:px-8 pb-10 flex flex-wrap items-center justify-between gap-x-6 text-base text-[#555]">
      <p class="py-3">© {new Date().getFullYear()} {site.name} · Chennai, India</p>
      <nav aria-label="Feeds" class="flex flex-wrap gap-x-4">
        <a href="/rss.xml" class="inline-flex items-center justify-center min-h-[50px] min-w-[50px] px-1 underline underline-offset-4 text-[#111]">RSS</a>
        <a href="/sitemap-index.xml" class="inline-flex items-center justify-center min-h-[50px] min-w-[50px] px-1 underline underline-offset-4 text-[#111]">Sitemap</a>
        <a href="/llms.txt" class="inline-flex items-center justify-center min-h-[50px] min-w-[50px] px-1 underline underline-offset-4 text-[#111]">llms.txt</a>
      </nav>
    </footer>
  </body>
</html>
