---
import "../styles/global.css";
import { Font } from "astro:assets";
import { site } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  /** Path of the page for canonical + OG. Defaults to the current path. */
  path?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description = "", path = Astro.url.pathname, ogImage = "/og.png", jsonLd } = Astro.props;
const canonical = new URL(path, Astro.site ?? site.url).href;
const ogUrl = new URL(ogImage, Astro.site ?? site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="author" content={site.name} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MMubarakoo7" />
    <meta name="twitter:creator" content="@MMubarakoo7" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" preload />
    <Font cssVariable="--font-tamil" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] bg-fg text-bg px-3 py-2 rounded-full">Skip to content</a>
    <slot />
  </body>
</html>
