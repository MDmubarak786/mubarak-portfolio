---
import "../styles/variants.css";
import { Font } from "astro:assets";
interface Props { title: string; fonts: string[]; n: number }
const { title, fonts, n } = Astro.props;
const names = ["Aurora", "Signal", "Editorial", "Bento", "Orbit"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {fonts.map((f) => <Font cssVariable={f} preload />)}
    <slot name="head" />
  </head>
  <body>
    <nav class="fixed top-3 left-1/2 -translate-x-1/2 z-50 flex items-center gap-1 rounded-full bg-black/60 backdrop-blur px-2 py-1 text-xs text-white/80 border border-white/10" aria-label="Variants">
      <a href="/variants" class="px-2 py-1 rounded-full hover:bg-white/10">All</a>
      {names.map((name, i) => <a href={`/variants/${i + 1}`} class:list={["px-2 py-1 rounded-full hover:bg-white/10", i + 1 === n && "bg-white text-black hover:bg-white"]}>{i + 1} {name}</a>)}
    </nav>
    <slot />
  </body>
</html>
